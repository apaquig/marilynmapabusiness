---
import { Image } from 'astro:assets';
import logo from '../../public/logo-mapa.png';
import Actions from '../components/lp/Actions.astro';
import LegalNotice from '../components/lp/LegalNotice.astro';
import { BRAND, PHONE, ATTRIBUTION_KEYS } from '../components/lp/config';
interface Props { title: string; description: string; path: string; schema?: Record<string, unknown>; thankYou?: boolean; contactForm?: boolean }
const { title, description, path, schema, thankYou = false, contactForm = false } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={`https://marilynmapabusiness.com${path}`} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={`https://marilynmapabusiness.com${path}`} />
  <link rel="icon" href="/logo-mapa.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TW289QXQ');</script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <script define:vars={{ ATTRIBUTION_KEYS, thankYou }}>
    (() => {
      window.dataLayer = window.dataLayer || [];
      const params = new URLSearchParams(window.location.search);
      for (const key of ATTRIBUTION_KEYS) {
        const value = params.get(key);
        if (value) { try { sessionStorage.setItem(`lp-notary-${key}`, value); } catch {} }
      }
      if (thankYou) {
        try {
          if (!sessionStorage.getItem('lp-notary-lead-gracias')) {
            sessionStorage.setItem('lp-notary-lead-gracias', '1');
            window.dataLayer.push({ event: 'lead_gracias', servicio: 'notary' });
          }
        } catch { /* Without session storage, avoid an un-deduplicated conversion. */ }
      }
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest('a[href]');
        if (!link) return;
        const url = new URL(link.href, window.location.href);
        const eventName = url.protocol === 'tel:' ? 'click_llamar' : url.hostname === 'wa.me' ? 'click_whatsapp' : null;
        if (eventName) window.dataLayer.push({ event: eventName, servicio: 'notary', ubicacion_boton: link.dataset.buttonLocation || 'contenido' });
      });
    })();
  </script>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TW289QXQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#contenido">Ir al contenido</a>
  <header class="topbar"><div class="topbar-inner"><Image src={logo} width={146} height={52} format="webp" alt={BRAND} loading="eager" /><a href={PHONE} data-button-location="header" class="header-call">Llamar <span>(862) 622-8339</span></a></div></header>
  <main id="contenido"><slot /></main>
  <footer><div class="footer-inner"><strong>{BRAND}</strong><p>20 Bloomfield Pl, Newark, NJ 07104</p><a href={PHONE} data-button-location="footer">(862) 622-8339</a><LegalNotice /><a href="/es/privacy-policy/" target="_blank" rel="noopener">Política de Privacidad</a></div></footer>
  <div class="sticky-actions" aria-label="Contacto rápido"><Actions location="sticky" compact /></div>
  {contactForm && <>
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" is:inline></script>
    <script is:inline>emailjs.init("T4n_e0kmxzUCnBqjJ");</script>
    <script src="/js/script.js" is:inline></script>
    <script src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_92b14bc678ea4eb3b89a2a27dca3f16f" is:inline></script>
  </>}
</body>
</html>
<style is:global>
  :root{color-scheme:light;--lp-red:#cc0000;--lp-black:#111111}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;color:#111;background:white;font-family:Lato,sans-serif;font-size:17px;line-height:1.6;padding-top:72px}h1,h2,h3{font-family:Montserrat,sans-serif;font-weight:800;line-height:1.2;letter-spacing:-.035em}a{color:inherit}img{max-width:100%;height:auto}button,a,summary{touch-action:manipulation}:focus-visible{outline:3px solid #111;outline-offset:4px}.topbar{position:fixed;inset:0 0 auto;background:white;border-bottom:1px solid #e8e8e8;z-index:20;height:72px}.topbar-inner{max-width:1160px;margin:auto;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;height:100%}.topbar img{object-fit:contain;height:46px;width:136px}.header-call{background:#cc0000;color:white;text-decoration:none;font-weight:700;border-radius:9px;padding:11px 16px;min-height:48px;font-size:15px}.skip{position:fixed;top:-80px;background:white;padding:12px;z-index:30}.skip:focus{top:8px}footer{background:#111;color:#fff;padding:40px 24px;font-size:14px}.footer-inner{max-width:1100px;margin:auto;display:grid;gap:14px}.footer-inner p{margin:0}.footer-inner>a{width:fit-content;min-height:48px;display:inline-flex;align-items:center}.sticky-actions{display:none}@media(max-width:600px){body{padding-bottom:78px;font-size:16px}.topbar-inner{padding:10px 16px}.header-call{padding:12px;font-size:13px}.topbar img{width:110px}.sticky-actions{display:block;position:fixed;inset:auto 0 0;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:white;border-top:1px solid #ddd;z-index:25}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
