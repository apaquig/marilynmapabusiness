---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
  canonical: string;
  schema?: any;
  loadMap?: boolean;
  activeSection?: string;
  currentPath: string; // e.g. "/" or "/servicios/notaria/"
}

const {
  lang,
  title,
  description,
  canonical,
  schema,
  loadMap = false,
  activeSection = '',
  currentPath
} = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

// Compute alternate URL for hreflang
let alternateLang = lang === 'es' ? 'en' : 'es';
let alternateHref = "";

// Resolve alternate URL
let cleanPath = currentPath;
if (cleanPath.startsWith(WEBSITE)) {
  cleanPath = cleanPath.slice(WEBSITE.length);
}
if (!cleanPath.startsWith('/')) {
  cleanPath = '/' + cleanPath;
}

if (lang === 'es') {
  let newPath = cleanPath;
  if (newPath.startsWith('/servicios/')) {
    newPath = newPath.replace('/servicios/', '/services/');
  }
  alternateHref = `${WEBSITE}/en${newPath === '/' ? '/' : newPath}`;
} else {
  let newPath = cleanPath;
  if (newPath.startsWith('/en/')) {
    newPath = newPath.slice(3);
  } else if (newPath === '/en') {
    newPath = '/';
  }
  if (newPath.startsWith('/services/')) {
    newPath = newPath.replace('/services/', '/servicios/');
  }
  alternateHref = `${WEBSITE}${newPath}`;
}

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";
const WHATSAPP_URL = `https://wa.me/18626228339?text=${encodeURIComponent(
  lang === 'es'
    ? 'Hola Marilyn, me interesa conocer más sobre sus servicios.'
    : 'Hello Marilyn, I would like to know more about your services.'
)}`;

const homeLink = lang === 'es' ? '/' : '/en/';
const blogLink = lang === 'es' ? '/blog/' : '/en/blog/';
const bioLink = lang === 'es' ? '/marilyn-paladinez/' : '/en/marilyn-paladinez/';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  
  <!-- Hreflang alternates -->
  <link rel="alternate" hreflang={lang === 'es' ? 'es-US' : 'en-US'} href={canonical} />
  <link rel="alternate" hreflang={alternateLang === 'es' ? 'es-US' : 'en-US'} href={alternateHref} />
  <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : alternateHref} />

  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="author" content="Marilyn Paladinez — MAPA Business & Financial Services LLC" />
  <meta name="copyright" content="© 2026 MAPA Business & Financial Services LLC" />
  <meta name="geo.region" content="US-NJ" />
  <meta name="geo.placename" content="Newark, New Jersey" />
  <meta name="geo.position" content="40.762136;-74.172248" />
  <meta name="ICBM" content="40.762136, -74.172248" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MAPA Business & Financial Services LLC" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${WEBSITE}/marilin2.webp`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Marilyn Paladinez — MAPA Business Newark NJ" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />

  <!-- Twitter / WhatsApp Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${WEBSITE}/marilin2.webp`} />

  <!-- Schema.org JSON-LD Connected Graph -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  
  {loadMap && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
    </>
  )}

  <!-- EmailJS SDK -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" is:inline></script>
  <script type="text/javascript" is:inline>emailjs.init("T4n_e0kmxzUCnBqjJ");</script>
</head>
<body>

  <!-- WHATSAPP FLOAT WIDGET -->
  <WhatsAppWidget phoneHref={PHONE_HREF} text={lang === 'es' ? 'Hola Marilyn, me interesa conocer más sobre sus servicios.' : 'Hello Marilyn, I would like to know more about your services.'} />

  <!-- NAVBAR -->
  <nav id="mainNav">
    <a href={homeLink} class="nav-logo">M<span>A</span>PA</a>
    <ul class="nav-links" id="navLinks">
      <li><a href={`${homeLink}#hero`} class={activeSection === 'hero' ? 'active' : ''}>{t("nav.home")}</a></li>
      <li><a href={`${homeLink}#servicios`} class={activeSection === 'servicios' ? 'active' : ''}>{t("nav.services")}</a></li>
      <li><a href={`${homeLink}#nosotros`} class={activeSection === 'nosotros' ? 'active' : ''}>{t("nav.about")}</a></li>
      <li><a href={`${homeLink}#proceso`} class={activeSection === 'proceso' ? 'active' : ''}>{t("nav.process")}</a></li>
      <li><a href={`${homeLink}#testimonios`} class={activeSection === 'testimonios' ? 'active' : ''}>{t("nav.testimonials")}</a></li>
      <li><a href={`${homeLink}#contacto`} class={activeSection === 'contacto' ? 'active' : ''}>{t("nav.contact")}</a></li>
      <li><a href={`${homeLink}#areas-de-servicio`} class={activeSection === 'areas-de-servicio' ? 'active' : ''}>{t("nav.coverage")}</a></li>
      <li><a href={`${homeLink}#ubicacion`} class={activeSection === 'ubicacion' ? 'active' : ''}>{t("nav.location")}</a></li>
      <li><a href={blogLink} class={activeSection === 'blog' ? 'active' : ''}>{t("nav.blog")}</a></li>
      <li class="nav-social-li">
        <div class="nav-social-group">
          <a href="https://www.facebook.com/profile.php?id=61550670802804" class="social-facebook" target="_blank" rel="noopener" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/marilynpaladinezusa/" class="social-instagram" target="_blank" rel="noopener" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@marilynpaladinezv" class="social-tiktok" target="_blank" rel="noopener" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
          </a>
          <a href="https://www.youtube.com/@MarilynPaladinezOficial" class="social-youtube" target="_blank" rel="noopener" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </li>
      <li><a href={WHATSAPP_URL} target="_blank" class="nav-cta">{t("nav.cta")}</a></li>
      <li class="lang-selector-li">
        <div class="lang-selector">
          {lang === 'es' ? (
            <>
              <span class="lang-btn active" aria-label="Español activo">ES</span>
              <span class="lang-divider">|</span>
              <a href={alternateHref} class="lang-btn" aria-label="Switch to English">EN</a>
            </>
          ) : (
            <>
              <a href={alternateHref} class="lang-btn" aria-label="Cambiar a Español">ES</a>
              <span class="lang-divider">|</span>
              <span class="lang-btn active" aria-label="English active">EN</span>
            </>
          )}
        </div>
      </li>
    </ul>
    <div class="hamburger" id="hamburger" onclick="toggleMenu()">
      <span></span><span></span><span></span>
    </div>
  </nav>

  <slot />

  <!-- FOOTER -->
  <footer>
    <div>
      <div class="footer-logo">M<span>A</span>PA</div>
      <p style="margin-top:6px;">Business & Financial Services LLC</p>
    </div>
    <div class="footer-social">
      <a href="https://www.facebook.com/profile.php?id=61550670802804" target="_blank" rel="noopener" class="social-btn-icon social-facebook" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
      </a>
      <a href="https://www.instagram.com/marilynpaladinezusa/" target="_blank" rel="noopener" class="social-btn-icon social-instagram" aria-label="Instagram">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
      <a href="https://www.tiktok.com/@marilynpaladinezv" target="_blank" rel="noopener" class="social-btn-icon social-tiktok" aria-label="TikTok">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
      </a>
      <a href="https://www.youtube.com/@MarilynPaladinezOficial" target="_blank" rel="noopener" class="social-btn-icon social-youtube" aria-label="YouTube">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
    </div>
    <div class="footer-links">
      <a href={`${homeLink}#hero`}>{t("nav.home")}</a>
      <a href={`${homeLink}#servicios`}>{t("nav.services")}</a>
      <a href={lang === 'es' ? '/sobre-mapa/' : '/en/about/'}>{lang === 'es' ? 'Sobre MAPA' : 'About Us'}</a>
      <a href={`${homeLink}#proceso`}>{t("nav.process")}</a>
      <a href={`${homeLink}#testimonios`}>{t("nav.testimonials")}</a>
      <a href={`${homeLink}#ubicacion`}>{t("nav.location")}</a>
      <a href={`${homeLink}#contacto`}>{t("nav.contact")}</a>
    </div>
    <div class="footer-legal">
      <a href={lang === 'es' ? '/politica-de-privacidad/' : '/en/privacy-policy/'}>{lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}</a>
      <span>·</span>
      <a href={lang === 'es' ? '/sobre-mapa/' : '/en/about/'}>{lang === 'es' ? 'Sobre MAPA' : 'About Us'}</a>
      <span>·</span>
      <a href={`${homeLink}#contacto`}>{lang === 'es' ? 'Contacto' : 'Contact'}</a>
    </div>
    <p>© {new Date().getFullYear()} MAPA Business &amp; Financial Services LLC · {PHONE}</p>
  </footer>

  <script src="/js/script.js" is:inline></script>
</body>
</html>
