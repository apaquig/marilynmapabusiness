// Helper para calcular tiempo relativo
function formatRelativeTime(publishTimeStr?: string, defaultDesc?: string, currentLang: string = 'es') {
  if (!publishTimeStr) return defaultDesc || (currentLang === 'en' ? 'Recently' : 'Recientemente');
  const pubDate = new Date(publishTimeStr);
  const now = new Date();
  const diffMs = now.getTime() - pubDate.getTime();
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffDays < 1) {
    return currentLang === 'en' ? 'Today' : 'Hoy';
  } else if (diffDays === 1) {
    return currentLang === 'en' ? 'Yesterday' : 'Ayer';
  } else if (diffDays < 7) {
    return currentLang === 'en' ? 'A few days ago' : 'Hace unos días';
  } else if (diffDays < 14) {
    return currentLang === 'en' ? '1 week ago' : 'Hace 1 semana';
  } else if (diffDays < 30) {
    const weeks = Math.floor(diffDays / 7);
    return currentLang === 'en' ? `${weeks} weeks ago` : `Hace ${weeks} semanas`;
  } else if (diffDays < 60) {
    return currentLang === 'en' ? '1 month ago' : 'Hace 1 mes';
  } else if (diffDays < 365) {
    const months = Math.floor(diffDays / 30);
    return currentLang === 'en' ? `${months} months ago` : `Hace ${months} meses`;
  } else {
    const years = Math.floor(diffDays / 365);
    return currentLang === 'en' ? `${years} year${years > 1 ? 's' : ''} ago` : `Hace ${years} año${years > 1 ? 's' : ''}`;
  }
}

// ── Build-time fetch (SSG / SEO) ──────────────────────────
let buildReviews: any[] = [];
let buildStatus  = 'success';
let buildStatusText = lang === 'en' ? 'Google reviews updated in real-time' : 'Opiniones de Google actualizadas en tiempo real';

try {
  const urls = [
    `https://places.googleapis.com/v1/places/${PLACE_ID}?languageCode=${lang}`,
    `https://places.googleapis.com/v1/places/${PLACE_ID}`
  ];

  const fetchedMap = new Map();

  for (const u of urls) {
    try {
      const res = await fetch(u, {
        method: 'GET',
        headers: {
          'X-Goog-Api-Key': API_KEY,
          'X-Goog-FieldMask': 'reviews,rating,displayName',
          'Referer': 'https://marilynmapabusiness.com'
        }
      });
      if (res.ok) {
        const data = await res.json();
        if (data?.reviews?.length) {
          data.reviews.forEach((r: any) => {
            const key = r.name || r.authorAttribution?.displayName;
            if (key && !fetchedMap.has(key)) {
              fetchedMap.set(key, r);
            }
          });
        }
      }
    } catch {
      // Continue to next URL
    }
  }

  // Merge with fallback to ensure full coverage
  FALLBACK_REVIEWS.forEach(fb => {
    const key = fb.name || fb.authorAttribution.displayName;
    if (!fetchedMap.has(key)) {
      fetchedMap.set(key, fb);
    }
  });

  const allReviews = Array.from(fetchedMap.values());
  // Sort strictly descending by publishTime (most recent first)
  allReviews.sort((a: any, b: any) => {
    const timeA = new Date(a.publishTime || 0).getTime();
    const timeB = new Date(b.publishTime || 0).getTime();
    return timeB - timeA;
  });

  buildReviews = allReviews;
} catch (e) {
  buildReviews = FALLBACK_REVIEWS;
}

// Helper para generar las estrellas
function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
const colors  = ['green','blue','orange','purple','pink'];
function colorClass(name: string) {
  return `avatar-${colors[(name.charCodeAt(0) || 0) % colors.length]}`;
}
