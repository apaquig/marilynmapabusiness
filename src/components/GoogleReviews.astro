<!-- ── Client-side live refresh ───────────────────────────────────── -->
<script define:vars={{ PLACE_ID, API_KEY, lang }}>
(function () {
  'use strict';

  const GOOGLE_BADGE_SVG = `<svg viewBox="0 0 24 24" width="18" height="18"><path fill="#EA4335" d="M12 5.04c1.67 0 3.17.58 4.35 1.71l3.25-3.25C17.63 1.7 14.97 1 12 1 7.37 1 3.4 3.66 1.49 7.55l3.86 3C6.26 7.67 8.89 5.04 12 5.04z"/><path fill="#4285F4" d="M23.49 12.27c0-.81-.07-1.59-.2-2.27H12v4.51h6.44c-.28 1.47-1.11 2.71-2.36 3.55l3.66 2.84c2.14-1.97 3.39-4.87 3.39-8.63z"/><path fill="#FBBC05" d="M5.35 14.55c-.24-.72-.38-1.49-.38-2.55s.14-1.83.38-2.55l-3.86-3C.56 8.35 0 10.11 0 12s.56 3.65 1.49 5.55l3.86-3z"/><path fill="#34A853" d="M12 23c3.24 0 5.97-1.07 7.96-2.91l-3.66-2.84c-1.1.74-2.51 1.18-4.3 1.18-3.11 0-5.74-2.63-6.68-5.51l-3.86 3C3.4 20.34 7.37 23 12 23z"/></svg>`;
  const MAPS_ICON_SVG = GOOGLE_BADGE_SVG.replace('width="18" height="18"', 'width="14" height="14"');

  const COLORS = ['green','blue','orange','purple','pink'];
  function colorClass(name) {
    return 'avatar-' + COLORS[(name.charCodeAt(0) || 0) % COLORS.length];
  }
  function stars(n) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
  function esc(s)   { return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function formatRelative(publishTimeStr, defaultDesc) {
    if (!publishTimeStr) return defaultDesc || (lang === 'en' ? 'Recently' : 'Recientemente');
    const pubDate = new Date(publishTimeStr);
    const now = new Date();
    const diffMs = now.getTime() - pubDate.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffDays < 1) return lang === 'en' ? 'Today' : 'Hoy';
    if (diffDays === 1) return lang === 'en' ? 'Yesterday' : 'Ayer';
    if (diffDays < 7) return lang === 'en' ? 'A few days ago' : 'Hace unos días';
    if (diffDays < 14) return lang === 'en' ? '1 week ago' : 'Hace 1 semana';
    if (diffDays < 30) {
      const weeks = Math.floor(diffDays / 7);
      return lang === 'en' ? `${weeks} weeks ago` : `Hace ${weeks} semanas`;
    }
    if (diffDays < 60) return lang === 'en' ? '1 month ago' : 'Hace 1 mes';
    if (diffDays < 365) {
      const months = Math.floor(diffDays / 30);
      return lang === 'en' ? `${months} months ago` : `Hace ${months} meses`;
    }
    const years = Math.floor(diffDays / 365);
    return lang === 'en' ? `${years} year${years > 1 ? 's' : ''} ago` : `Hace ${years} año${years > 1 ? 's' : ''}`;
  }

  function buildCard(review) {
    const author  = review.authorAttribution?.displayName || (lang === 'en' ? 'Google User' : 'Usuario de Google');
    const photo   = review.authorAttribution?.photoUri || '';
    const rating  = review.rating || 5;
    const text    = review.text?.text || review.originalText?.text || '';
    const relTime = formatRelative(review.publishTime, review.relativePublishTimeDescription);
    const ownerR  = review.ownerResponse?.text || '';
    const initial = author.charAt(0).toUpperCase() || 'G';
    const cc      = colorClass(author);
    const st      = stars(rating);
    const mapsUrl = review.googleMapsUri || review.authorAttribution?.uri || `https://www.google.com/maps/place/?q=place_id:${PLACE_ID}`;
    const readMoreText = lang === 'en' ? 'Read more' : 'Leer más';
    const readLessText = lang === 'en' ? 'Read less' : 'Leer menos';
    const viewGoogleText = lang === 'en' ? 'View on Google' : 'Ver en Google';
    const ownerText = lang === 'en' ? 'Owner response:' : 'Respuesta del propietario:';

    const avatarHtml = photo
      ? `<img class="review-avatar-img" src="${esc(photo)}" alt="${esc(author)}" referrerpolicy="no-referrer"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
         <div class="review-avatar ${cc}" style="display:none;">${esc(initial)}</div>`
      : `<div class="review-avatar ${cc}">${esc(initial)}</div>`;

    const bodyHtml = text.length > 180
      ? `<div class="review-text-wrapper">
           <p class="review-text-short">${esc(text.slice(0,180))}...<button class="read-more-btn"
             onclick="this.parentElement.style.display='none';this.parentElement.nextElementSibling.style.display='block';return false;">${readMoreText}</button></p>
           <p class="review-text-full" style="display:none;">${esc(text)}<button class="read-less-btn"
             onclick="this.parentElement.style.display='none';this.parentElement.previousElementSibling.style.display='block';return false;">${readLessText}</button></p>
         </div>`
      : `<p>${esc(text)}</p>`;

    const ownerHtml = ownerR
      ? `<div class="review-owner-response"><p><strong>${ownerText}</strong> ${esc(ownerR)}</p></div>`
      : '';

    return `<div class="testimonial-card google-review-card">
      <div class="review-header">
        ${avatarHtml}
        <div class="review-meta">
          <h3 class="review-author-name">${esc(author)}</h3>
          <div class="review-stars-row">
            <span class="stars-icon">${st}</span>
            <span class="review-date">${esc(relTime)}</span>
          </div>
        </div>
        <div class="google-badge" title="Google Review">${GOOGLE_BADGE_SVG}</div>
      </div>
      <div class="review-body">${bodyHtml}</div>
      ${ownerHtml}
      <div class="review-footer">
        <a href="${esc(mapsUrl)}"
           target="_blank" rel="noopener noreferrer" class="view-on-google-link">
          ${MAPS_ICON_SVG}<span>${viewGoogleText}</span>
        </a>
      </div>
    </div>`;
  }

  async function fetchLiveReviews() {
    const statusEl = document.getElementById('reviewsStatusText');
    try {
      const urls = [
        `https://places.googleapis.com/v1/places/${PLACE_ID}?languageCode=${lang}`,
        `https://places.googleapis.com/v1/places/${PLACE_ID}`
      ];

      const reviewMap = new Map();

      for (const u of urls) {
        try {
          const res = await fetch(u, {
            method: 'GET',
            headers: {
              'X-Goog-Api-Key': API_KEY,
              'X-Goog-FieldMask': 'reviews,rating,displayName'
            }
          });
          if (res.ok) {
            const data = await res.json();
            if (data?.reviews) {
              data.reviews.forEach(r => {
                const key = r.name || r.authorAttribution?.displayName;
                if (key && !reviewMap.has(key)) reviewMap.set(key, r);
              });
            }
          }
        } catch {
          // ignore error and continue
        }
      }

      if (reviewMap.size === 0) throw new Error('empty');

      const reviews = Array.from(reviewMap.values());
      // Sort descending by publishTime (most recent first)
      reviews.sort((a, b) => {
        const timeA = new Date(a.publishTime || 0).getTime();
        const timeB = new Date(b.publishTime || 0).getTime();
        return timeB - timeA;
      });

      const track = document.getElementById('testiTrack');
      if (!track) return;

      // Actualizar tarjetas en el track con las más recientes ordenadas
      track.innerHTML = reviews.map(buildCard).join('');

      if (statusEl) {
        statusEl.innerHTML = `<span class="live-indicator-dot"></span> ${lang === 'en' ? 'Google reviews updated in real-time' : 'Opiniones de Google actualizadas en tiempo real'}`;
        statusEl.className = 'reviews-status-text success';
      }

      // Re-inicializa el slider con las nuevas cards
      if (typeof window.initTestimonialsSlider === 'function') {
        window.initTestimonialsSlider();
      }
    } catch (err) {
      console.warn('[GoogleReviews] live fetch error or using cached reviews:', err);
    }
  }

  // Ejecuta el fetch live cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchLiveReviews);
  } else {
    fetchLiveReviews();
  }
})();
</script>

