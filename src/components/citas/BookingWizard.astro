</style>

<script>
  import { AvailabilityService } from '../../services/availability/availabilityService';
  import { bookingStore } from '../../services/db/bookingStore';
  import { AttributionService } from '../../services/attribution/attributionService';
  import { AnalyticsTracker } from '../../services/analytics/eventTracking';
  import { GHLService } from '../../services/ghl/GHLService';

  // --- Wizard State ---
  const state = {
    step: 1,
    serviceId: '',
    serviceName: '',
    serviceSlug: '',
    serviceDuration: 30,
    appointmentType: 'in_person' as 'in_person' | 'phone' | 'virtual',
    selectedDate: '',
    selectedTime: '',
    selectedEndTime: '',
    bookingReference: ''
  };

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize marketing attribution from URL params
    const attribution = AttributionService.init();
    AnalyticsTracker.trackPageView();

    // 2. Check URL parameters for pre-selected service and city
    const urlParams = new URLSearchParams(window.location.search);
    const preService = urlParams.get('service');
    const preCity = urlParams.get('city');

    if (preCity) {
      const citySelect = document.getElementById('clientCity') as HTMLSelectElement;
      if (citySelect) {
        for (let i = 0; i < citySelect.options.length; i++) {
          if (citySelect.options[i].value.toLowerCase().includes(preCity.toLowerCase())) {
            citySelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    // --- STEP 1: SERVICE SELECTION ---
    const serviceCards = document.querySelectorAll('.service-select-card');
    serviceCards.forEach(card => {
      card.addEventListener('click', () => {
        const sId = card.getAttribute('data-service-id') || '';
        const sName = card.getAttribute('data-service-name') || '';
        const sSlug = card.getAttribute('data-service-slug') || '';
        const sDuration = parseInt(card.getAttribute('data-service-duration') || '30', 10);
        const allowedTypesRaw = card.getAttribute('data-allowed-types') || '["in_person","phone","virtual"]';

        state.serviceId = sId;
        state.serviceName = sName;
        state.serviceSlug = sSlug;
        state.serviceDuration = sDuration;

        AnalyticsTracker.trackServiceSelected(sId, sName);

        // Filter Step 2 allowed appointment types
        try {
          const allowed = JSON.parse(allowedTypesRaw);
          const inPersonCard = document.getElementById('typeCardInPerson');
          const phoneCard = document.getElementById('typeCardPhone');
          const virtualCard = document.getElementById('typeCardVirtual');

          if (inPersonCard) inPersonCard.style.display = allowed.includes('in_person') ? 'flex' : 'none';
          if (phoneCard) phoneCard.style.display = allowed.includes('phone') ? 'flex' : 'none';
          if (virtualCard) virtualCard.style.display = allowed.includes('virtual') ? 'flex' : 'none';

          // Preselect first available type
          const firstType = allowed[0] || 'in_person';
          selectType(firstType);
        } catch (e) {}

        goToStep(2);
      });
    });

    // Auto-select service if passed in query param
    if (preService) {
      const match = Array.from(serviceCards).find(c => 
        (c.getAttribute('data-service-slug') || '').toLowerCase() === preService.toLowerCase()
      );
      if (match) {
        (match as HTMLElement).click();
      }
    }

    // --- STEP 2: APPOINTMENT TYPE SELECTION ---
    const typeCards = document.querySelectorAll('.type-card');
    typeCards.forEach(card => {
      card.addEventListener('click', () => {
        const type = card.getAttribute('data-type') as 'in_person' | 'phone' | 'virtual';
        selectType(type);
        goToStep(3);
      });
    });

    function selectType(type: 'in_person' | 'phone' | 'virtual') {
      state.appointmentType = type;
      typeCards.forEach(c => c.classList.remove('selected'));
      const active = document.querySelector(`.type-card[data-type="${type}"]`);
      if (active) active.classList.add('selected');
      AnalyticsTracker.trackTypeSelected(type);
    }

    // --- STEP 3: DATE & TIME SELECTION ---
    function renderCalendar() {
      const carousel = document.getElementById('dateCarousel');
      if (!carousel) return;

      const days = AvailabilityService.getAvailableDays(state.serviceId, 30);
      carousel.innerHTML = '';

      days.forEach((day, index) => {
        if (!day.isOpen) return;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `date-day-btn ${index === 0 ? 'selected' : ''}`;
        btn.innerHTML = `
          <span class="day-name">${day.dayName.slice(0, 3)}</span>
          <span class="day-num">${parseInt(day.date.split('-')[2], 10)}</span>
          <span class="day-month">${day.formattedDate.split(' ')[2].slice(0, 3)}</span>
        `;

        btn.addEventListener('click', () => {
          document.querySelectorAll('.date-day-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          state.selectedDate = day.date;
          AnalyticsTracker.trackDateSelected(day.date);
          renderSlots(day.date);
        });

        carousel.appendChild(btn);

        // Auto-select first date
        if (index === 0 && !state.selectedDate) {
          state.selectedDate = day.date;
          renderSlots(day.date);
        }
      });
    }

    function renderSlots(dateStr: string) {
      const slotsContainer = document.getElementById('slotsGrid');
      const summaryBar = document.getElementById('selectedTimeBar');
      if (!slotsContainer) return;

      slotsContainer.innerHTML = '';
      if (summaryBar) summaryBar.style.display = 'none';
      state.selectedTime = '';

      const slots = AvailabilityService.getSlotsForDate(dateStr, state.serviceDuration);
      const availableSlots = slots.filter(s => s.available);

      if (availableSlots.length === 0) {
        slotsContainer.innerHTML = '<p style="color: #64748b; padding: 10px 0;">No hay horarios disponibles en esta fecha. Por favor elige otro día.</p>';
        return;
      }

      slots.forEach(slot => {
        const slotBtn = document.createElement('button');
        slotBtn.type = 'button';
        slotBtn.className = `slot-btn ${slot.available ? '' : 'disabled'}`;
        slotBtn.textContent = slot.label;
        slotBtn.disabled = !slot.available;

        if (slot.available) {
          slotBtn.addEventListener('click', () => {
            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
            slotBtn.classList.add('selected');

            state.selectedTime = slot.value;
            state.selectedEndTime = slot.endTime;

            const summaryText = document.getElementById('summaryDateTimeText');
            if (summaryText) {
              summaryText.textContent = `${state.selectedDate} a las ${slot.label} (Hora NY)`;
            }
            if (summaryBar) summaryBar.style.display = 'flex';

            AnalyticsTracker.trackTimeSelected(slot.value);
          });
        }

        slotsContainer.appendChild(slotBtn);
      });
    }

    const proceedToStep4Btn = document.getElementById('proceedToStep4');
    if (proceedToStep4Btn) {
      proceedToStep4Btn.addEventListener('click', () => {
        if (!state.selectedDate || !state.selectedTime) return;

        // Update step 4 recap box
        const recapSvc = document.getElementById('recapServiceName');
        const recapType = document.getElementById('recapTypeName');
        const recapDT = document.getElementById('recapDateTime');

        const typeLabels: Record<string, string> = {
          in_person: '🏢 Cita Presencial (Newark, NJ)',
          phone: '📞 Cita Telefónica',
          virtual: '💻 Cita Virtual (Videollamada)'
        };

        if (recapSvc) recapSvc.textContent = state.serviceName;
        if (recapType) recapType.textContent = typeLabels[state.appointmentType] || state.appointmentType;
        if (recapDT) recapDT.textContent = `${state.selectedDate} a las ${AvailabilityService.formatTo12h(state.selectedTime)} (Eastern Time)`;

        AnalyticsTracker.trackContactFormStarted();
        goToStep(4);
      });
    }

    // --- STEP 4: FORM SUBMISSION ---
    const form = document.getElementById('bookingClientForm') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('btnSubmitBooking') as HTMLButtonElement;
        const errorAlert = document.getElementById('formErrorAlert');
        if (errorAlert) errorAlert.style.display = 'none';

        const firstName = (document.getElementById('clientFirstName') as HTMLInputElement).value.trim();
        const lastName = (document.getElementById('clientLastName') as HTMLInputElement).value.trim();
        const phone = (document.getElementById('clientPhone') as HTMLInputElement).value.trim();
        const email = (document.getElementById('clientEmail') as HTMLInputElement).value.trim();
        const city = (document.getElementById('clientCity') as HTMLSelectElement).value;
        const preferredLang = (document.getElementById('clientLang') as HTMLSelectElement).value as 'es' | 'en';
        const notes = (document.getElementById('clientNotes') as HTMLTextAreaElement).value.trim();

        if (!firstName || !lastName || !phone || !email) {
          if (errorAlert) {
            errorAlert.textContent = 'Por favor completa todos los campos obligatorios (*) marcados.';
            errorAlert.style.display = 'block';
          }
          return;
        }

        // Disable button while processing
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Procesando reserva segura...';
        }

        const attr = AttributionService.get();
        const idempotencyKey = `idemp_${phone.replace(/\D/g, '')}_${state.selectedDate}_${state.selectedTime}`;

        // 1. Save contact in local store
        const contact = bookingStore.saveContact({
          first_name: firstName,
          last_name: lastName,
          full_name: `${firstName} ${lastName}`.trim(),
          phone,
          email,
          city,
          state: 'NJ',
          preferred_language: preferredLang,
          source: 'Website Online Booking',
          utm_source: attr.utm_source,
          utm_medium: attr.utm_medium,
          utm_campaign: attr.utm_campaign,
          utm_content: attr.utm_content,
          utm_term: attr.utm_term,
          gclid: attr.gclid,
          fbclid: attr.fbclid
        });

        // 2. Save appointment in local store with strict availability verification
        const appointmentResult = bookingStore.saveAppointment({
          contact_id: contact.id,
          contact_name: contact.full_name,
          contact_phone: contact.phone,
          contact_email: contact.email,
          service_id: state.serviceId,
          service_name: state.serviceName,
          appointment_type: state.appointmentType,
          date: state.selectedDate,
          start_time: state.selectedTime,
          end_time: state.selectedEndTime || AvailabilityService.addMinutes(state.selectedTime, state.serviceDuration),
          timezone: 'America/New_York',
          status: 'confirmed',
          city,
          notes,
          source: 'Online Booking Flow',
          landing_page: window.location.pathname,
          utm_source: attr.utm_source,
          utm_medium: attr.utm_medium,
          utm_campaign: attr.utm_campaign,
          utm_content: attr.utm_content,
          utm_term: attr.utm_term,
          gclid: attr.gclid,
          fbclid: attr.fbclid,
          idempotency_key: idempotencyKey,
          ghl_sync_status: 'pending',
          sync_attempts: 0
        });

        if (!appointmentResult.success || !appointmentResult.appointment) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Confirmar y Reservar Mi Cita';
          }
          if (errorAlert) {
            errorAlert.textContent = appointmentResult.error || 'No pudimos completar la reserva. Intenta con otro horario.';
            errorAlert.style.display = 'block';
          }
          return;
        }

        const bookedApp = appointmentResult.appointment;
        state.bookingReference = bookedApp.booking_reference;

        AnalyticsTracker.trackSubmitted(state.serviceId, city);
        AnalyticsTracker.trackConfirmed(bookedApp.booking_reference, state.serviceId, city);

        // 3. Initiate downstream sync to GoHighLevel (non-blocking)
        GHLService.syncAppointment(bookedApp.id).then(res => {
          console.log('[BookingWizard] GHL sync result:', res.message);
        });

        // 4. Update Step 5 Confirmation Screen
        const cRef = document.getElementById('confirmedRefCode');
        const cClient = document.getElementById('confirmedClientName');
        const cSvc = document.getElementById('confirmedServiceName');
        const cType = document.getElementById('confirmedTypeName');
        const cDT = document.getElementById('confirmedDateTime');
        const cLoc = document.getElementById('confirmedLocation');

        const typeLabels: Record<string, string> = {
          in_person: '🏢 Cita Presencial',
          phone: '📞 Cita Telefónica',
          virtual: '💻 Cita Virtual (Videollamada)'
        };

        if (cRef) cRef.textContent = bookedApp.booking_reference;
        if (cClient) cClient.textContent = bookedApp.contact_name;
        if (cSvc) cSvc.textContent = bookedApp.service_name;
        if (cType) cType.textContent = typeLabels[bookedApp.appointment_type] || bookedApp.appointment_type;
        if (cDT) cDT.textContent = `${bookedApp.date} a las ${AvailabilityService.formatTo12h(bookedApp.start_time)} (Eastern Time)`;
        if (cLoc) {
          cLoc.textContent = bookedApp.appointment_type === 'in_person'
            ? '20 Bloomfield Pl, Newark, NJ 07104'
            : bookedApp.appointment_type === 'phone'
              ? `Llamada telefónica a tu número (${bookedApp.contact_phone})`
              : 'Enlace de Google Meet / Zoom enviado a tu correo y WhatsApp';
        }

        // Setup Calendar Links
        setupCalendarLinks(bookedApp);

        // Navigate to Step 5
        goToStep(5);
      });
    }

    function setupCalendarLinks(app: any) {
      const title = encodeURIComponent(`Cita MAPA Business: ${app.service_name}`);
      const details = encodeURIComponent(`Cita con MAPA Business & Financial Services LLC.\nServicio: ${app.service_name}\nModalidad: ${app.appointment_type}\nRef: ${app.booking_reference}\nTeléfono: (862) 622-8339`);
      const location = encodeURIComponent(app.appointment_type === 'in_person' ? '20 Bloomfield Pl, Newark, NJ 07104' : 'Remoto / Virtual');

      // Dates format YYYYMMDDTHHmm00Z
      const cleanStart = app.date.replace(/-/g, '') + 'T' + app.start_time.replace(/:/g, '') + '00';
      const cleanEnd = app.date.replace(/-/g, '') + 'T' + app.end_time.replace(/:/g, '') + '00';

      // Google Calendar Link
      const googleBtn = document.getElementById('btnCalGoogle') as HTMLAnchorElement;
      if (googleBtn) {
        googleBtn.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${cleanStart}/${cleanEnd}&details=${details}&location=${location}&ctz=America/New_York`;
      }

      // Outlook Web Link
      const outlookBtn = document.getElementById('btnCalOutlook') as HTMLAnchorElement;
      if (outlookBtn) {
        outlookBtn.href = `https://outlook.live.com/calendar/0/deeplink/compose?subject=${title}&body=${details}&location=${location}&startdt=${app.date}T${app.start_time}&enddt=${app.date}T${app.end_time}`;
      }

      // Apple / ICS Download
      const icsBtn = document.getElementById('btnCalIcs');
      if (icsBtn) {
        icsBtn.onclick = () => {
          const icsContent = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//MAPA Business//Booking System//ES',
            'BEGIN:VEVENT',
            `UID:${app.booking_reference}@marilynmapabusiness.com`,
            `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z`,
            `DTSTART;TZID=America/New_York:${cleanStart}`,
            `DTEND;TZID=America/New_York:${cleanEnd}`,
            `SUMMARY:${app.service_name} - MAPA Business`,
            `DESCRIPTION:Cita confirmada con MAPA Business & Financial Services LLC. Ref: ${app.booking_reference}`,
            `LOCATION:${app.appointment_type === 'in_person' ? '20 Bloomfield Pl, Newark, NJ 07104' : 'Remoto / Virtual'}`,
            'STATUS:CONFIRMED',
            'END:VEVENT',
            'END:VCALENDAR'
          ].join('\r\n');

          const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
          const link = document.createElement('a');
          link.href = window.URL.createObjectURL(blob);
          link.setAttribute('download', `Cita-MAPA-${app.booking_reference}.ics`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        };
      }
    }

    // --- NAVIGATION & STEP TRANSITIONS ---
    function goToStep(targetStep: number) {
      state.step = targetStep;

      // Hide all steps
      for (let i = 1; i <= 5; i++) {
        const stepEl = document.getElementById(`step${i}`);
        if (stepEl) stepEl.style.display = i === targetStep ? 'block' : 'none';
      }

      // Update stepper indicators
      const indicators = document.querySelectorAll('.step-indicator');
      indicators.forEach(ind => {
        const sNum = parseInt(ind.getAttribute('data-step') || '1', 10);
        ind.classList.remove('active', 'completed');
        if (sNum === targetStep) ind.classList.add('active');
        else if (sNum < targetStep) ind.classList.add('completed');
      });

      // Special action when entering step 3 (Calendar)
      if (targetStep === 3) {
        renderCalendar();
      }

      // Smooth scroll to container
      const container = document.getElementById('booking-flow');
      if (container) {
        container.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Back Buttons
    const back1 = document.getElementById('backToStep1');
    const back2 = document.getElementById('backToStep2');
    const back3 = document.getElementById('backToStep3');

    if (back1) back1.addEventListener('click', () => goToStep(1));
    if (back2) back2.addEventListener('click', () => goToStep(2));
    if (back3) back3.addEventListener('click', () => goToStep(3));
  });
</script>
