---
import { APP_CONFIG } from '../../services/config/appConfig';

interface Props {
  lang?: 'es' | 'en';
  initialCity?: string;
  initialService?: string;
}

const { lang = 'es', initialCity = '', initialService = '' } = Astro.props;

const services = APP_CONFIG.services.filter(s => s.status === 'active');
const cities = APP_CONFIG.cities;
const phoneHref = APP_CONFIG.business.phoneHref;
const phoneDisplay = APP_CONFIG.business.phone;
---

<div class="booking-wizard-container" id="booking-flow">
  <!-- Top Progress Bar -->
  <div class="wizard-stepper" id="wizardStepper">
    <div class="step-indicator active" data-step="1">
      <span class="step-num">1</span>
      <span class="step-title">{lang === 'es' ? 'Servicio' : 'Service'}</span>
    </div>
    <div class="step-divider"></div>
    <div class="step-indicator" data-step="2">
      <span class="step-num">2</span>
      <span class="step-title">{lang === 'es' ? 'Modalidad' : 'Type'}</span>
    </div>
    <div class="step-divider"></div>
    <div class="step-indicator" data-step="3">
      <span class="step-num">3</span>
      <span class="step-title">{lang === 'es' ? 'Horario' : 'Time'}</span>
    </div>
    <div class="step-divider"></div>
    <div class="step-indicator" data-step="4">
      <span class="step-num">4</span>
      <span class="step-title">{lang === 'es' ? 'Tus Datos' : 'Details'}</span>
    </div>
  </div>

  <!-- Wizard Content Box -->
  <div class="wizard-card">
    
    <!-- ============================================== -->
    <!-- PASO 1: SELECCIÓN DE SERVICIO                  -->
    <!-- ============================================== -->
    <div class="wizard-step" id="step1" style="display: block;">
      <div class="step-header">
        <div class="step-header-top">
          <div class="nav-ghost"></div>
          <span class="step-badge">{lang === 'es' ? 'Paso 1 de 4' : 'Step 1 of 4'}</span>
          <div class="nav-ghost"></div>
        </div>
        <h2>{lang === 'es' ? '¿En qué podemos ayudarte?' : 'How can we help you?'}</h2>
        <p class="step-subtitle">
          {lang === 'es' 
            ? 'Selecciona el trámite que necesitas resolver. Si no estás seguro, elige la primera opción de orientación.'
            : 'Select the service you need. If you are not sure, pick our initial consultation option.'}
        </p>
      </div>

      <div class="services-selection-grid">
        {services.map((svc) => (
          <div 
            class={`service-select-card ${svc.id === 'srv_not_sure' ? 'card-featured-unsure' : ''}`}
            data-service-id={svc.id}
            data-service-name={lang === 'es' ? svc.name : svc.nameEn}
            data-service-slug={svc.slug}
            data-service-duration={svc.duration}
            data-allowed-types={JSON.stringify(svc.allowedTypes)}
          >
            {svc.id === 'srv_not_sure' && (
              <span class="featured-badge">⭐ {lang === 'es' ? 'Opción Recomendada si tienes dudas' : 'Recommended if unsure'}</span>
            )}
            <div class="card-icon-wrap">
              <span class="card-emoji">{svc.icon}</span>
              <span class="duration-tag">⏱️ {svc.duration} min</span>
            </div>
            <h3 class="card-name">{lang === 'es' ? svc.name : svc.nameEn}</h3>
            <p class="card-description">{lang === 'es' ? svc.description : svc.descriptionEn}</p>
            <div class="card-select-btn">
              <span>{lang === 'es' ? 'Elegir este servicio' : 'Select this service'} →</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ============================================== -->
    <!-- PASO 2: TIPO DE CITA                           -->
    <!-- ============================================== -->
    <div class="wizard-step" id="step2" style="display: none;">
      <div class="step-header">
        <div class="step-header-top">
          <button type="button" class="btn-back" id="backToStep1">← {lang === 'es' ? 'Cambiar servicio' : 'Change service'}</button>
          <span class="step-badge">{lang === 'es' ? 'Paso 2 de 4' : 'Step 2 of 4'}</span>
          <div class="nav-ghost"></div>
        </div>
        <h2>{lang === 'es' ? '¿Cómo prefieres tu cita?' : 'How do you prefer your appointment?'}</h2>
        <p class="step-subtitle">
          {lang === 'es'
            ? 'Elige la modalidad más cómoda para ti. Atendemos en nuestra oficina o a distancia.'
            : 'Select the most convenient option for you. We serve in person or remotely.'}
        </p>
      </div>

      <div class="type-selection-grid">
        <!-- In Person -->
        <div class="type-card" data-type="in_person" id="typeCardInPerson">
          <div class="type-icon">🏢</div>
          <div class="type-info">
            <h3 class="type-title">{lang === 'es' ? 'Cita Presencial' : 'In-Person Appointment'}</h3>
            <p class="type-desc">
              {lang === 'es'
                ? 'Te esperamos en nuestra sede central en 20 Bloomfield Pl, Newark, NJ 07104. Fácil acceso desde Elizabeth, Paterson y todo New Jersey.'
                : 'Meet us at our main office in 20 Bloomfield Pl, Newark, NJ 07104. Easy access from anywhere in NJ.'}
            </p>
            <span class="type-badge-note">📍 {lang === 'es' ? 'Recomendado para notarizaciones y entrega de documentos físicos' : 'Required for notary & physical signatures'}</span>
          </div>
          <div class="type-check">✓</div>
        </div>

        <!-- Phone Call -->
        <div class="type-card" data-type="phone" id="typeCardPhone">
          <div class="type-icon">📞</div>
          <div class="type-info">
            <h3 class="type-title">{lang === 'es' ? 'Cita Telefónica' : 'Phone Appointment'}</h3>
            <p class="type-desc">
              {lang === 'es'
                ? 'Marilyn Paladinez o nuestro equipo te llamará puntualmente a la hora acordada a tu número telefónico.'
                : 'Marilyn Paladinez or our team will call you promptly at the scheduled time.'}
            </p>
            <span class="type-badge-note">⚡ {lang === 'es' ? 'Rápido, cómodo y sin necesidad de traslados' : 'Quick and convenient without travel'}</span>
          </div>
          <div class="type-check">✓</div>
        </div>

        <!-- Virtual Video -->
        <div class="type-card" data-type="virtual" id="typeCardVirtual">
          <div class="type-icon">💻</div>
          <div class="type-info">
            <h3 class="type-title">{lang === 'es' ? 'Cita Virtual (Videollamada)' : 'Virtual Video Meeting'}</h3>
            <p class="type-desc">
              {lang === 'es'
                ? 'Videollamada por Google Meet o Zoom. Te enviamos el enlace por correo y WhatsApp para conectarte desde tu teléfono o computadora.'
                : 'Video call via Google Meet or Zoom. We will email and text you the meeting link.'}
            </p>
            <span class="type-badge-note">🖥️ {lang === 'es' ? 'Ideal para revisar documentos en pantalla' : 'Great for reviewing documents together'}</span>
          </div>
          <div class="type-check">✓</div>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- PASO 3: FECHA Y HORARIO (America/New_York)     -->
    <!-- ============================================== -->
    <div class="wizard-step" id="step3" style="display: none;">
      <div class="step-header">
        <div class="step-header-top">
          <button type="button" class="btn-back" id="backToStep2">← {lang === 'es' ? 'Cambiar modalidad' : 'Change type'}</button>
          <span class="step-badge">{lang === 'es' ? 'Paso 3 de 4' : 'Step 3 of 4'}</span>
          <div class="nav-ghost"></div>
        </div>
        <h2>{lang === 'es' ? 'Selecciona Día y Horario' : 'Select Date & Time'}</h2>
        <p class="step-subtitle">
          {lang === 'es' 
            ? 'Zona horaria: America/New_York (Hora del Este). Todos los horarios se confirman en tiempo real.'
            : 'Timezone: America/New_York (Eastern Time). All slots are confirmed in real time.'}
        </p>
      </div>

      <!-- Horizontal Date Picker -->
      <div class="date-picker-section">
        <label class="section-label">📅 {lang === 'es' ? '1. Elige una fecha disponible:' : '1. Choose an available date:'}</label>
        <div class="date-carousel" id="dateCarousel">
          <!-- Populated by JS -->
          <div class="date-loading-state">{lang === 'es' ? 'Cargando fechas disponibles...' : 'Loading available dates...'}</div>
        </div>
      </div>

      <!-- Time Slots Grid -->
      <div class="slots-section" id="slotsSection">
        <label class="section-label">⏰ {lang === 'es' ? '2. Selecciona tu horario:' : '2. Select your time:'}</label>
        <div class="slots-grid" id="slotsGrid">
          <p class="select-date-prompt">{lang === 'es' ? 'Selecciona una fecha arriba para ver los horarios libres.' : 'Select a date above to see available times.'}</p>
        </div>
      </div>

      <div class="selected-summary-bar" id="selectedTimeBar" style="display: none;">
        <div class="summary-text">
          <span class="summary-label">{lang === 'es' ? 'Fecha y hora seleccionada:' : 'Selected time:'}</span>
          <strong id="summaryDateTimeText">-</strong>
        </div>
        <button type="button" class="btn btn-red" id="proceedToStep4">
          {lang === 'es' ? 'Continuar con mis datos' : 'Continue to details'} →
        </button>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- PASO 4: DATOS DEL CLIENTE                      -->
    <!-- ============================================== -->
    <div class="wizard-step" id="step4" style="display: none;">
      <div class="step-header">
        <div class="step-header-top">
          <button type="button" class="btn-back" id="backToStep3">← {lang === 'es' ? 'Cambiar fecha/hora' : 'Change date/time'}</button>
          <span class="step-badge">{lang === 'es' ? 'Paso 4 de 4' : 'Step 4 of 4'}</span>
          <div class="nav-ghost"></div>
        </div>
        <h2>{lang === 'es' ? 'Ingresa tus datos de contacto' : 'Enter your contact details'}</h2>
        <p class="step-subtitle">
          {lang === 'es'
            ? 'Usaremos esta información exclusivamente para confirmar tu cita y enviarte recordatorios.'
            : 'We will use this information solely to confirm your appointment and send reminders.'}
        </p>
      </div>

      <!-- Mini recap box -->
      <div class="booking-recap-box">
        <div class="recap-item">
          <span class="recap-label">{lang === 'es' ? 'Servicio:' : 'Service:'}</span>
          <strong id="recapServiceName">-</strong>
        </div>
        <div class="recap-item">
          <span class="recap-label">{lang === 'es' ? 'Modalidad:' : 'Type:'}</span>
          <strong id="recapTypeName">-</strong>
        </div>
        <div class="recap-item">
          <span class="recap-label">{lang === 'es' ? 'Fecha y Hora:' : 'Date & Time:'}</span>
          <strong id="recapDateTime">-</strong>
        </div>
      </div>

      <form id="bookingClientForm" class="booking-form">
        <div class="form-row">
          <div class="form-group">
            <label for="clientFirstName">{lang === 'es' ? 'Nombre*' : 'First Name*'}</label>
            <input type="text" id="clientFirstName" name="firstName" required placeholder="Ej. Carlos" />
          </div>
          <div class="form-group">
            <label for="clientLastName">{lang === 'es' ? 'Apellido*' : 'Last Name*'}</label>
            <input type="text" id="clientLastName" name="lastName" required placeholder="Ej. Gómez" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="clientPhone">{lang === 'es' ? 'Teléfono (WhatsApp o Celular)*' : 'Phone (Mobile/WhatsApp)*'}</label>
            <input type="tel" id="clientPhone" name="phone" required placeholder="Ej. (973) 555-0123" />
          </div>
          <div class="form-group">
            <label for="clientEmail">{lang === 'es' ? 'Correo Electrónico*' : 'Email Address*'}</label>
            <input type="email" id="clientEmail" name="email" required placeholder="Ej. carlos@correo.com" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="clientCity">{lang === 'es' ? 'Ciudad donde vives*' : 'City*'}</label>
            <select id="clientCity" name="city" required>
              <option value="Newark, NJ">Newark, NJ</option>
              <option value="Elizabeth, NJ">Elizabeth, NJ</option>
              <option value="Paterson, NJ">Paterson, NJ</option>
              <option value="Jersey City, NJ">Jersey City, NJ</option>
              <option value="Passaic, NJ">Passaic, NJ</option>
              <option value="Clifton, NJ">Clifton, NJ</option>
              <option value="Otra Ciudad en NJ">Otra Ciudad en NJ</option>
              <option value="Otro Estado / USA">Otro Estado / USA</option>
            </select>
          </div>
          <div class="form-group">
            <label for="clientLang">{lang === 'es' ? 'Idioma preferido de atención*' : 'Preferred Language*'}</label>
            <select id="clientLang" name="preferredLanguage">
              <option value="es">Español</option>
              <option value="en">English</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="clientNotes">
            {lang === 'es' ? 'Cuéntanos brevemente qué necesitas (Opcional):' : 'Briefly describe your inquiry (Optional):'}
          </label>
          <textarea 
            id="clientNotes" 
            name="notes" 
            rows="3" 
            placeholder={lang === 'es' ? 'Ejemplo: Necesito ayuda con mi ITIN y no sé qué documentos debo llevar a la cita.' : 'Example: I need help with my ITIN application and want to know what documents to bring.'}
          ></textarea>
        </div>

        <div class="form-consent">
          <label class="checkbox-label">
            <input type="checkbox" id="clientConsent" name="consent" checked required />
            <span>
              {lang === 'es'
                ? 'Acepto recibir recordatorios y comunicaciones de MAPA Business & Financial Services sobre esta cita por llamada, SMS o WhatsApp.'
                : 'I agree to receive appointment confirmations and reminders from MAPA Business & Financial Services via call, SMS, or WhatsApp.'}
            </span>
          </label>
        </div>

        <div class="form-error-alert" id="formErrorAlert" style="display: none;"></div>

        <div class="form-submit-wrap">
          <button type="submit" class="btn btn-red btn-submit-booking" id="btnSubmitBooking">
            <span>🔒</span> {lang === 'es' ? 'Confirmar y Reservar Mi Cita' : 'Confirm & Book My Appointment'}
          </button>
          <p class="submit-subtext">
            ⚡ {lang === 'es' ? 'Reservar toma menos de 2 minutos. Confirmación inmediata.' : 'Takes less than 2 minutes. Instant confirmation.'}
          </p>
        </div>
      </form>
    </div>

    <!-- ============================================== -->
    <!-- PASO 5: PANTALLA DE CONFIRMACIÓN               -->
    <!-- ============================================== -->
    <div class="wizard-step" id="step5" style="display: none;">
      <div class="success-header">
        <div class="success-icon">🎉</div>
        <h2>{lang === 'es' ? '¡Tu cita ha sido reservada con éxito!' : 'Your appointment has been booked!'}</h2>
        <p class="success-subtitle">
          {lang === 'es'
            ? 'Hemos registrado tu cita en nuestro sistema y te contactaremos para confirmar cualquier detalle adicional.'
            : 'Your appointment is registered in our system and we will reach out with any further details.'}
        </p>
      </div>

      <div class="confirmation-card">
        <div class="ref-badge-wrap">
          <span class="ref-label">{lang === 'es' ? 'Número de Confirmación:' : 'Confirmation Code:'}</span>
          <span class="ref-code" id="confirmedRefCode">MAPA-2026-XXXXX</span>
        </div>

        <div class="confirmed-details-list">
          <div class="c-detail-item">
            <span class="cd-label">👤 {lang === 'es' ? 'Cliente:' : 'Client:'}</span>
            <strong id="confirmedClientName">-</strong>
          </div>
          <div class="c-detail-item">
            <span class="cd-label">📋 {lang === 'es' ? 'Servicio:' : 'Service:'}</span>
            <strong id="confirmedServiceName">-</strong>
          </div>
          <div class="c-detail-item">
            <span class="cd-label">📍 {lang === 'es' ? 'Modalidad:' : 'Type:'}</span>
            <strong id="confirmedTypeName">-</strong>
          </div>
          <div class="c-detail-item">
            <span class="cd-label">📅 {lang === 'es' ? 'Fecha y Hora:' : 'Date & Time:'}</span>
            <strong id="confirmedDateTime">-</strong>
          </div>
          <div class="c-detail-item">
            <span class="cd-label">🏢 {lang === 'es' ? 'Lugar de Atención:' : 'Location:'}</span>
            <span id="confirmedLocation">20 Bloomfield Pl, Newark, NJ 07104</span>
          </div>
        </div>

        <!-- Add to Calendar Buttons -->
        <div class="add-to-calendar-block">
          <h4 class="calendar-title">📅 {lang === 'es' ? 'Agrega esta cita a tu calendario:' : 'Add to your calendar:'}</h4>
          <div class="calendar-buttons-group">
            <a href="#" target="_blank" class="btn-cal btn-cal-google" id="btnCalGoogle">
              <span>Google Calendar</span>
            </a>
            <button type="button" class="btn-cal btn-cal-ics" id="btnCalIcs">
              <span>Apple / Outlook (.ics)</span>
            </button>
            <a href="#" target="_blank" class="btn-cal btn-cal-outlook" id="btnCalOutlook">
              <span>Outlook Web</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Contact Card -->
      <div class="post-booking-help-box">
        <h4>{lang === 'es' ? '¿Necesitas hablar con nosotros antes de tu cita?' : 'Need to speak with us before your appointment?'}</h4>
        <p>
          {lang === 'es'
            ? 'Si tienes una pregunta urgente o necesitas coordinar la documentación a llevar, estamos disponibles:'
            : 'If you have an urgent question or need document instructions, reach out directly:'}
        </p>
        <div class="post-help-actions">
          <a href={`tel:${phoneHref}`} class="btn btn-red">
            <span>📞</span> {lang === 'es' ? 'Llamar Ahora' : 'Call Now'}: {phoneDisplay}
          </a>
          <a 
            href={`https://wa.me/${phoneHref}?text=Hola%20Marilyn%2C%20acabo%20de%20agendar%20mi%20cita%20y%20tengo%20una%20pregunta.`} 
            target="_blank" 
            class="btn btn-wa"
          >
            <span>💬</span> WhatsApp
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .booking-wizard-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px 16px 60px;
  }

  /* Stepper Header */
  .wizard-stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 14px 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .step-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #888888;
    font-size: 0.92rem;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .step-indicator.active {
    color: var(--red, #e63946);
  }

  .step-indicator.completed {
    color: #2b9348;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #eeeeee;
    color: #555555;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .step-indicator.active .step-num {
    background: var(--red, #e63946);
    color: #ffffff;
  }

  .step-indicator.completed .step-num {
    background: #2b9348;
    color: #ffffff;
  }

  .step-divider {
    flex: 1;
    height: 2px;
    background: #e5e7eb;
    margin: 0 12px;
  }

  /* Main Card */
  .wizard-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    padding: 36px 30px;
  }

  .step-header {
    text-align: center;
    margin-bottom: 28px;
    position: relative;
  }

  .step-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 14px;
    gap: 12px;
  }

  .nav-ghost {
    min-width: 130px;
    visibility: hidden;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 7px 16px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    min-width: 130px;
  }

  .btn-back:hover {
    background: #e2e8f0;
    color: #0f172a;
    transform: translateY(-1px);
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(230, 57, 70, 0.1);
    color: var(--red, #e63946);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 5px 16px;
    border-radius: 20px;
    margin-bottom: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .step-header-top {
      flex-direction: column-reverse;
      gap: 10px;
    }
    .nav-ghost {
      display: none;
    }
    .btn-back {
      width: 100%;
    }
  }

  .step-header h2 {
    font-size: 1.85rem;
    font-weight: 800;
    color: #111111;
    margin-bottom: 8px;
    line-height: 1.25;
  }

  .step-subtitle {
    font-size: 0.98rem;
    color: #666666;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Service Select Cards */
  .services-selection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }

  .service-select-card {
    background: #fafbfc;
    border: 2px solid #eef0f3;
    border-radius: 16px;
    padding: 20px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
    position: relative;
  }

  .service-select-card:hover {
    border-color: var(--red, #e63946);
    background: #ffffff;
    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.08);
    transform: translateY(-2px);
  }

  .card-featured-unsure {
    border-color: #fca5a5;
    background: #fffafa;
    grid-column: 1 / -1;
  }

  .card-featured-unsure:hover {
    border-color: var(--red, #e63946);
    background: #fff5f5;
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--red, #e63946);
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 3px 12px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(230, 57, 70, 0.3);
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
