---
import { APP_CONFIG } from '../../services/config/appConfig';

interface Props {
  calendarId?: string;
  lang?: 'es' | 'en';
}

const { 
  calendarId = APP_CONFIG.scheduling.defaultCalendarId || 'fSDS40eiTiXyNcvQ0sss', 
  lang = 'es' 
} = Astro.props;

const phoneHref = APP_CONFIG.business.phoneHref;
const phoneDisplay = APP_CONFIG.business.phone;
const embedUrl = `https://api.leadconnectorhq.com/widget/booking/${calendarId}`;
---

<div class="ghl-booking-wrapper" id="booking-flow">
  <div class="ghl-card">
    <div class="ghl-header">
      <span class="ghl-badge">⭐ {lang === 'es' ? 'Calendario en Tiempo Real' : 'Real-Time Calendar'}</span>
      <h2>{lang === 'es' ? 'Selecciona tu Día y Horario' : 'Select your Date & Time'}</h2>
      <p class="ghl-subtitle">
        {lang === 'es'
          ? 'Los horarios disponibles se actualizan al instante con nuestro sistema. Elige el día y la hora que mejor se adapten a tu horario.'
          : 'Available slots are updated in real time with our system. Choose the day and time that best fit your schedule.'}
      </p>
    </div>

    <!-- GoHighLevel Iframe Container -->
    <div class="ghl-iframe-container">
      <iframe
        src={embedUrl}
        style="width: 100%; border:none; overflow: hidden; min-height: 750px;"
        scrolling="no"
        id={`ghl_booking_${calendarId}`}
        title="GoHighLevel Appointment Booking"
        loading="lazy"
      ></iframe>
    </div>

    <!-- Quick Help & Direct Contacts -->
    <div class="ghl-support-box">
      <div class="support-info">
        <span class="support-icon">💬</span>
        <div>
          <h4>{lang === 'es' ? '¿Prefieres agendar directamente con una persona?' : 'Prefer to book directly with our team?'}</h4>
          <p>{lang === 'es' ? 'Llámanos o envíanos un WhatsApp para responder tus dudas de inmediato.' : 'Call or message us on WhatsApp to get immediate assistance.'}</p>
        </div>
      </div>
      <div class="support-actions">
        <a href={`tel:${phoneHref}`} class="btn-support-call">
          📞 {phoneDisplay}
        </a>
        <a 
          href={`https://wa.me/${phoneHref}?text=${encodeURIComponent(lang === 'es' ? 'Hola Marilyn, quisiera agendar una cita.' : 'Hello Marilyn, I would like to book an appointment.')}`} 
          target="_blank" 
          rel="noopener" 
          class="btn-support-wa"
        >
          💬 WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<!-- GoHighLevel Form Embed Script to auto-resize iframe smoothly -->
<script src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>

<style>
  .ghl-booking-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .ghl-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    padding: 36px 24px;
  }

  .ghl-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .ghl-badge {
    display: inline-block;
    background: rgba(230, 57, 70, 0.1);
    color: var(--red, #e63946);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 5px 16px;
    border-radius: 20px;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ghl-header h2 {
    font-size: 1.85rem;
    font-weight: 800;
    color: #111111;
    margin-bottom: 8px;
    line-height: 1.25;
  }

  .ghl-subtitle {
    font-size: 0.98rem;
    color: #666666;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ghl-iframe-container {
    width: 100%;
    min-height: 750px;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
  }

  .ghl-support-box {
    margin-top: 30px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .support-info {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    min-width: 260px;
  }

  .support-icon {
    font-size: 2rem;
  }

  .support-info h4 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
  }

  .support-info p {
    margin: 0;
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.4;
  }

  .support-actions {
    display: flex;
    gap: 12px;
  }

  .btn-support-call,
  .btn-support-wa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-support-call {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    color: #1e293b;
  }
  .btn-support-call:hover {
    border-color: #94a3b8;
    background: #f1f5f9;
  }

  .btn-support-wa {
    background: #25D366;
    color: #ffffff;
    border: 1.5px solid #25D366;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
  }
  .btn-support-wa:hover {
    background: #20ba5a;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .ghl-card {
      padding: 20px 12px;
    }
    .ghl-header h2 {
      font-size: 1.5rem;
    }
    .ghl-support-box {
      flex-direction: column;
      align-items: flex-start;
    }
    .support-actions {
      width: 100%;
      flex-direction: column;
    }
    .btn-support-call,
    .btn-support-wa {
      width: 100%;
      justify-content: center;
    }
  }
</style>
