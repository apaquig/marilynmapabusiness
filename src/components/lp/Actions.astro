---
import { PHONE, WHATSAPP } from './config';
interface Props { location: string; compact?: boolean }
const { location, compact = false } = Astro.props;
---
<div class:list={['actions', { compact }]}>
  <a class="action call" href={PHONE} data-button-location={location}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>{compact ? 'Llamar' : 'Llamar ahora'}</a>
  <a class="action whatsapp" href={WHATSAPP} target="_blank" rel="noopener noreferrer" data-button-location={location}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>{compact ? 'WhatsApp' : 'Escribir por WhatsApp'}</a>
</div>
<style>
.actions{display:flex;gap:12px;flex-wrap:wrap}.action{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:50px;padding:12px 20px;border-radius:10px;font-weight:700;text-decoration:none;line-height:1.3;transition:transform .2s}.action:hover{transform:translateY(-2px)}.call{background:#cc0000;color:white}.whatsapp{background:#ecfdf3;border:1px solid #15803d;color:#166534}.compact{flex-wrap:nowrap}.compact .action{flex:1;padding:12px;font-size:16px}@media(max-width:480px){.actions:not(.compact) .action{width:100%}}@media(prefers-reduced-motion:reduce){.action{transition:none}}
</style>
