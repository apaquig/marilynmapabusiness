---
import { legalPaths, smsConsent, LEGAL_VERSION } from '../data/legal';
interface Props { lang: 'es' | 'en'; compact?: boolean }
const { lang, compact = false } = Astro.props;
const paths = legalPaths[lang];
---
<fieldset class="sms-consent" data-consent-version={LEGAL_VERSION}>
  <legend>{lang === 'es' ? 'Preferencias SMS (opcionales)' : 'SMS preferences (optional)'}</legend>
  <div class="consent-row">
    <label><input type="checkbox" name="sms_informational" value="yes" /><span>{lang === 'es' ? 'Acepto SMS sobre citas y seguimiento.' : 'I agree to SMS about appointments and updates.'}</span></label>
    <details><summary>{lang === 'es' ? 'Leer más' : 'Read more'}</summary><p>{smsConsent[lang].informational}</p></details>
  </div>
  <div class="consent-row">
    <label><input type="checkbox" name="sms_marketing" value="yes" /><span>{lang === 'es' ? 'Acepto SMS con ofertas y novedades.' : 'I agree to SMS with offers and news.'}</span></label>
    <details><summary>{lang === 'es' ? 'Leer más' : 'Read more'}</summary><p>{smsConsent[lang].marketing}</p></details>
  </div>
  <p>{lang === 'es' ? 'Puedes elegir una, ambas o ninguna. El consentimiento no es condición para comprar o recibir servicios. Proporcionar tu número no autoriza SMS.' : 'Choose either, both, or neither. Consent is not a condition of purchasing or receiving services. Providing your number does not authorize SMS.'}</p>
  <p><a href={paths.privacy}>{lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}</a> · <a href={paths.terms}>{lang === 'es' ? 'Términos y Condiciones' : 'Terms and Conditions'}</a> · <a href={paths.sms}>SMS Opt-In</a></p>
</fieldset>
<style>
  .sms-consent { min-width: 0; margin: 20px 0; padding: 18px; border: 1px solid #cbd5e1; border-radius: 12px; color: #334155; background: #f8fafc; }
  legend { padding: 0 6px; font-weight: 700; font-size: .95rem; }
  .consent-row { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; column-gap: 10px; padding: 8px 0; border-bottom: 1px solid #e2e8f0; }
  .consent-row label { display: flex; min-width: 0; align-items: center; gap: 9px; margin: 0; font-size: 8px; line-height: 1.3; cursor: pointer; }
  .consent-row label span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  input[type='checkbox'] { flex: 0 0 17px; width: 17px; height: 17px; padding: 0 !important; border-radius: 3px !important; margin: 0; accent-color: #b91c1c; }
  details { display: contents; }
  summary { grid-column: 2; grid-row: 1; color: #991b1b; font-size: 8px; font-weight: 700; text-decoration: underline; cursor: pointer; list-style: none; white-space: nowrap; }
  summary::-webkit-details-marker { display: none; }
  details>p { grid-column: 1 / -1; margin: 8px 0 2px; padding: 10px 12px; border-radius: 8px; background: #fff; color: #475569; font-size: 8px; line-height: 1.5; }
  p { font-size: 8px; line-height: 1.5; margin: 10px 0 0; }
  a { color: #991b1b; text-decoration: underline; }
  @media(max-width:480px){.sms-consent{padding:14px}.consent-row{column-gap:7px}.consent-row label{font-size:8px}.consent-row label span{max-width:190px}summary{font-size:8px}.sms-consent>p{font-size:8px}}
</style>
