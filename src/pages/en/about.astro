---
// src/pages/en/about.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = `${WEBSITE}/en/about/`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${WEBSITE}/en/about/#webpage`,
      "url": canonical,
      "name": "About MAPA Business & Financial Services LLC | Newark, NJ",
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "about": { "@id": `${WEBSITE}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is MAPA Business & Financial Services LLC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "MAPA Business & Financial Services LLC is a company founded by Marilyn Paladinez in Newark, New Jersey, that provides Spanish-language guidance to Latino migrant families, entrepreneurs, and small businesses in notarial, financial, and document preparation services."
          }
        },
        {
          "@type": "Question",
          "name": "Where is MAPA Business located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We are located at 20 Bloomfield Pl, Newark, NJ 07104. We also serve clients digitally throughout New Jersey."
          }
        },
        {
          "@type": "Question",
          "name": "Does MAPA Business serve Spanish-speaking clients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Spanish is our primary language of service. Marilyn Paladinez and her team attend to the Latino community with understanding of their cultural needs and migration journey."
          }
        },
        {
          "@type": "Question",
          "name": "Is MAPA Business a law firm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. MAPA Business & Financial Services LLC is not a law firm. Marilyn Paladinez is a certified Notary Public in New Jersey and offers guidance and document preparation. We do not provide legal advice or legal representation."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="en"
  title="About MAPA Business & Financial Services LLC | Newark, NJ"
  description="Learn about the history, mission, and values of MAPA Business & Financial Services LLC. Founded by Marilyn Paladinez in Newark, NJ to serve the Latino community."
  canonical={canonical}
  currentPath="/en/about/"
  schema={schema}
>
  <div class="breadcrumb">
    <a href="/en/">Home</a>
    <span>›</span>
    <span>About MAPA</span>
  </div>

  <section class="about-hero">
    <div class="about-hero-inner">
      <div class="page-tag">Our Story</div>
      <h1>
        <span>About </span><span>MAPA Business</span><br>
        <span style="font-size:0.75em; font-weight:600; color:rgba(255,255,255,0.7);">&amp; Financial Services LLC</span>
      </h1>
      <p class="page-intro">
        A company founded with a clear purpose: to support the Latino community in New Jersey
        with reliable, accessible guidance — in their own language.
      </p>
    </div>
  </section>

  <section class="about-content">
    <div class="about-grid">
      <div class="about-block">
        <h2 class="about-section-title">Our <span>Story</span></h2>
        <p class="about-text">
          MAPA Business &amp; Financial Services LLC was born from Marilyn Paladinez's direct experience
          with the migrant community in Newark, New Jersey. Seeing the difficulties Latino families faced
          in accessing financial, notarial, and document preparation services in Spanish, Marilyn created
          a company that provides close, professional guidance.
        </p>
        <p class="about-text">
          Since its founding, MAPA has served families, entrepreneurs, and small businesses who needed
          help with their paperwork in a language they understand, from someone who understands their reality.
        </p>
        <p class="about-text">
          Today, MAPA Business is a trusted resource in Newark and surrounding New Jersey areas,
          with a presence in 13 cities and a wide range of specialized services for the Latino community.
        </p>
      </div>

      <div class="about-block">
        <h2 class="about-section-title">Our <span>Mission</span></h2>
        <p class="about-text">
          Our mission is to guide Latino migrants, families, and entrepreneurs through the processes
          and services they need to establish themselves securely in the United States — always in Spanish
          and with respect for their journey and dreams.
        </p>

        <h2 class="about-section-title" style="margin-top:30px;">Our <span>Values</span></h2>
        <div class="values-list">
          <div class="value-item">
            <span class="value-icon">🤝</span>
            <div>
              <strong>Trust</strong>
              <p>We work with honesty and transparency, explaining every step of the process.</p>
            </div>
          </div>
          <div class="value-item">
            <span class="value-icon">🌎</span>
            <div>
              <strong>Community</strong>
              <p>We understand the migrant experience because we are part of that story.</p>
            </div>
          </div>
          <div class="value-item">
            <span class="value-icon">📋</span>
            <div>
              <strong>Responsibility</strong>
              <p>We don't promise what we can't deliver. We guide with real, verifiable information.</p>
            </div>
          </div>
          <div class="value-item">
            <span class="value-icon">💬</span>
            <div>
              <strong>Spanish-Language Service</strong>
              <p>Spanish is our primary language. No one should feel lost because of a language barrier.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDER & CREDENTIALS -->
  <section class="about-marilyn-section" style="padding: 60px 20px; background: rgba(255,255,255,0.01); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="display: flex; gap: 40px; align-items: flex-start; margin-bottom: 40px;" class="founder-flex">
        <img src="/marilin2.webp" alt="Marilyn Paladinez — Founder of MAPA Business" style="width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 3px solid var(--red); box-shadow: 0 10px 30px rgba(0,0,0,0.5);" />
        <div>
          <h2 style="font-family: Montserrat, sans-serif; font-size: 1.8rem; margin-bottom: 15px;">Founded and led by <span style="color: var(--red);">Marilyn Paladinez</span></h2>
          <p style="color: rgba(255,255,255,0.8); line-height: 1.75; font-size: 1.05rem; margin-bottom: 15px;">
            Marilyn Paladinez is the founder of MAPA Business &amp; Financial Services LLC. With over 10 years of field experience in the state of New Jersey, Marilyn has helped hundreds of families settle, protect their assets, and build solid credit histories.
          </p>
          <p style="color: rgba(255,255,255,0.8); line-height: 1.75; font-size: 1.05rem;">
            Her approach is 100% strategic and educational, translating complex legal and institutional procedures into step-by-step plans in your own language.
          </p>
        </div>
      </div>

      <div style="margin-top: 40px;">
        <h3 style="font-family: Montserrat, sans-serif; font-size: 1.3rem; margin-bottom: 20px; color: var(--white);">Credentials and Certifications</h3>
        <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
          <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); padding: 20px; border-radius: 8px;">
            <strong style="color: var(--red); display: block; font-size: 1.05rem; margin-bottom: 5px;">📜 Certified New Jersey Notary Public (Active Commission)</strong>
            <span style="color: rgba(255,255,255,0.7); line-height: 1.6; font-size: 0.95rem;">Authorized to notarize signatures, contracts, wills, powers of attorney, and affidavits statewide.</span>
          </div>
          <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); padding: 20px; border-radius: 8px;">
            <strong style="color: var(--red); display: block; font-size: 1.05rem; margin-bottom: 5px;">🔢 IRS Certified Acceptance Agent (CAA)</strong>
            <span style="color: rgba(255,255,255,0.7); line-height: 1.6; font-size: 0.95rem;">Authorized to verify passports and identification documents in person for ITIN processing (Form W-7), keeping your original documents safe in your possession.</span>
          </div>
          <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); padding: 20px; border-radius: 8px;">
            <strong style="color: var(--red); display: block; font-size: 1.05rem; margin-bottom: 5px;">📋 Document Preparation Specialist</strong>
            <span style="color: rgba(255,255,255,0.7); line-height: 1.6; font-size: 0.95rem;">Experienced in completing government tax forms (personal and business taxes), insurance applications, and employment authorization forms (I-765).</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact-info-section">
    <div class="contact-info-inner">
      <h2 class="section-title">Visit us or <span>contact us</span></h2>
      <div class="contact-info-box" style="max-width:560px; margin:30px auto 0;">
        <div class="contact-info-row">
          <strong>📍 Address</strong>
          <span>20 Bloomfield Pl, Newark, NJ 07104</span>
        </div>
        <div class="contact-info-row">
          <strong>📞 Phone</strong>
          <a href="tel:+18626228339">(862) 622-8339</a>
        </div>
        <div class="contact-info-row">
          <strong>💬 WhatsApp</strong>
          <a href="https://wa.me/18626228339" target="_blank" rel="noopener">(862) 622-8339</a>
        </div>
        <div class="contact-info-row">
          <strong>🕐 Hours</strong>
          <span>Mon–Fri 9am–6pm · Sat 9am–2pm</span>
        </div>
        <div class="contact-info-row">
          <strong>🌐 Website</strong>
          <a href="https://marilynmapabusiness.com">marilynmapabusiness.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <h2>Frequently asked questions about <span>MAPA Business</span></h2>
    <dl>
      <div class="faq-item">
        <dt>What is MAPA Business &amp; Financial Services LLC?</dt>
        <dd>A company founded by Marilyn Paladinez in Newark, New Jersey, that provides Spanish-language guidance to Latino migrant families, entrepreneurs, and small businesses in notarial, financial, and document preparation services.</dd>
      </div>
      <div class="faq-item">
        <dt>Where is MAPA Business located?</dt>
        <dd>We are at 20 Bloomfield Pl, Newark, NJ 07104. We also serve clients remotely throughout New Jersey.</dd>
      </div>
      <div class="faq-item">
        <dt>Is MAPA Business a law firm?</dt>
        <dd>No. MAPA Business & Financial Services LLC is not a law firm. Marilyn Paladinez is a certified Notary Public in New Jersey and provides guidance and document preparation. We do not offer legal representation or legal advice.</dd>
      </div>
      <div class="faq-item">
        <dt>What are your business hours?</dt>
        <dd>We are open Monday through Friday from 9am to 6pm, and Saturdays from 9am to 2pm. You can also reach us via WhatsApp at (862) 622-8339.</dd>
      </div>
    </dl>
  </section>

</BaseLayout>

<style>
.about-hero { padding: 90px 40px 60px; text-align: center; background: linear-gradient(135deg, #0a0a0a 0%, #110000 100%); }
.about-hero-inner { max-width: 820px; margin: 0 auto; }
.about-hero h1 { font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-bottom: 20px; }
.about-hero h1 span:nth-child(2) { color: var(--red); }
.about-content { max-width: 1100px; margin: 0 auto; padding: 60px 40px; }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
.about-section-title { font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.4rem; margin-bottom: 20px; }
.about-section-title span { color: var(--red); }
.about-text { color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.8; margin-bottom: 16px; }
.values-list { display: flex; flex-direction: column; gap: 16px; }
.value-item { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; }
.value-icon { font-size: 1.4rem; flex-shrink: 0; line-height: 1.3; }
.value-item strong { display: block; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
.value-item p { color: rgba(255,255,255,0.55); font-size: 0.85rem; margin: 0; line-height: 1.55; }
.about-marilyn-cta { padding: 60px 40px; border-top: 1px solid rgba(204,0,0,0.12); }
.about-marilyn-inner { max-width: 760px; margin: 0 auto; display: flex; align-items: flex-start; gap: 28px; }
.about-marilyn-img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--red); flex-shrink: 0; }
.about-marilyn-inner h2 { font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.4rem; margin-bottom: 12px; }
.about-marilyn-inner h2 span { color: var(--red); }
.about-marilyn-inner p { color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.7; }
.contact-info-section { padding: 40px 40px 60px; text-align: center; }
.contact-info-inner { max-width: 1100px; margin: 0 auto; }
@media (max-width: 768px) {
  .about-hero { padding: 80px 20px 50px; }
  .about-content { padding: 50px 20px; }
  .about-grid { grid-template-columns: 1fr; gap: 40px; }
  .about-marilyn-cta { padding: 40px 20px; }
  .about-marilyn-inner { flex-direction: column; gap: 16px; }
  .contact-info-section { padding: 30px 20px 50px; }
}
</style>
