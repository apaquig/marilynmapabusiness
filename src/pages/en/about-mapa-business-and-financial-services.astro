---
// src/pages/en/about-mapa-business-and-financial-services.astro
import BaseLayout from "../../layouts/BaseLayout.astro";

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = `${WEBSITE}/en/about-mapa-business-and-financial-services/`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${WEBSITE}/en/about-mapa-business-and-financial-services/#webpage`,
      url: canonical,
      name: "About MAPA Business & Financial Services LLC | Marilyn Paladinez",
      isPartOf: { "@id": `${WEBSITE}/#website` },
      about: { "@id": `${WEBSITE}/#organization` },
      inLanguage: "en",
    },
    {
      "@type": "FinancialService",
      "@id": `${WEBSITE}/#organization`,
      name: "MAPA Business & Financial Services LLC",
      url: WEBSITE,
      telephone: "+18626228339",
      foundingDate: "2014",
      address: {
        "@type": "PostalAddress",
        streetAddress: "20 Bloomfield Pl",
        addressLocality: "Newark",
        addressRegion: "NJ",
        postalCode: "07104",
        addressCountry: "US",
      },
      founder: { "@id": `${WEBSITE}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${WEBSITE}/#person`,
      name: "Marilyn Paladinez",
      jobTitle: "Founder & Financial Strategist for Migrants",
      worksFor: { "@id": `${WEBSITE}/#organization` },
      url: `${WEBSITE}/en/marilyn-paladinez/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is MAPA Business & Financial Services LLC?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "MAPA Business & Financial Services LLC is a company founded by Marilyn Paladinez in Newark, New Jersey, that supports the migrant and Latino community with 14 notary, financial, tax, administrative, and document preparation services.",
          },
        },
        {
          "@type": "Question",
          name: "Do consultations at MAPA Business cost anything?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. All initial consultations at MAPA Business & Financial Services LLC are 100% free. We listen to your situation, explain your options, and you decide freely without obligation.",
          },
        },
        {
          "@type": "Question",
          name: "Where is MAPA Business located?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "We are located at 20 Bloomfield Pl, Newark, NJ 07104. We also serve clients digitally across New Jersey.",
          },
        },
        {
          "@type": "Question",
          name: "Does MAPA Business offer bilingual support?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. We offer 100% bilingual support in Spanish and English so you can understand every step of your procedure without language barriers.",
          },
        },
        {
          "@type": "Question",
          name: "Is MAPA Business a law firm?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. MAPA Business & Financial Services LLC is not a law firm. Marilyn Paladinez is a Certified Public Notary in NJ and IRS Certified Acceptance Agent. We provide guidance and document preparation, but not legal representation.",
          },
        },
      ],
    },
  ],
};

const services = [
  {
    icon: "📜",
    name: "Notary Public",
    tag: "NJ Certified",
    desc: "Notarization of signatures and documents for personal, commercial, or administrative procedures in New Jersey quickly and smoothly.",
    href: "/en/services/notary/",
  },
  {
    icon: "🌐",
    name: "Certified Translations",
    tag: "Official & Accepted",
    desc: "Certified translations from Spanish to English and English to Spanish for government agencies, schools, courts, and official institutions.",
    href: "/en/services/translations/",
  },
  {
    icon: "✍️",
    name: "Powers of Attorney",
    tag: "Personal & Commercial",
    desc: "Drafting and notarization of powers of attorney for personal, banking, and international needs in your home country.",
    href: "/en/services/powers-of-attorney/",
  },
  {
    icon: "💼",
    name: "Work Permits",
    tag: "Form I-765",
    desc: "Preparation and documentary organization for initial applications and renewals of work authorization (Form I-765) with USCIS.",
    href: "/en/services/work-permits/",
  },
  {
    icon: "🪪",
    name: "NJ Driver's Licenses",
    tag: "MVC Appointment Guide",
    desc: "Step-by-step guidance and document review before your appointment at the New Jersey Motor Vehicle Commission.",
    href: "/en/services/drivers-licenses/",
  },
  {
    icon: "🔢",
    name: "ITIN Number",
    tag: "IRS Acceptance Agent",
    desc: "Form W-7 application and renewal assistance as IRS Certified Acceptance Agents. We validate passports in-person without mailing them out.",
    href: "/en/services/itin/",
  },
  {
    icon: "🧾",
    name: "Taxes & Tax Returns",
    tag: "Individual & Business",
    desc: "Preparation of federal and state tax returns for individuals, families, and small businesses with accuracy and care.",
    href: "/en/services/taxes/",
  },
  {
    icon: "📊",
    name: "Bookkeeping & Accounting",
    tag: "Monthly Accounting",
    desc: "Financial organization, income/expense tracking, bank reconciliations, and reporting so you understand your business numbers.",
    href: "/en/services/bookkeeping/",
  },
  {
    icon: "🚗",
    name: "Auto Insurance",
    tag: "Multiple Quotes",
    desc: "We quote auto insurance policies in New Jersey to find the right coverage. Options for foreign license holders and ITIN holders.",
    href: "/en/services/auto-insurance/",
  },
  {
    icon: "🏥",
    name: "Health Insurance",
    tag: "Individual & Family",
    desc: "Expert guidance to explore individual and family health coverage options in New Jersey tailored to your budget and needs.",
    href: "/en/services/health-insurance/",
  },
  {
    icon: "💛",
    name: "Life Insurance",
    tag: "Family Protection",
    desc: "Simple, transparent advice on life insurance plans to protect the financial future and wellbeing of your loved ones.",
    href: "/en/services/life-insurance/",
  },
  {
    icon: "🌍",
    name: "Dual Citizenship",
    tag: "Consular Procedures",
    desc: "Documentary assistance and administrative preparation for dual citizenship procedures before relevant consulates.",
    href: "/en/services/dual-citizenship/",
  },
  {
    icon: "⚖️",
    name: "Uncontested Divorces",
    tag: "Mutual Consent",
    desc: "Administrative support and document preparation for mutual agreement divorces in an organized, straightforward manner.",
    href: "/en/services/divorces/",
  },
  {
    icon: "💍",
    name: "Civil Marriages",
    tag: "Records & Filings",
    desc: "Guidance and document preparation for civil marriages and administrative registration requirements.",
    href: "/en/services/marriages/",
  },
];

const citiesList = [
  "Newark", "Elizabeth", "Jersey City", "Paterson", "Passaic", "Clifton",
  "Union City", "West New York", "East Orange", "Plainfield", "Perth Amboy",
  "Trenton", "Camden"
];
---

<BaseLayout
  lang="en"
  title="About MAPA Business & Financial Services LLC | Marilyn Paladinez"
  description="Discover the story of Marilyn Paladinez and MAPA Business & Financial Services LLC in Newark, NJ. 14 notary, tax, and document services with 100% free initial consultations."
  canonical={canonical}
  currentPath="/en/about-mapa-business-and-financial-services/"
  schema={schema}
>
  <!-- MAIN STORY SECTION -->
  <section id="nosotros" class="sobre-main-section">
    <div class="section-inner">
      <div class="about-grid">
        
        <!-- MARILYN PHOTO -->
        <div class="about-img-wrap">
          <img src="/marilin2.webp" alt="Marilyn Paladinez — Founder of MAPA Business" />
          <div class="about-card">
            <span class="num">10+</span>
            <span class="label">Years Experience</span>
          </div>
        </div>

        <!-- MARILYN STORY CONTENT -->
        <div class="about-text">
          <div class="section-tag">OUR FOUNDATION</div>
          <h2 class="section-title">My story and the birth of <span>MAPA Business &amp; Financial Services LLC</span></h2>
          
          <p class="story-lead">
            My name is <strong>Marilyn Paladinez</strong> and I am the founder of <strong>MAPA Business &amp; Financial Services LLC</strong>, a company located in Newark, New Jersey, created to support the Latino and immigrant community with financial, business, notary, administrative, and document preparation services.
          </p>

          <p class="story-text">
            My story with MAPA began after working closely with our community and personally experiencing the challenges families, migrants, and small business owners face when completing essential paperwork in the United States.
          </p>

          <p class="story-text">
            I frequently met people who didn't know where to start, what documents they needed, or how to navigate complex processes. Language barriers made an already complicated situation even more overwhelming and stressful.
          </p>

          <p class="story-text">
            I met entrepreneurs with great ideas who didn't know how to register their business or manage bookkeeping; individuals applying for an ITIN or insurance who feared being misled; and entire families looking for a trusted advocate to listen to their situation and explain clearly what their next steps should be.
          </p>

          <div class="story-highlight-box">
            <p>
              That reality inspired me to create <strong>MAPA Business &amp; Financial Services LLC</strong>: a single place where the community finds 14 comprehensive services and close, personalized support in <strong>both Spanish and English</strong>.
            </p>
          </div>
        </div>

      </div>

      <!-- QUOTE CARD -->
      <div class="quote-card-block">
        <blockquote>
          “To me, offering a service means much more than just filling out forms. It means listening first, understanding each person's needs, and explaining the process clearly so they can make informed decisions with confidence.”
        </blockquote>
        <cite>— Marilyn Paladinez, Founder of MAPA Business &amp; Financial Services LLC</cite>
      </div>
    </div>
  </section>

  <!-- 100% FREE CONSULTATIONS BANNER -->
  <section class="free-consultation-section">
    <div class="section-inner">
      <div class="free-box">
        <span class="section-tag gold-tag">TRANSPARENT GUARANTEE</span>
        <h2 class="section-title">Consultations at MAPA are <span>completely free</span></h2>
        <p class="free-desc">
          I want no one to hesitate to reach out thinking that speaking with us will cost them money. Our philosophy is simple, honest, and transparent:
        </p>

        <div class="process-steps">
          <div class="step">
            <div class="step-num">1</div>
            <h3>First We Listen</h3>
            <p>You tell us about your case, goals, or questions with zero pressure and zero cost.</p>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <h3>Then We Explain</h3>
            <p>We explain clearly what options you have, requirements, and what your next steps look like.</p>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <h3>Then You Decide</h3>
            <p>You freely decide whether you wish to move forward with us without obligation.</p>
          </div>
        </div>

        <div class="cta-wrap">
          <a href="https://wa.me/18626228339?text=Hello%20Marilyn,%20I%20would%20like%20a%20free%20consultation." target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
            💬 Request Free Consultation on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 14 SERVICES GRID -->
  <section id="servicios">
    <div class="section-inner">
      <div class="section-tag">FULL CATALOG</div>
      <h2 class="section-title">Our 14 Main <span>Services</span></h2>
      <p class="section-desc">
        At MAPA Business &amp; Financial Services LLC we provide assistance and document preparation across 14 essential areas:
      </p>

      <div class="services-grid">
        {services.map(s => (
          <div class="service-card">
            <span class="service-icon">{s.icon}</span>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
            <a href={s.href} class="service-link">View service details →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO WE HELP & CREDENTIALS -->
  <section class="pillars-credentials-section">
    <div class="section-inner">
      <div class="about-grid">
        
        <!-- PILLARS -->
        <div>
          <div class="section-tag">OUR COMMUNITY</div>
          <h2 class="section-title">Supporting <span>Families, Migrants, and Entrepreneurs</span></h2>
          
          <div class="pillar-list">
            <div class="pillar-item">
              <span class="p-emoji">👨‍👩‍👧‍👦</span>
              <div>
                <h4>Families</h4>
                <p>Notarizations, certified translations, powers of attorney, and auto, health, and life insurance policies to safeguard family wellbeing.</p>
              </div>
            </div>

            <div class="pillar-item">
              <span class="p-emoji">🛂</span>
              <div>
                <h4>Migrants</h4>
                <p>ITIN number applications (Form W-7), work permits (Form I-765), NJ driver's licenses, and consular registrations.</p>
              </div>
            </div>

            <div class="pillar-item">
              <span class="p-emoji">💼</span>
              <div>
                <h4>Entrepreneurs &amp; Small Businesses</h4>
                <p>Monthly bookkeeping, organized accounting, and personal and corporate tax return preparation (Taxes).</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CREDENTIALS -->
        <div>
          <div class="cred-card-box">
            <div class="section-tag gold-tag">ACREDITATIONS</div>
            <h3 class="cred-title">Marilyn Paladinez's Official Credentials</h3>

            <div class="cred-item">
              <span class="c-icon">📜</span>
              <div>
                <strong>Certified Public Notary of New Jersey</strong>
                <p>Active commission authorized to notarize signatures, documents, powers of attorney, and legal contracts statewide.</p>
              </div>
            </div>

            <div class="cred-item">
              <span class="c-icon">🔢</span>
              <div>
                <strong>IRS Certified Acceptance Agent (CAA)</strong>
                <p>Authorized to validate original passports and IDs in-person for ITIN applications without mailing them out.</p>
              </div>
            </div>

            <div class="cred-item">
              <span class="c-icon">📋</span>
              <div>
                <strong>Document Preparation Specialist</strong>
                <p>Years of experience preparing government tax filings, employment authorization (I-765) forms, and insurance quotes.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- COVERAGE & CONTACT -->
  <section class="coverage-section">
    <div class="section-inner text-center">
      <div class="section-tag">LOCAL PRESENCE</div>
      <h2 class="section-title">Serving <span>Newark and All of New Jersey</span></h2>
      <p class="coverage-desc">
        Our main office is located in <strong>Newark, NJ</strong>, and we serve clients across 13 primary municipalities:
      </p>

      <div class="city-pills-wrap">
        {citiesList.map(c => (
          <span class="city-pill">📍 {c}</span>
        ))}
      </div>

      <div class="contact-info-grid">
        <div class="c-info-item">
          <strong>📍 Office Address</strong>
          <p>20 Bloomfield Pl, Newark, NJ 07104</p>
        </div>
        <div class="c-info-item">
          <strong>📞 Direct Phone</strong>
          <p><a href="tel:+18626228339">(862) 622-8339</a></p>
        </div>
        <div class="c-info-item">
          <strong>💬 WhatsApp Support</strong>
          <p><a href="https://wa.me/18626228339" target="_blank" rel="noopener">(862) 622-8339</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-inner" style="max-width: 900px;">
      <div class="text-center">
        <div class="section-tag">CLEAR ANSWERS</div>
        <h2 class="section-title">Frequently Asked Questions about <span>MAPA Business</span></h2>
      </div>

      <div class="faq-accordion-list">
        <div class="faq-box">
          <h4>What is MAPA Business &amp; Financial Services LLC?</h4>
          <p>It is a company created by Marilyn Paladinez in Newark, New Jersey, dedicated to advising and preparing documents across 14 notary, tax, ITIN, insurance, work permit, and business service areas.</p>
        </div>
        <div class="faq-box">
          <h4>Do consultations cost anything?</h4>
          <p>No. All our initial consultations are 100% free. We listen to your case without obligation, explain the process, and you freely decide whether you wish to proceed.</p>
        </div>
        <div class="faq-box">
          <h4>Is MAPA Business a law firm?</h4>
          <p>No. MAPA Business is not a law firm. Marilyn Paladinez is a Certified Public Notary in NJ and IRS Certified Acceptance Agent specializing in document preparation and administrative guidance.</p>
        </div>
        <div class="faq-box">
          <h4>Can I consult over WhatsApp or phone?</h4>
          <p>Yes. We welcome clients in-person at our Newark, NJ office and also provide support by phone and WhatsApp at (862) 622-8339.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     CLEAN STYLES WITHOUT TOP HERO HEADER
     ========================================================================== */

  .sobre-main-section {
    padding-top: 110px !important; /* Space to clear fixed top navbar */
    background: #0f0f0f;
  }

  /* STORY TEXT */
  .story-lead {
    font-size: 1.12rem !important;
    line-height: 1.8 !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    margin-bottom: 16px !important;
  }
  .story-text {
    font-size: 1rem !important;
    line-height: 1.75 !important;
    color: rgba(255, 255, 255, 0.75) !important;
    margin-bottom: 16px !important;
  }
  .story-highlight-box {
    background: rgba(204, 0, 0, 0.1);
    border-left: 4px solid var(--red, #cc0000);
    padding: 20px 24px;
    border-radius: 0 8px 8px 0;
    margin-top: 24px;
  }
  .story-highlight-box p {
    margin: 0 !important;
    color: #ffffff !important;
    font-size: 1.02rem !important;
    line-height: 1.7 !important;
  }

  /* QUOTE CARD */
  .quote-card-block {
    background: #141414;
    border: 1px solid rgba(204, 0, 0, 0.3);
    border-left: 4px solid var(--red, #cc0000);
    border-radius: 10px;
    padding: 32px 30px;
    margin-top: 45px;
    text-align: left;
  }
  .quote-card-block blockquote {
    font-size: 1.12rem !important;
    line-height: 1.8 !important;
    color: #ffffff !important;
    font-style: italic !important;
    margin-bottom: 12px !important;
  }
  .quote-card-block cite {
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    color: var(--red, #cc0000) !important;
    font-style: normal !important;
    display: block;
  }

  /* FREE CONSULTATIONS BANNER */
  .free-consultation-section {
    background: #0a0a0a;
    padding: 70px 20px;
  }
  .free-box {
    background: linear-gradient(135deg, #1b0000 0%, #100000 100%);
    border: 2px solid var(--red, #cc0000);
    border-radius: 16px;
    padding: 50px 30px;
    text-align: center;
  }
  .gold-tag {
    background: rgba(212, 175, 55, 0.15) !important;
    border-color: rgba(212, 175, 55, 0.4) !important;
    color: #ffd700 !important;
  }
  .free-desc {
    font-size: 1.08rem !important;
    color: rgba(255, 255, 255, 0.85) !important;
    max-width: 760px;
    margin: 0 auto 40px !important;
    line-height: 1.7 !important;
  }
  .cta-wrap { margin-top: 40px; }
  .btn-lg {
    font-size: 1.05rem !important;
    padding: 16px 36px !important;
    border-radius: 30px !important;
  }

  /* PILLARS & CREDENTIALS */
  .pillars-credentials-section {
    background: #0f0f0f;
    padding: 80px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .pillar-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 30px;
  }
  .pillar-item {
    display: flex;
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 20px;
    border-radius: 8px;
  }
  .p-emoji { font-size: 2rem; flex-shrink: 0; }
  .pillar-item h4 {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .pillar-item p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.6;
  }

  .cred-card-box {
    background: #141414;
    border: 2px solid #d4af37;
    border-radius: 12px;
    padding: 30px 24px;
  }
  .cred-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    color: #ffffff;
    margin: 12px 0 24px;
  }
  .cred-item {
    display: flex;
    gap: 14px;
    margin-bottom: 20px;
  }
  .cred-item:last-child { margin-bottom: 0; }
  .c-icon { font-size: 1.8rem; flex-shrink: 0; }
  .cred-item strong {
    display: block;
    font-size: 0.98rem;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .cred-item p {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.55;
  }

  /* COVERAGE & CONTACT */
  .coverage-section {
    padding: 80px 20px;
    background: #0a0a0a;
  }
  .coverage-desc {
    font-size: 1.05rem !important;
    color: rgba(255, 255, 255, 0.75) !important;
    max-width: 760px;
    margin: 0 auto 30px !important;
  }
  .city-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 40px;
  }
  .city-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 0.9rem;
    color: #ffffff;
    font-weight: 700;
  }

  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 24px;
    border-radius: 12px;
    text-align: left;
  }
  .c-info-item strong {
    display: block;
    font-size: 0.85rem;
    color: var(--red, #cc0000);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .c-info-item p, .c-info-item a {
    font-size: 0.98rem;
    color: #ffffff !important;
    margin: 0;
  }

  /* FAQ */
  .faq-section {
    padding: 80px 20px;
    background: #0f0f0f;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 40px;
  }
  .faq-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 24px;
    border-radius: 8px;
  }
  .faq-box h4 {
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 800 !important;
    font-size: 1.1rem !important;
    color: #ffffff !important;
    margin-bottom: 8px !important;
  }
  .faq-box p {
    font-size: 0.95rem !important;
    color: rgba(255, 255, 255, 0.7) !important;
    margin: 0 !important;
    line-height: 1.65 !important;
  }
</style>
