---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import Actions from '../../../components/lp/Actions.astro';
import { BRAND } from '../../../components/lp/config';
---
<LandingLayout title={`Gracias por su solicitud | ${BRAND}`} description="Recibimos su solicitud. El equipo de MAPA le llamará en horario de oficina." path="/lp/notary-newark/gracias" thankYou>
  <section class="thanks"><div class="check" aria-hidden="true">✓</div><p class="eyebrow">SOLICITUD RECIBIDA</p><h1>¡Gracias! Recibimos su solicitud.</h1><div class="response"><span class="response-icon" aria-hidden="true">◷</span><div><strong>Nos comunicaremos contigo pronto.</strong><span>Horario de atención: lunes a sábado, de 9 a. m. a 6 p. m.</span></div></div><p class="brand">{BRAND}</p><Actions location="gracias" /></section>
</LandingLayout>
<style>.thanks{max-width:760px;margin:0 auto;padding:72px 24px 88px;text-align:center;min-height:60vh}.check{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:#f5f5f5;color:#cc0000;font-size:32px;margin:0 auto 24px}.eyebrow{font-size:12px;font-weight:700;color:#cc0000;letter-spacing:.12em}h1{font-size:clamp(30px,5vw,46px);margin:12px 0 20px}.thanks>p{color:#555}.response{display:flex;align-items:center;gap:14px;max-width:570px;margin:28px auto;padding:18px 20px;border:1px solid #eadede;border-left:4px solid #cc0000;border-radius:12px;background:#fff;text-align:left;box-shadow:0 8px 24px rgba(25,25,25,.06)}.response-icon{flex:0 0 42px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#fff0f0;color:#cc0000;font-size:24px}.response div{display:grid;gap:4px}.response strong{color:#161616;font-size:17px;line-height:1.25}.response div span{color:#5a5a5a;font-size:14px;line-height:1.45}.brand{font-size:13px;margin:24px 0}.thanks :global(.actions){justify-content:center}@media(max-width:520px){.thanks{padding:52px 18px 72px}.response{align-items:flex-start;padding:16px}.response strong{font-size:16px}.response div span{font-size:13px}}</style>
