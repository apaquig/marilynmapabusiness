---
import { Image } from 'astro:assets';
import logo from '../../../public/logo-mapa.png';
import heroImage from '../../../public/images/lp/marketing-construccion-hero.png';
import ContactForm from '../../components/ContactForm.astro';

const phone = 'tel:+18626228339';
const whatsapp = `https://wa.me/18626228339?text=${encodeURIComponent('Hola, quiero información sobre marketing para mi negocio de construcción.')}`;
const path = '/lp/marketing-construccion';
const title = 'Marketing para empresas de construcción | MAPA Business';
const description = 'Consigue más solicitudes de cotización para tu empresa de construcción con una estrategia clara de presencia digital, anuncios y seguimiento de prospectos.';

const services = [
  { number: '01', title: 'Presencia que inspira confianza', text: 'Una página profesional que muestra tus servicios, zonas de trabajo y una forma clara de pedir cotización.' },
  { number: '02', title: 'Campañas para generar prospectos', text: 'Anuncios enfocados en personas que buscan remodelación, roofing, pintura, pisos y otros servicios de construcción.' },
  { number: '03', title: 'Seguimiento de cada oportunidad', text: 'Organizamos el proceso de contacto para que puedas responder rápido y dar seguimiento a cada solicitud.' },
  { number: '04', title: 'Reputación local', text: 'Mejoramos cómo se presenta tu negocio en Google y ayudamos a convertir tu experiencia en confianza visible.' },
];

const faqs = [
  ['¿Esto funciona para contratistas pequeños?', 'Sí. La estrategia se adapta a tu capacidad, tus servicios y las zonas donde realmente puedes aceptar proyectos.'],
  ['¿Necesito tener una página web?', 'No. Podemos comenzar revisando lo que ya tienes y definir si necesitas una página nueva, una landing page o mejoras puntuales.'],
  ['¿Trabajan con un solo tipo de construcción?', 'La estrategia puede adaptarse a remodelación, roofing, pintura, pisos, concreto, electricidad, plomería y otros servicios del sector.'],
  ['¿Cuánto debo invertir en publicidad?', 'Depende de tu servicio, zona y objetivo. Primero definimos un plan y un presupuesto realista antes de lanzar campañas.'],
  ['¿Cuándo puedo esperar resultados?', 'El tiempo varía según la demanda, la competencia, la oferta y el presupuesto. Nuestro enfoque es medir solicitudes reales y mejorar continuamente; no prometemos resultados específicos.'],
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://marilynmapabusiness.com${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://marilynmapabusiness.com/images/lp/marketing-construccion-hero.png" />
    <link rel="icon" href="/logo-mapa.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" aria-label="MAPA Business, inicio"><Image src={logo} width={177} height={50} format="webp" alt="MAPA Business & Financial Services" loading="eager" /></a>
        <div class="header-actions">
          <span>Marketing para contratistas</span>
          <a class="button button-small" href="#consulta"><span class="desktop-label">Solicitar evaluación</span><span class="mobile-label">Evaluación</span></a>
        </div>
      </div>
    </header>

    <main id="contenido">
      <section class="hero">
        <Image class="hero-photo" src={heroImage} width={1536} height={1024} widths={[640, 960, 1280, 1536]} sizes="100vw" format="webp" alt="Contratista revisando planos frente a un proyecto de construcción" loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="blueprint-grid" aria-hidden="true"></div>
        <div class="shell hero-content">
          <div class="hero-copy">
            <p class="kicker"><span></span> MARKETING PARA CONSTRUCCIÓN</p>
            <h1>Más que visibilidad.<br /><em>Más proyectos.</em></h1>
            <p class="hero-lead">Ayudamos a contratistas y empresas de construcción a convertir su experiencia en solicitudes de cotización con una estrategia digital clara.</p>
            <div class="hero-actions">
              <a class="button" href="#consulta">Quiero más proyectos <span aria-hidden="true">→</span></a>
              <a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp ↗</a>
            </div>
            <ul class="hero-proof" aria-label="Beneficios principales">
              <li><strong>01</strong><span>Presencia<br />profesional</span></li>
              <li><strong>02</strong><span>Prospectos<br />locales</span></li>
              <li><strong>03</strong><span>Seguimiento<br />organizado</span></li>
            </ul>
          </div>
        </div>
        <div class="hero-tag">NEW JERSEY · ESPAÑOL / ENGLISH</div>
      </section>

      <section class="problem section">
        <div class="shell problem-grid">
          <div>
            <p class="section-label">EL PROBLEMA</p>
            <h2>Tu trabajo habla bien de ti.<br />Tu marketing también debería.</h2>
          </div>
          <div class="problem-copy">
            <p class="large">Muchos buenos contratistas dependen únicamente del referido. Cuando el teléfono deja de sonar, no existe un sistema que genere la próxima oportunidad.</p>
            <p>Construimos una presencia digital diseñada para que clientes potenciales entiendan qué haces, confíen en tu empresa y den el siguiente paso.</p>
            <a href="#solucion">Ver cómo lo hacemos ↓</a>
          </div>
        </div>
      </section>

      <section class="services section" id="solucion">
        <div class="shell">
          <div class="section-heading">
            <div><p class="section-label light">EL SISTEMA</p><h2>De la búsqueda<br />a la cotización.</h2></div>
            <p>Una estrategia conectada para atraer atención, generar confianza y convertirla en conversaciones reales.</p>
          </div>
          <div class="service-grid">
            {services.map((service) => (
              <article class="service-card">
                <span>{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="trade-section section">
        <div class="shell trade-grid">
          <div class="trade-intro">
            <p class="section-label">HECHO PARA TU INDUSTRIA</p>
            <h2>Marketing que entiende el trabajo.</h2>
            <p>No necesitas “likes”. Necesitas que las personas correctas vean tu trabajo, confíen en tu experiencia y pidan una cotización.</p>
          </div>
          <div class="trade-list" role="list">
            {['Remodelación', 'Roofing', 'Pintura', 'Pisos', 'Concreto', 'Plomería y electricidad'].map((trade, index) => (
              <div role="listitem"><span>{String(index + 1).padStart(2, '0')}</span><strong>{trade}</strong><span aria-hidden="true">↗</span></div>
            ))}
          </div>
        </div>
      </section>

      <section class="process section">
        <div class="shell">
          <p class="section-label">UN PLAN CLARO</p>
          <h2>Primero entendemos tu negocio.<br />Después construimos la estrategia.</h2>
          <ol class="process-grid">
            <li><span>01</span><h3>Evaluamos</h3><p>Revisamos tus servicios, zonas, presencia actual y capacidad para atender nuevos proyectos.</p></li>
            <li><span>02</span><h3>Construimos</h3><p>Definimos el mensaje, la oferta, la página y los canales adecuados para tu negocio.</p></li>
            <li><span>03</span><h3>Lanzamos</h3><p>Activamos la estrategia y dejamos listo un camino simple para solicitar cotización.</p></li>
            <li><span>04</span><h3>Optimizamos</h3><p>Medimos la calidad de las oportunidades y ajustamos para mejorar el proceso.</p></li>
          </ol>
        </div>
      </section>

      <section class="contact-section" id="consulta">
        <div class="shell contact-grid">
          <div class="contact-copy">
            <p class="section-label light">HABLEMOS DE TU NEGOCIO</p>
            <h2>La próxima oportunidad puede empezar aquí.</h2>
            <p>Cuéntanos qué tipo de proyectos quieres conseguir y en qué zonas trabajas. Revisaremos tu caso para recomendarte el próximo paso.</p>
            <div class="contact-direct">
              <span>¿Prefieres hablar directamente?</span>
              <a href={phone}>(862) 622-8339</a>
              <a href={whatsapp} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp ↗</a>
            </div>
          </div>
          <div class="form-card">
            <p class="form-overline">EVALUACIÓN INICIAL</p>
            <h3>Solicita información</h3>
            <p>Completa tus datos. Te responderemos en horario de oficina.</p>
            <ContactForm lang="es" compact fixedService={{ label: 'Marketing para construcción', value: 'Marketing para construcción' }} />
          </div>
        </div>
      </section>

      <section class="faq section">
        <div class="shell faq-grid">
          <div><p class="section-label">ANTES DE COMENZAR</p><h2>Preguntas frecuentes.</h2></div>
          <div>
            {faqs.map(([question, answer]) => (
              <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>
            ))}
          </div>
        </div>
      </section>

      <section class="final-cta">
        <div class="shell">
          <p>TU EXPERIENCIA YA ESTÁ CONSTRUIDA.</p>
          <h2>Ahora hagamos que más clientes la encuentren.</h2>
          <a class="button button-light" href="#consulta">Solicitar evaluación <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-grid">
        <Image src={logo} width={177} height={50} format="webp" alt="MAPA Business & Financial Services" loading="lazy" />
        <div><strong>MAPA Business &amp; Financial Services LLC</strong><p>20 Bloomfield Pl, Newark, NJ 07104</p></div>
        <div><a href={phone}>(862) 622-8339</a><a href="/es/privacy-policy/">Política de privacidad</a></div>
      </div>
    </footer>

    <div class="mobile-bar"><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="#consulta">Solicitar evaluación</a></div>
    <script src="/js/script.js" is:inline></script>
    <script src="/js/ghl-form-confirmation.js" is:inline></script>
    <script src="https://link.msgsndr.com/js/external-tracking.js" data-tracking-id="tk_92b14bc678ea4eb3b89a2a27dca3f16f" is:inline></script>
  </body>
</html>

<style is:global>
