x}.form-card .form-overline{color:var(--orange);font-size:11px;font-weight:700;letter-spacing:.16em;margin-bottom:10px}.form-card>h3{font-size:42px;margin:0 0 10px}.form-card>p{font-size:14px;color:#555}.form-card .contact-panel{box-shadow:none;border:0;border-radius:0;background:transparent}.form-card .contact-panel .contact-form{padding:8px 0 0;background:transparent}.form-card .contact-panel label{color:#303335}.form-card .contact-panel input:not([type=checkbox]):not([type=hidden]),.form-card .contact-panel textarea{border-radius:0!important;background:white}.form-card .contact-panel button[type=submit]{border-radius:0;background:var(--orange);min-height:54px;text-transform:uppercase;letter-spacing:.05em}.form-card .fixed-service{display:none}.faq-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:100px}.faq details{border-bottom:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:78px;font-weight:700}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--orange);font-size:24px}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{color:#555;margin:0;padding:0 40px 24px 0}.final-cta{background:var(--orange);color:white;text-align:center;padding:90px 24px}.final-cta p{font-size:11px;font-weight:700;letter-spacing:.18em}.final-cta h2{font-size:clamp(50px,6vw,84px);max-width:850px;margin:0 auto 32px}.button-light{background:white;color:var(--ink)}.button-light:hover{background:#f2eee7}footer{background:#0d0e0f;color:white;padding:42px 0}.footer-grid{display:grid;grid-template-columns:180px 1fr auto;gap:50px;align-items:center}.footer-grid img{filter:brightness(0) invert(1);object-fit:contain}.footer-grid p{color:#999;margin:4px 0 0;font-size:13px}.footer-grid>div:last-child{display:grid;gap:6px;text-align:right;font-size:13px}.mobile-bar{display:none}@media(max-width:900px){.service-grid{grid-template-columns:repeat(2,1fr)}.service-card:nth-child(3){border-left:1px solid #ffffff35}.problem-grid,.trade-grid,.contact-grid,.faq-grid{gap:50px}.process-grid{grid-template-columns:repeat(2,1fr)}.contact-grid{grid-template-columns:1fr 1.15fr}.form-card{padding:30px}}@media(max-width:700px){body{padding-bottom:70px}.shell{width:min(100% - 32px,1180px)}.site-header{height:68px}.header-actions>span{display:none}.header-inner img{width:110px}.button-small{font-size:10px;min-height:40px;padding:8px 12px}.hero{min-height:720px;align-items:flex-end}.hero-photo{object-position:64% center}.hero-shade{background:linear-gradient(0deg,rgba(11,13,14,.98) 0%,rgba(11,13,14,.83) 53%,rgba(11,13,14,.2) 100%)}.blueprint-grid{inset:45% 0 0}.hero-content{padding-block:190px 46px}.kicker{margin-bottom:14px}h1{font-size:58px;margin-bottom:18px}.hero-lead{font-size:16px;margin-bottom:24px}.hero-actions{align-items:stretch;flex-direction:column;gap:14px}.hero-actions .button{width:100%}.text-link{text-align:center}.hero-proof{margin-top:28px;padding-top:20px}.hero-proof li{padding-inline:10px;display:block}.hero-proof strong{font-size:24px;display:block}.hero-proof span{font-size:9px}.hero-tag{display:none}.section{padding-block:72px}.problem-grid,.trade-grid,.contact-grid,.faq-grid,.section-heading{grid-template-columns:1fr;gap:34px}.problem-copy{padding-top:0}.section h2{font-size:47px}.section-heading{margin-bottom:42px}.service-grid{grid-template-columns:1fr}.service-card,.service-card:nth-child(3){min-height:230px;border-left:1px solid #ffffff35}.service-card h3{margin-top:58px}.process-grid{grid-template-columns:1fr;gap:26px;padding-top:48px}.process-grid h3{margin-top:22px}.contact-section{padding-block:72px}.contact-copy h2{font-size:54px}.form-card{padding:24px 18px}.form-card .fields{grid-template-columns:1fr}.faq-grid{gap:26px}.final-cta{padding:70px 16px}.footer-grid{grid-template-columns:1fr;text-align:center;gap:20px}.footer-grid img{margin:auto}.footer-grid>div:last-child{text-align:center}.mobile-bar{position:fixed;display:grid;grid-template-columns:.8fr 1.2fr;inset:auto 0 0;z-index:50;background:white;border-top:1px solid #ccc;padding:9px 10px calc(9px + env(safe-area-inset-bottom));gap:8px}.mobile-bar a{min-height:48px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-weight:700;font-size:13px}.mobile-bar a:first-child{border:1px solid #167145;color:#14623c}.mobile-bar a:last-child{background:var(--orange);color:#fff}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button{transition:none}}
</style>

<style is:global>
  /* Construction landing form: compact, single-purpose lead capture. */
  .form-card {
    position: relative;
    border-top: 5px solid var(--orange);
    box-shadow: 0 26px 70px rgba(0, 0, 0, .22);
  }
  .mobile-label { display: none; }
  .form-card::after {
    content: '';
    position: absolute;
    width: 54px;
    height: 54px;
    top: 20px;
    right: 22px;
    opacity: .08;
    background-image: linear-gradient(var(--ink) 1px, transparent 1px), linear-gradient(90deg, var(--ink) 1px, transparent 1px);
    background-size: 9px 9px;
    pointer-events: none;
  }
  .form-card > h3 { max-width: 80%; }
  .form-card .contact-panel { overflow: visible; }
  .form-card .contact-panel .contact-form { gap: 0; }
  .form-card .contact-form > label,
  .form-card .contact-form .fields label {
    margin: 18px 0 7px;
    color: #25282b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .form-card .contact-form .fields label { margin-top: 0; }
  .form-card .contact-form input:not([type='checkbox']):not([type='hidden']),
  .form-card .contact-form textarea {
    width: 100%;
    border: 1px solid #c8c4bc !important;
    background: #fff !important;
