t 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(90deg,#000,transparent)}.hero-content{position:relative;z-index:2;padding-block:78px}.hero-copy{max-width:720px}.kicker,.section-label{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--orange);margin-bottom:22px}.kicker{color:white;display:flex;align-items:center;gap:12px}.kicker span{width:46px;height:3px;background:var(--orange)}h1{font-size:clamp(68px,8.4vw,122px);margin-bottom:28px;max-width:760px}h1 em{color:var(--orange);font-style:normal}.hero-lead{max-width:600px;font-size:19px;line-height:1.55;color:#e5e5e5;margin-bottom:32px}.hero-actions{display:flex;align-items:center;gap:28px}.text-link{font-weight:700;text-underline-offset:6px}.hero-proof{display:flex;list-style:none;padding:30px 0 0;margin:40px 0 0;border-top:1px solid #ffffff3d;max-width:640px}.hero-proof li{display:flex;gap:12px;align-items:start;flex:1;border-right:1px solid #ffffff38;padding-inline:22px}.hero-proof li:first-child{padding-left:0}.hero-proof li:last-child{border:0}.hero-proof strong{font:800 32px 'Barlow Condensed',sans-serif;color:var(--orange)}.hero-proof span{font-size:12px;text-transform:uppercase;line-height:1.4;color:#ddd}.hero-tag{position:absolute;right:0;bottom:0;z-index:2;background:var(--orange);padding:14px 30px;font-size:11px;font-weight:700;letter-spacing:.16em}.section{padding-block:110px}.problem-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:100px}.section h2{font-size:clamp(46px,5vw,74px);margin:0}.problem-copy{padding-top:40px}.problem-copy p{color:#555;max-width:540px}.problem-copy .large{font-size:20px;color:#222}.problem-copy a{display:inline-block;margin-top:16px;font-weight:700;text-underline-offset:6px}.services{background:#151718;color:white}.section-heading{display:grid;grid-template-columns:1fr 380px;gap:80px;align-items:end;margin-bottom:60px}.section-heading>p{color:#aeb0b1;margin:0}.section-label.lig