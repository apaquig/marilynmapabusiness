---
const path = '/lp/curso-taxes-presencial/';
const title = 'Curso presencial de Taxes | 21 y 22 de noviembre | MAPA Business';
const description = 'Aprende el proceso de preparación de taxes en un curso presencial intensivo de dos días. Reserva tu cupo con $200. Inversión total: $600.';

const reservationUrl = 'https://link.fastpaydirect.com/payment-link/6afb32a121a48a3872d2680d';
const fullPaymentUrl = 'https://link.fastpaydirect.com/payment-link/6afb33fa21a48a3872d26828';
const mapsUrl = 'https://www.google.com/maps/dir/?api=1&destination=20+Bloomfield+Pl,+Newark,+NJ+07104';
const phone = 'tel:+18626228339';
const whatsapp = `https://wa.me/18626228339?text=${encodeURIComponent('Hola, quiero información sobre el curso presencial de Taxes del 21 y 22 de noviembre.')}`;

const topics = [
  ['Fundamentos del sistema tributario', 'Conceptos esenciales para entender el proceso de preparación de una declaración.'],
  ['Documentos y formularios', 'Cómo reconocer, organizar y trabajar con la documentación más común del contribuyente.'],
  ['Proceso de preparación', 'Un recorrido práctico desde la entrevista inicial hasta la revisión de la declaración.'],
  ['Créditos y deducciones', 'Criterios generales para identificar información relevante y evitar omisiones.'],
  ['Casos prácticos', 'Ejercicios guiados para aplicar lo aprendido en situaciones similares a las del trabajo real.'],
  ['Buenas prácticas profesionales', 'Organización, debida diligencia, confidencialidad y atención al cliente.'],
];

const faqs = [
  ['¿Cuánto cuesta el curso?', 'La inversión total es de $600. Puedes asegurar tu cupo con una reserva de $200 y pagar los $400 restantes según las instrucciones de MAPA Business. También puedes pagar por Zelle a paladinezmarilyn@gmail.com.'],
  ['¿Cuándo se realizará?', 'El curso presencial se realizará el sábado 21 y domingo 22 de noviembre de 2026. El horario y la dirección exacta se confirmarán con cada participante.'],
  ['¿Necesito experiencia previa?', 'La capacitación está diseñada para explicar el proceso paso a paso. Si ya tienes experiencia, los ejercicios también te ayudarán a organizar y reforzar tus conocimientos.'],
  ['¿La reserva es parte del precio?', 'Sí. Los $200 de reserva se aplican al costo total de $600; después de reservar queda un balance de $400.'],
  ['¿Puedo pagar por Zelle?', 'Sí. Puedes enviar la reserva de $200 o el pago completo de $600 por Zelle a paladinezmarilyn@gmail.com. Incluye tu nombre completo en la nota del pago y comunícate con nosotros para confirmar tu inscripción.'],
  ['¿Qué debo llevar?', 'Al confirmar tu cupo recibirás las instrucciones finales, incluyendo materiales, horario, ubicación y cualquier equipo recomendado.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  name: 'Curso presencial de preparación de Taxes',
  description,
  startDate: '2026-11-21',
  endDate: '2026-11-22',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'MAPA Business & Financial Services LLC',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '20 Bloomfield Pl',
      addressLocality: 'Newark',
      addressRegion: 'NJ',
      postalCode: '07104',
      addressCountry: 'US',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'MAPA Business & Financial Services LLC',
    url: 'https://marilynmapabusiness.com/',
    telephone: '+1-862-622-8339',
  },
  offers: {
    '@type': 'Offer',
    price: '600',
    priceCurrency: 'USD',
    availability: 'https://schema.org/LimitedAvailability',
    url: `https://marilynmapabusiness.com${path}`,
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://marilynmapabusiness.com${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://marilynmapabusiness.com${path}`} />
    <meta property="og:image" content="https://marilynmapabusiness.com/images/lp/curso-taxes-hero.jpg" />
    <meta property="og:locale" content="es_US" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" aria-label="MAPA Business, inicio"><img src="/logo-mapa.png" width="954" height="270" alt="MAPA Business & Financial Services" /></a>
        <a class="button button-small" href={reservationUrl}>Reservar con $200</a>
      </div>
    </header>

    <main id="contenido">
      <section class="hero">
        <img class="hero-photo" src="/images/lp/curso-taxes-hero.jpg" width="2000" height="1500" alt="Participantes del curso presencial de taxes de MAPA Business" loading="eager" fetchpriority="high" />
        <div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div>
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">CAPACITACIÓN PRESENCIAL · CUPOS LIMITADOS</p>
            <div class="hero-method" aria-label="Curso 80 por ciento práctico y 20 por ciento teórico">
              <div><strong>80%</strong><span>PRÁCTICO</span></div>
              <i></i>
              <div><strong>20%</strong><span>TEÓRICO</span></div>
              <p>Aprende haciendo</p>
            </div>
            <h1>Prepárate para la próxima temporada de <em>TAXES.</em></h1>
            <div class="learning-video">
              <p>APRENDE TAXES CON NOSOTROS</p>
              <video controls autoplay muted playsinline preload="metadata" poster="/video/taxes-aprender-portada.jpg">
                <source src="/video/taxes-aprender.mp4" type="video/mp4" />
                Tu navegador no puede reproducir este video.
              </video>
            </div>
            <p class="hero-lead">Dos días para practicar el proceso, trabajar casos y desarrollar una base más sólida en preparación de impuestos. Menos teoría, más aplicación real.</p>
            <div class="date-card" aria-label="Fechas del curso">
              <div><strong>21</strong><span>NOV</span></div><span class="date-line"></span><div><strong>22</strong><span>NOV</span></div>
              <p><b>Sábado y domingo</b><br />Curso presencial · 2026</p>
            </div>
            <div class="hero-actions">
              <a class="button" href={reservationUrl}>Asegurar mi cupo <span>→</span></a>
              <a class="secondary-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Preguntar por WhatsApp</a>
            </div>
            <p class="microcopy">Reserva de $200 aplicada al precio total. Balance restante: $400.</p>
          </div>
          <aside class="price-card" id="reserva">
            <p class="card-kicker">TU INVERSIÓN</p>
            <div class="total"><sup>$</sup>600 <span>USD</span></div>
            <p>Capacitación presencial de dos días</p>
            <div class="price-breakdown">
              <div><span>Reserva hoy</span><strong>$200</strong></div>
              <div><span>Balance restante</span><strong>$400</strong></div>
            </div>
            <a class="button button-full" href={reservationUrl}>Reservar con $200</a>
            <a class="full-payment-link" href={fullPaymentUrl}>Pagar el total de $600</a>
            <div class="zelle-option"><span class="zelle-heading"><svg class="zelle-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="#6d1ed4"/><path d="M14.7 4h2.6v3h5.2v3.1l-8.1 11.8h8.3V26h-5.4v3h-2.6v-3H9.3v-3.2L17.4 11H9.7V7h5V4Z" fill="#fff"/></svg> O paga por Zelle</span><a href="mailto:paladinezmarilyn@gmail.com">paladinezmarilyn@gmail.com</a><small>Incluye tu nombre completo en la nota del pago.</small></div>
            <small>Tu reserva forma parte del costo total del curso.</small>
            <ul>
              <li>Dos días de aprendizaje presencial</li>
              <li>Explicaciones paso a paso</li>
              <li>Ejercicios y casos prácticos</li>
              <li>Espacio para preguntas</li>
            </ul>
          </aside>
        </div>
      </section>

      <section class="testimonials-section" aria-labelledby="testimonials-title">
        <div class="shell">
          <div class="testimonial-intro">
            <span>EXPERIENCIAS REALES</span>
            <h2 id="testimonials-title">Lo que dicen nuestros estudiantes</h2>
            <p>Conoce la experiencia de quienes ya participaron en nuestro curso presencial.</p>
          </div>
          <div class="testimonial-videos">
            <article>
              <video controls playsinline preload="none" poster="/video/testimonio-taxes-1-portada.jpg"><source src="/video/testimonio-taxes-1.mp4" type="video/mp4" />Tu navegador no puede reproducir este video.</video>
              <h3>Una experiencia práctica</h3><p>Testimonio de nuestro curso presencial.</p>
            </article>
            <article>
              <video controls playsinline preload="none" poster="/video/testimonio-linda-portada.jpg"><source src="/video/testimonio-linda.mp4" type="video/mp4" />Tu navegador no puede reproducir este video.</video>
              <h3>La experiencia de Linda</h3><p>Lo que aprendió durante la capacitación.</p>
            </article>
            <article>
              <video controls playsinline preload="none" poster="/video/testimonio-jenifer-portada.jpg"><source src="/video/testimonio-jenifer.mp4" type="video/mp4" />Tu navegador no puede reproducir este video.</video>
              <h3>La experiencia de Jenifer</h3><p>Su opinión sobre el curso presencial.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="trust-strip">
        <div class="shell trust-grid">
          <p><strong>2 días</strong><span>de capacitación</span></p>
          <p><strong>Presencial</strong><span>aprende junto a nosotros</span></p>
          <p><strong>80% práctico</strong><span>20% teórico</span></p>
          <p><strong>Cupos limitados</strong><span>reserva con $200</span></p>
        </div>
      </section>

      <section class="location-strip" aria-labelledby="location-title">
        <div class="shell location-card">
          <div class="location-icon" aria-hidden="true">⌖</div>
          <div><p class="section-label">UBICACIÓN DEL CURSO</p><h2 id="location-title">20 Bloomfield Pl<br />Newark, NJ 07104</h2><p>Curso presencial en las oficinas de MAPA Business &amp; Financial Services.</p></div>
          <a class="location-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps <span>↗</span></a>
        </div>
        <div class="shell map-embed">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.3893229357477!2d-74.1696199!3d40.7534611!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c255b932165583%3A0xad092a1ffae4519f!2sMAPA%20Business%20%26%20Financial%20Services%20LLC!5e0!3m2!1ses!2sus!4v1785794028896!5m2!1ses!2sus"
            width="1180"
            height="420"
            style="border:0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de MAPA Business & Financial Services en Newark, New Jersey"
          ></iframe>
        </div>
      </section>

      <section class="section intro">
        <div class="shell split">
          <div>
            <p class="section-label">MÁS QUE UNA CLASE</p>
            <h2>Aprende el proceso con claridad y confianza.</h2>
          </div>
          <div class="body-copy">
            <p class="lead">Preparar taxes requiere mucho más que llenar casillas. Requiere entender la información del contribuyente, hacer las preguntas correctas y seguir un proceso organizado.</p>
            <p>En este curso presencial trabajaremos los fundamentos con explicaciones claras y ejercicios que te ayudarán a conectar la teoría con situaciones reales.</p>
          </div>
        </div>
      </section>

      <section class="section curriculum" id="temario">
        <div class="shell">
          <div class="section-heading"><div><p class="section-label light">LO QUE VAS A APRENDER</p><h2>Un temario pensado para llevarte paso a paso.</h2></div><div class="practice-ratio"><strong>80%</strong><span>práctica</span><i></i><strong>20%</strong><span>teoría</span></div></div>
          <div class="topic-grid">
            {topics.map(([heading, text], index) => (
              <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{heading}</h3><p>{text}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="section instructor">
        <div class="shell instructor-grid">
          <div class="portrait-wrap"><img src="/marilin.webp" width="1200" height="1600" loading="lazy" alt="Marilyn Paladinez de MAPA Business & Financial Services" /></div>
          <div>
            <p class="section-label light">APRENDE CON EXPERIENCIA</p>
            <h2>Capacitación cercana, clara y enfocada en la práctica.</h2>
            <p>MAPA Business &amp; Financial Services combina experiencia profesional con un enfoque educativo accesible para nuestra comunidad. Queremos que entiendas el porqué de cada paso, no solamente qué botón presionar.</p>
            <blockquote>“Nuestro objetivo es que salgas con más claridad, mejores preguntas y una base que puedas aplicar.”</blockquote>
          </div>
        </div>
      </section>

      <section class="section faq">
        <div class="shell faq-grid">
          <div><p class="section-label">RESUELVE TUS DUDAS</p><h2>Preguntas frecuentes.</h2><p>¿Necesitas hablar con nosotros? <a href={whatsapp} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp.</a></p></div>
          <div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div>
        </div>
      </section>

      <section class="final-cta">
        <div class="shell final-grid">
          <div><p class="section-label light">21 Y 22 DE NOVIEMBRE</p><h2>Tu próximo paso puede comenzar aquí.</h2><p>Asegura tu lugar con $200. Inversión total del curso: $600.</p></div>
          <div class="final-actions">
            <a class="button button-light" href={reservationUrl}>Reservar con $200 <span>→</span></a>
            <a class="final-payment-link" href={fullPaymentUrl}>Pagar los $600 completos</a>
            <a class="final-payment-link zelle-final-link" href="mailto:paladinezmarilyn@gmail.com"><svg class="zelle-icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="#6d1ed4"/><path d="M14.7 4h2.6v3h5.2v3.1l-8.1 11.8h8.3V26h-5.4v3h-2.6v-3H9.3v-3.2L17.4 11H9.7V7h5V4Z" fill="#fff"/></svg> Pagar por Zelle</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-grid"><img src="/logo-mapa.png" width="954" height="270" alt="MAPA Business & Financial Services" /><div><strong>MAPA Business &amp; Financial Services LLC</strong><p>20 Bloomfield Pl, Newark, NJ 07104</p></div><div><a href={phone}>(862) 622-8339</a><a href="/es/privacy-policy/">Política de privacidad</a></div></div>
    </footer>
    <div class="mobile-bar"><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={reservationUrl}>Reservar con $200</a></div>
  </body>
</html>

<style is:global>
  :root{--red:#c90016;--red-dark:#97000f;--ink:#101218;--cream:#f6f3ed;--muted:#666a72;--line:#ddd8cf;color-scheme:light}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:#fff;color:var(--ink);font-family:'DM Sans',Arial,sans-serif;font-size:16px;line-height:1.65}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:Manrope,Arial,sans-serif;line-height:1.05;letter-spacing:-.045em}a{color:inherit}img{max-width:100%;height:auto}.shell{width:min(1180px,calc(100% - 48px));margin-inline:auto}.skip{position:fixed;top:-80px;left:16px;z-index:100;background:#fff;padding:12px}.skip:focus{top:12px}.site-header{height:78px;background:#fff;border-bottom:1px solid #ece8e1;display:flex;align-items:center;position:relative;z-index:20}.header-inner{display:flex;align-items:center;justify-content:space-between}.header-inner>a:first-child{height:48px;width:170px}.header-inner img{width:100%;height:100%;object-fit:contain;object-position:left}.button{display:inline-flex;align-items:center;justify-content:center;gap:26px;min-height:56px;padding:14px 25px;border-radius:8px;background:var(--red);color:#fff;text-decoration:none;font-weight:700;box-shadow:0 10px 26px #a6001628;transition:transform .2s,background .2s}.button:hover{background:var(--red-dark);transform:translateY(-2px)}.button-small{min-height:44px;padding:10px 18px;font-size:14px}.hero{position:relative;overflow:hidden;background:var(--cream);padding:82px 0 88px}.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#14162008 1px,transparent 1px),linear-gradient(90deg,#14162008 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(90deg,#000,transparent 62%)}.hero-orb{position:absolute;border-radius:50%;filter:blur(2px)}.orb-one{width:460px;height:460px;right:-100px;top:-180px;background:#d6001c18}.orb-two{width:250px;height:250px;left:42%;bottom:-170px;background:#f1c26d3a}.hero-grid{position:relative;display:grid;grid-template-column