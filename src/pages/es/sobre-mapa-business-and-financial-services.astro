---
// src/pages/es/sobre-mapa-business-and-financial-services.astro
import BaseLayout from "../../layouts/BaseLayout.astro";

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = `${WEBSITE}/es/sobre-mapa-business-and-financial-services/`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${WEBSITE}/es/sobre-mapa-business-and-financial-services/#webpage`,
      url: canonical,
      name: "Sobre MAPA Business & Financial Services LLC | Marilyn Paladinez",
      isPartOf: { "@id": `${WEBSITE}/#website` },
      about: { "@id": `${WEBSITE}/#organization` },
      inLanguage: "es",
    },
    {
      "@type": "FinancialService",
      "@id": `${WEBSITE}/#organization`,
      name: "MAPA Business & Financial Services LLC",
      url: WEBSITE,
      telephone: "+18626228339",
      foundingDate: "2014",
      address: {
        "@type": "PostalAddress",
        streetAddress: "20 Bloomfield Pl",
        addressLocality: "Newark",
        addressRegion: "NJ",
        postalCode: "07104",
        addressCountry: "US",
      },
      founder: { "@id": `${WEBSITE}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${WEBSITE}/#person`,
      name: "Marilyn Paladinez",
      jobTitle: "Fundadora & Estratega Financiera para Migrantes",
      worksFor: { "@id": `${WEBSITE}/#organization` },
      url: `${WEBSITE}/marilyn-paladinez/`,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "¿Qué es MAPA Business & Financial Services LLC?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "MAPA Business & Financial Services LLC es una empresa fundada por Marilyn Paladinez en Newark, New Jersey, que apoya a la comunidad latina e inmigrante con 14 servicios notariales, financieros, administrativos y de preparación de documentos.",
          },
        },
        {
          "@type": "Question",
          name: "¿Las consultas en MAPA Business tienen algún costo?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. Todas las consultas iniciales en MAPA Business & Financial Services LLC son completamente gratis. Escuchamos tu situación, explicamos las opciones y tú decides cómo continuar sin compromiso.",
          },
        },
        {
          "@type": "Question",
          name: "¿Dónde está ubicada MAPA Business?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Estamos ubicados en 20 Bloomfield Pl, Newark, NJ 07104. También atendemos de forma digital para clientes en todo New Jersey.",
          },
        },
        {
          "@type": "Question",
          name: "¿MAPA Business atiende en español?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Sí. Ofrecemos atención 100% bilingüe en español e inglés para que comprendas perfectamente cada proceso sin barreras de idioma.",
          },
        },
        {
          "@type": "Question",
          name: "¿MAPA Business es un bufete de abogados?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. MAPA Business & Financial Services LLC no es un bufete jurídico. Marilyn Paladinez es Notaria Pública certificada de NJ y Acceptance Agent del IRS. Ofrecemos orientación y preparación de documentos pero no representación ni asesoría legal.",
          },
        },
      ],
    },
  ],
};

const services = [
  {
    icon: "📜",
    name: "Notaría Pública",
    tag: "Certificada en NJ",
    desc: "Notarización de firmas y documentos para trámites personales, comerciales o administrativos en New Jersey de forma rápida y sencilla.",
    href: "/servicios/notaria/",
  },
  {
    icon: "🌐",
    name: "Traducciones Certificadas",
    tag: "Oficial & Aceptada",
    desc: "Traducciones del español al inglés y viceversa aceptadas por agencias gubernamentales, cortes y escuelas.",
    href: "/servicios/traducciones/",
  },
  {
    icon: "✍️",
    name: "Poderes Notariales",
    tag: "Personal & Comercial",
    desc: "Redacción y notarización de poderes para trámites personales, bancarios e internacionales en tu país de origen.",
    href: "/servicios/poderes-notariales/",
  },
  {
    icon: "💼",
    name: "Permisos de Trabajo",
    tag: "Formulario I-765",
    desc: "Preparación y organización de documentos para solicitudes y renovaciones del Formulario I-765 ante USCIS.",
    href: "/servicios/permisos-de-trabajo/",
  },
  {
    icon: "🪪",
    name: "Licencias de Conducir NJ",
    tag: "Guía Cita MVC",
    desc: "Orientación paso a paso y revisión de expedientes antes de tu cita en la New Jersey Motor Vehicle Commission.",
    href: "/servicios/licencias-de-conducir/",
  },
  {
    icon: "🔢",
    name: "ITIN (Número Fiscal)",
    tag: "Acceptance Agent IRS",
    desc: "Trámite de Formulario W-7 como Acceptance Agent del IRS. Validamos pasaportes en persona sin enviarlos por correo.",
    href: "/servicios/itin/",
  },
  {
    icon: "🧾",
    name: "Taxes e Impuestos",
    tag: "Personal & Comercial",
    desc: "Preparación de declaraciones de impuestos federales y estatales para individuos, familias y pequeños negocios.",
    href: "/servicios/taxes/",
  },
  {
    icon: "📊",
    name: "Bookkeeping",
    tag: "Contabilidad Mensual",
    desc: "Registro de ingresos, gastos, conciliaciones e información financiera clara para la toma de decisiones en tu negocio.",
    href: "/servicios/bookkeeping/",
  },
  {
    icon: "🚗",
    name: "Seguros de Auto",
    tag: "Cotización Múltiple",
    desc: "Cotizamos seguros de automóvil en New Jersey adaptados a tu presupuesto. Opciones para licencias extranjeras.",
    href: "/servicios/seguros-de-auto/",
  },
  {
    icon: "🏥",
    name: "Seguros de Salud",
    tag: "Individual & Familiar",
    desc: "Asesoría para conocer opciones de cobertura médica individual y familiar adaptadas a tus necesidades.",
    href: "/servicios/seguros-de-salud/",
  },
  {
    icon: "💛",
    name: "Seguros de Vida",
    tag: "Protección Familiar",
    desc: "Explicación sencilla de alternativas de seguro de vida para proteger financieramente el futuro de tu familia.",
    href: "/servicios/seguros-de-vida/",
  },
  {
    icon: "🌍",
    name: "Doble Nacionalidad",
    tag: "Trámites Consulares",
    desc: "Asistencia con la preparación de documentos y expedientes para trámites de doble nacionalidad ante consulados.",
    href: "/servicios/doble-nacionalidad/",
  },
  {
    icon: "⚖️",
    name: "Divorcios Sin Disputa",
    tag: "Mutuo Acuerdo",
    desc: "Preparación y organización de documentos para procesos de divorcio de mutuo acuerdo de manera transparente.",
    href: "/servicios/divorcios/",
  },
  {
    icon: "💍",
    name: "Matrimonios Civiles",
    tag: "Registros & Trámites",
    desc: "Orientación y ayuda documental para matrimonios civiles y registros administrativos correspondientes.",
    href: "/servicios/matrimonios/",
  },
];

const citiesList = [
  "Newark", "Elizabeth", "Jersey City", "Paterson", "Passaic", "Clifton",
  "Union City", "West New York", "East Orange", "Plainfield", "Perth Amboy",
  "Trenton", "Camden"
];
---

<BaseLayout
  lang="es"
  title="Sobre MAPA Business & Financial Services LLC | Marilyn Paladinez"
  description="Conoce la historia de Marilyn Paladinez y MAPA Business & Financial Services LLC en Newark, NJ. 14 servicios notariales, fiscales y de documentos con consultas 100% gratis."
  canonical={canonical}
  currentPath="/es/sobre-mapa-business-and-financial-services/"
  schema={schema}
>
  <!-- SECCIÓN PRINCIPAL HISTORIA -->
  <section id="nosotros" class="sobre-main-section">
    <div class="section-inner">
      <div class="about-grid">
        
        <!-- FOTO MARILYN -->
        <div class="about-img-wrap">
          <img src="/marilin2.webp" alt="Marilyn Paladinez — Fundadora de MAPA Business" />
          <div class="about-card">
            <span class="num">10+</span>
            <span class="label">Años de Experiencia</span>
          </div>
        </div>

        <!-- CONTENIDO HISTORIA DE MARILYN -->
        <div class="about-text">
          <div class="section-tag">NUESTRA FUNDACIÓN</div>
          <h2 class="section-title">Mi historia y el nacimiento de <span>MAPA Business &amp; Financial Services LLC</span></h2>
          
          <p class="story-lead">
            Mi nombre es <strong>Marilyn Paladinez</strong> y soy la fundadora de <strong>MAPA Business &amp; Financial Services LLC</strong>, una empresa ubicada en Newark, New Jersey, creada con el propósito de apoyar a la comunidad latina e inmigrante con servicios financieros, empresariales, notariales, administrativos y de preparación de documentos.
          </p>

          <p class="story-text">
            Mi historia con MAPA comenzó después de trabajar de cerca con nuestra comunidad y conocer personalmente muchas de las dificultades que enfrentan las familias, los inmigrantes, los emprendedores y los pequeños negocios cuando necesitan realizar un trámite importante en Estados Unidos.
          </p>

          <p class="story-text">
            Con frecuencia encontraba personas que no sabían por dónde comenzar, qué documentos necesitaban, a dónde debían acudir o cómo entender determinados procesos. Para muchas de ellas, la barrera del idioma hacía que una situación que ya era complicada resultara todavía más difícil y estresante.
          </p>

          <p class="story-text">
            Conocí emprendedores con grandes ideas que no sabían cómo registrar su negocio o llevar su contabilidad; personas que necesitaban tramitar su ITIN o seguro pero temían ser engañadas; y familias enteras que solo buscaban a alguien de confianza que pudiera escuchar su caso y explicarles con claridad cuáles debían ser sus próximos pasos.
          </p>

          <div class="story-highlight-box">
            <p>
              Esa realidad me motivó a crear <strong>MAPA Business &amp; Financial Services LLC</strong>: un lugar donde la comunidad encuentre 14 servicios integrales y una atención cercana, personalizada y fácil de entender tanto en <strong>español como en inglés</strong>.
            </p>
          </div>
        </div>

      </div>

      <!-- TARJETA CITA DE MARILYN -->
      <div class="quote-card-block">
        <blockquote>
          “Para mí, ofrecer un servicio significa mucho más que completar documentos. Significa escuchar primero, entender la necesidad de cada persona y explicar el proceso con claridad para que tome decisiones con mayor información y confianza.”
        </blockquote>
        <cite>— Marilyn Paladinez, Fundadora de MAPA Business &amp; Financial Services LLC</cite>
      </div>
    </div>
  </section>

  <!-- BANNER CONSULTAS 100% GRATIS -->
  <section class="free-consultation-section">
    <div class="section-inner">
      <div class="free-box">
        <span class="section-tag gold-tag">COMPROMISO TRANSPARENTE</span>
        <h2 class="section-title">Las consultas en MAPA son <span>completamente gratis</span></h2>
        <p class="free-desc">
          No quiero que ninguna persona tenga miedo de preguntar pensando que por hablar con nosotros tendrá que pagar. Nuestra filosofía es transparente y honesta:
        </p>

        <div class="process-steps">
          <div class="step">
            <div class="step-num">1</div>
            <h3>Primero Escuchamos</h3>
            <p>Nos cuentas tu caso, tus metas o tus inquietudes sin costo ni presión alguna.</p>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <h3>Luego Explicamos</h3>
            <p>Te mostramos claramente qué opciones tienes, requisitos y cuáles son tus próximos pasos.</p>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <h3>Después Tú Decides</h3>
            <p>Tú eliges libremente si deseas continuar con nosotros para la realización de tu trámite.</p>
          </div>
        </div>

        <div class="cta-wrap">
          <a href="https://wa.me/18626228339?text=Hola%20Marilyn,%20quisiera%20una%20consulta%20gratuita." target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
            💬 Solicitar Consulta Gratis por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 14 SERVICIOS -->
  <section id="servicios">
    <div class="section-inner">
      <div class="section-tag">CATÁLOGO COMPLETO</div>
      <h2 class="section-title">Nuestros 14 Servicios <span>Principales</span></h2>
      <p class="section-desc">
        En MAPA Business &amp; Financial Services LLC ofrecemos asistencia y preparación documental en las siguientes 14 áreas:
      </p>

      <div class="services-grid">
        {services.map(s => (
          <div class="service-card">
            <span class="service-icon">{s.icon}</span>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
            <a href={s.href} class="service-link">Ver detalles del servicio →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- A QUIÉNES AYUDAMOS & CREDENCIALES -->
  <section class="pillars-credentials-section">
    <div class="section-inner">
      <div class="about-grid">
        
        <!-- PILARES -->
        <div>
          <div class="section-tag">NUESTRA COMUNIDAD</div>
          <h2 class="section-title">Apoyamos a <span>Familias, Migrantes y Emprendedores</span></h2>
          
          <div class="pillar-list">
            <div class="pillar-item">
              <span class="p-emoji">👨‍👩‍👧‍👦</span>
              <div>
                <h4>Familias</h4>
                <p>Notarizaciones, traducciones certificadas, poderes notariales y seguros de auto, salud y vida para proteger el bienestar familiar.</p>
              </div>
            </div>

            <div class="pillar-item">
              <span class="p-emoji">🛂</span>
              <div>
                <h4>Migrantes</h4>
                <p>Trámites de número ITIN (Formulario W-7), permisos de trabajo (Formulario I-765), licencias de conducir de NJ y registros consulares.</p>
              </div>
            </div>

            <div class="pillar-item">
              <span class="p-emoji">💼</span>
              <div>
                <h4>Emprendedores &amp; Pequeños Negocios</h4>
                <p>Bookkeeping mensual, contabilidad organizada y preparación de impuestos personales y corporativos (Taxes).</p>
              </div>
            </div>
          </div>
        </div>

        <!-- CREDENCIALES -->
        <div>
          <div class="cred-card-box">
            <div class="section-tag gold-tag">ACREDITACIONES</div>
            <h3 class="cred-title">Credenciales Oficiales de Marilyn Paladinez</h3>

            <div class="cred-item">
              <span class="c-icon">📜</span>
              <div>
                <strong>Notaria Pública Certificada de New Jersey</strong>
                <p>Comisión activa para notarizar firmas, documentos, poderes y acuerdos legales en todo el estado.</p>
              </div>
            </div>

            <div class="cred-item">
              <span class="c-icon">🔢</span>
              <div>
                <strong>IRS Certified Acceptance Agent (CAA)</strong>
                <p>Autorizada para validar pasaportes e identificaciones originales en trámites de ITIN sin enviarlos por correo.</p>
              </div>
            </div>

            <div class="cred-item">
              <span class="c-icon">📋</span>
              <div>
                <strong>Especialista en Preparación Documental</strong>
                <p>Años de experiencia preparando formularios gubernamentales, taxes, permisos de trabajo y cotizaciones de seguros.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- COBERTURA EN NEW JERSEY & CONTACTO -->
  <section class="coverage-section">
    <div class="section-inner text-center">
      <div class="section-tag">PRESENCIA LOCAL</div>
      <h2 class="section-title">Servicio en <span>Newark y Todo New Jersey</span></h2>
      <p class="coverage-desc">
        Nuestra oficina principal está en <strong>Newark, NJ</strong>, y atendemos a clientes en 13 municipios principales:
      </p>

      <div class="city-pills-wrap">
        {citiesList.map(c => (
          <span class="city-pill">📍 {c}</span>
        ))}
      </div>

      <div class="contact-info-grid">
        <div class="c-info-item">
          <strong>📍 Dirección Oficina</strong>
          <p>20 Bloomfield Pl, Newark, NJ 07104</p>
        </div>
        <div class="c-info-item">
          <strong>📞 Teléfono Directo</strong>
          <p><a href="tel:+18626228339">(862) 622-8339</a></p>
        </div>
        <div class="c-info-item">
          <strong>💬 Atención WhatsApp</strong>
          <p><a href="https://wa.me/18626228339" target="_blank" rel="noopener">(862) 622-8339</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section class="faq-section">
    <div class="section-inner" style="max-width: 900px;">
      <div class="text-center">
        <div class="section-tag">RESPUESTAS CLARAS</div>
        <h2 class="section-title">Preguntas Frecuentes sobre <span>MAPA Business</span></h2>
      </div>

      <div class="faq-accordion-list">
        <div class="faq-box">
          <h4>¿Qué es MAPA Business &amp; Financial Services LLC?</h4>
          <p>Es una empresa creada por Marilyn Paladinez en Newark, New Jersey, dedicada a asesorar y preparar documentos en 14 áreas notariales, fiscales, ITIN, seguros, permisos de trabajo y servicios comerciales.</p>
        </div>
        <div class="faq-box">
          <h4>¿Las consultas tienen costo?</h4>
          <p>No. Todas nuestras consultas iniciales son 100% gratuitas. Escuchamos tu caso sin compromiso, te explicamos el proceso y tú eliges libremente si deseas continuar.</p>
        </div>
        <div class="faq-box">
          <h4>¿MAPA Business es un bufete de abogados?</h4>
          <p>No. MAPA Business no es un bufete jurídico. Marilyn Paladinez es Notaria Pública de NJ y Acceptance Agent del IRS, especializada en preparación documental y orientación administrativa.</p>
        </div>
        <div class="faq-box">
          <h4>¿Puedo hacer mi consulta por WhatsApp o teléfono?</h4>
          <p>Sí. Atendemos de forma presencial en nuestra oficina de Newark, NJ y también brindamos soporte por teléfono y WhatsApp al (862) 622-8339.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     ESTILOS LIMPIOS SIN HERO CABECERA
     ========================================================================== */

  .sobre-main-section {
    padding-top: 110px !important; /* Espacio para librar la barra de navegación fija */
    background: #0f0f0f;
  }

  /* HISTORIA TEXTO */
  .story-lead {
    font-size: 1.12rem !important;
    line-height: 1.8 !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    margin-bottom: 16px !important;
  }
  .story-text {
    font-size: 1rem !important;
    line-height: 1.75 !important;
    color: rgba(255, 255, 255, 0.75) !important;
    margin-bottom: 16px !important;
  }
  .story-highlight-box {
    background: rgba(204, 0, 0, 0.1);
    border-left: 4px solid var(--red, #cc0000);
    padding: 20px 24px;
    border-radius: 0 8px 8px 0;
    margin-top: 24px;
  }
  .story-highlight-box p {
    margin: 0 !important;
    color: #ffffff !important;
    font-size: 1.02rem !important;
    line-height: 1.7 !important;
  }

  /* TARJETA CITA */
  .quote-card-block {
    background: #141414;
    border: 1px solid rgba(204, 0, 0, 0.3);
    border-left: 4px solid var(--red, #cc0000);
    border-radius: 10px;
    padding: 32px 30px;
    margin-top: 45px;
    text-align: left;
  }
  .quote-card-block blockquote {
    font-size: 1.12rem !important;
    line-height: 1.8 !important;
    color: #ffffff !important;
    font-style: italic !important;
    margin-bottom: 12px !important;
  }
  .quote-card-block cite {
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    color: var(--red, #cc0000) !important;
    font-style: normal !important;
    display: block;
  }

  /* CONSULTAS GRATIS BANNER */
  .free-consultation-section {
    background: #0a0a0a;
    padding: 70px 20px;
  }
  .free-box {
    background: linear-gradient(135deg, #1b0000 0%, #100000 100%);
    border: 2px solid var(--red, #cc0000);
    border-radius: 16px;
    padding: 50px 30px;
    text-align: center;
  }
  .gold-tag {
    background: rgba(212, 175, 55, 0.15) !important;
    border-color: rgba(212, 175, 55, 0.4) !important;
    color: #ffd700 !important;
  }
  .free-desc {
    font-size: 1.08rem !important;
    color: rgba(255, 255, 255, 0.85) !important;
    max-width: 760px;
    margin: 0 auto 40px !important;
    line-height: 1.7 !important;
  }
  .cta-wrap { margin-top: 40px; }
  .btn-lg {
    font-size: 1.05rem !important;
    padding: 16px 36px !important;
    border-radius: 30px !important;
  }

  /* PILARES & CREDENCIALES */
  .pillars-credentials-section {
    background: #0f0f0f;
    padding: 80px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .pillar-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 30px;
  }
  .pillar-item {
    display: flex;
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 20px;
    border-radius: 8px;
  }
  .p-emoji { font-size: 2rem; flex-shrink: 0; }
  .pillar-item h4 {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .pillar-item p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.6;
  }

  .cred-card-box {
    background: #141414;
    border: 2px solid #d4af37;
    border-radius: 12px;
    padding: 30px 24px;
  }
  .cred-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    color: #ffffff;
    margin: 12px 0 24px;
  }
  .cred-item {
    display: flex;
    gap: 14px;
    margin-bottom: 20px;
  }
  .cred-item:last-child { margin-bottom: 0; }
  .c-icon { font-size: 1.8rem; flex-shrink: 0; }
  .cred-item strong {
    display: block;
    font-size: 0.98rem;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .cred-item p {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
