---
// src/templates/CityServiceTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities, type City } from '../data/cities';
import { services, type Service } from '../data/services';
import { serviceDetails } from '../data/serviceDetails';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';

interface Props {
  lang: 'es' | 'en';
  city: City;
  service: Service;
}

const { lang, city, service } = Astro.props;

const details = serviceDetails[service.slug]?.[lang] || '';

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es'
  ? `${WEBSITE}/service-areas/${city.slug}/${service.slug}/`
  : `${WEBSITE}/en/service-areas/${city.slug}/${service.slug}/`;
const currentPath = lang === 'es'
  ? `/service-areas/${city.slug}/${service.slug}/`
  : `/en/service-areas/${city.slug}/${service.slug}/`;

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

const cityName = city.name;
const countyName = city.county;
const serviceName = t(`services.${service.slug}.title`);
const serviceDesc = t(`services.${service.slug}.desc`);
const spokeTitle = t(`services.${service.slug}.spoke_title`) || serviceName;

const isNewarkNotariaEs = city.slug === 'newark' && service.slug === 'notaria' && lang === 'es';

const title = isNewarkNotariaEs
  ? "Notaría Pública en Newark, NJ | Notary Public en Español | MAPA"
  : (lang === 'es'
    ? `${service.name} en ${cityName}, NJ | MAPA Business`
    : `${spokeTitle} ${cityName}, NJ | MAPA Business`);

const description = isNewarkNotariaEs
  ? "¿Buscas Notaría Pública en Newark, NJ? Servicio de notarización y Notary Public en español. Consulta inicial gratis. Agenda tu cita con MAPA Business."
  : (lang === 'es'
    ? `Servicio de ${service.name} en ${cityName}, New Jersey. Asistencia profesional en español, notarización, taxes, ITIN y trámites de negocios. Marilyn Paladinez: ${PHONE}.`
    : `${spokeTitle.endsWith(' in') ? spokeTitle : spokeTitle + ' in'} ${cityName}, New Jersey. Professional assistance, notary public, taxes, ITIN, and business support. Marilyn Paladinez: ${PHONE}.`);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      "name": lang === 'es' ? `${serviceName} en ${cityName}, NJ` : `${serviceName} in ${cityName}, NJ`,
      "description": description,
      "url": canonical,
      "provider": {
        "@type": service.schemaType || "FinancialService",
        "@id": `${WEBSITE}/#organization`,
        "name": "MAPA Business & Financial Services LLC",
        "telephone": PHONE_HREF,
        "logo": `${WEBSITE}/logo-mapa.png`,
        "image": `${WEBSITE}/marilin2.webp`,
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "20 Bloomfield Pl",
          "addressLocality": "Newark",
          "addressRegion": "NJ",
          "postalCode": "07104",
          "addressCountry": "US"
        }
      },
      "areaServed": [
        {
          "@type": "City",
          "name": cityName,
          "addressRegion": "NJ",
          "sameAs": `https://www.wikidata.org/wiki/${city.wikidataId}`
        },
        ...city.nearbyAreas.map((area) => ({ "@type": "City", "name": area }))
      ]
    }
  ]
};

const homeLink = lang === 'es' ? '/' : '/en/';
const cityLink = lang === 'es' ? `/service-areas/${city.slug}/` : `/en/service-areas/${city.slug}/`;
const otherServices = services.filter((s) => s.slug !== service.slug);
const otherCities = cities.filter((c) => c.slug !== city.slug);

const cityServiceLinkPrefix = lang === 'es' ? '/service-areas/' : '/en/service-areas/';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeSection="areas-de-servicio"
  currentPath={currentPath}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <a href={homeLink}>{t("nav.home")}</a>
    <span>›</span>
    <a href={cityLink}>{cityName}</a>
    <span>›</span>
    <span>{serviceName}</span>
  </nav>

  {isNewarkNotariaEs ? (
    <!-- ============================================== -->
    <!-- MAQUETA EXCLUSIVA PARA NEWARK NOTARIA ES        -->
    <!-- ============================================== -->
    <div class="city-hero">
      <div class="city-hero-inner">
        <div class="city-tag">Newark, New Jersey</div>
        <h1>
          Notaría Pública en Newark, NJ – Servicio Notarial en Español
        </h1>
        <p style="font-weight: 500; font-size: 1.1rem; margin-bottom: 12px; color: #fff;">
          ¿Necesitas notarizar un documento en Newark, New Jersey, y prefieres recibir atención en español?
        </p>
        <p style="margin-bottom: 12px; font-size: 0.95rem;">
          En MAPA Business & Financial Services LLC ofrecemos servicios de Notary Public en Newark, NJ, con atención clara y personalizada para personas, familias, emprendedores y pequeños negocios.
        </p>
        <p style="margin-bottom: 25px; font-size: 0.95rem;">
          Si estás buscando en Google “notary near me”, “notaría cerca de mí”, “notario cerca de mí” o simplemente necesitas saber dónde puedes notarizar un documento en Newark, puedes comunicarte con nosotros para confirmar qué necesitas llevar y coordinar tu cita.
        </p>
        <p style="font-weight: 700; color: var(--red); margin-bottom: 25px; font-size: 1.05rem; letter-spacing: 0.5px;">
          * Consulta inicial gratuita.
        </p>
        <div class="btn-group">
          <a href="#contacto" class="btn btn-red"><span>Agendar una cita</span></a>
          <a href={`tel:${PHONE_HREF}`} class="btn btn-phone">📞 Llamar: {PHONE}</a>
          <a href={`https://wa.me/${PHONE_HREF}?text=Hola%20Marilyn%2C%20necesito%20notarizar%20un%20documento%20en%20Newark.`} target="_blank" class="btn btn-wa">💬 Hablar por WhatsApp</a>
        </div>
      </div>
    </div>

    <!-- Seccion 1: Cerca de ti -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;">
        <div>
          <h2 class="info-title" style="font-size: 1.8rem; margin-bottom: 25px;">
            ¿Buscas una Notaría Cerca de Ti en Newark?
          </h2>
          <p class="info-text">
            Cuando necesitas firmar o notarizar un documento, probablemente quieres encontrar un servicio cercano, confiable y que pueda atenderte sin complicaciones.
          </p>
          <p class="info-text">
            MAPA Business ofrece servicio de <strong>Notary Public en Newark, NJ</strong>, para clientes que necesitan completar un acto notarial y prefieren recibir atención en español.
          </p>
          <div class="btn-group" style="margin-top: 25px;">
            <a href={`https://wa.me/${PHONE_HREF}?text=Hola%20Marilyn%2C%20quisiera%20consultar%20disponibilidad%20para%20notaria.`} target="_blank" class="btn btn-red">Consultar disponibilidad</a>
          </div>
        </div>
        <div style="border: 1px solid rgba(128,128,128,0.15); padding: 35px; border-radius: 12px;">
          <h3 class="info-title" style="font-size: 1.25rem; margin-bottom: 20px;">Antes de visitarnos, puedes comunicarte para:</h3>
          <ul style="list-style-type: none; padding-left: 0; display: flex; flex-direction: column; gap: 12px;">
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Confirmar si podemos realizar la notarización que necesitas.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Saber qué identificación debes llevar.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Verificar si deben presentarse otros firmantes.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Conocer si necesitas testigos.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Coordinar una cita y resolver dudas generales.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Qué hace un Notary Public -->
    <section style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 900px; margin: 0 auto; padding: 0 40px; text-align: center;">
        <h2 class="section-title" style="margin-bottom: 30px;">
          ¿Qué Hace un <span>Notary Public</span> en New Jersey?
        </h2>
        <p style="font-size: 1.05rem; line-height: 1.8; margin-bottom: 20px; opacity: 0.9;">
          Un <strong>Notary Public de New Jersey</strong> actúa como un testigo imparcial autorizado para realizar determinados actos notariales.
        </p>
        <p style="font-size: 0.95rem; line-height: 1.7; opacity: 0.85; margin-bottom: 20px;">
          Dependiendo del documento y del tipo de acto solicitado, el Notary Public puede verificar la identidad del firmante, presenciar una firma, recibir un reconocimiento de firma o administrar un juramento o afirmación.
        </p>
        <p style="font-size: 0.95rem; line-height: 1.7; opacity: 0.85; margin-bottom: 20px;">
          El propósito del acto notarial es ayudar a verificar la identidad del firmante y documentar correctamente el acto realizado.
        </p>
        <p style="font-size: 0.95rem; font-weight: 700; color: var(--red); line-height: 1.7;">
          * Un Notary Public no reemplaza a un abogado y no determina qué documento legal debes utilizar.
        </p>
      </div>
    </section>

    <!-- Documentos que requieren notarización -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
        <h2 class="section-title" style="margin-bottom: 50px;">
          Documentos que Pueden Requerir <span>Notarización</span>
        </h2>
        <p class="section-sub" style="margin-bottom: 40px;">
          Las necesidades de cada persona son diferentes. Algunos documentos que comúnmente pueden presentarse ante un Notary Public incluyen:
        </p>
        <div class="notary-doc-grid">
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-declaraciones.jpg" alt="Declaraciones juradas" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Declaraciones juradas</h3>
              <p>Documentos en los que una persona realiza una declaración bajo juramento o afirmación.</p>
            </div>
          </div>
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-poderes.jpg" alt="Poderes Notariales" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Poderes</h3>
              <p>Determinados poderes pueden requerir una firma notarizada. Si cuentas con el documento correspondiente, puedes consultarnos sobre el acto notarial requerido.</p>
              <a href={`${cityServiceLinkPrefix}newark/poderes-notariales/`} class="notary-doc-link">Ver Poderes Notariales en Newark →</a>
            </div>
          </div>
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-autorizaciones.jpg" alt="Autorizaciones Notarizadas" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Autorizaciones</h3>
              <p>Algunas autorizaciones escritas pueden requerir notarización dependiendo del propósito y de la institución que solicita el documento.</p>
            </div>
          </div>
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-contratos.jpg" alt="Contratos y acuerdos" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Contratos y acuerdos</h3>
              <p>Determinados contratos o acuerdos privados pueden incluir firmas que deben ser reconocidas o notarizadas.</p>
            </div>
          </div>
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-comerciales.jpg" alt="Documentos comerciales" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Documentos comerciales</h3>
              <p>Empresas y pequeños negocios pueden necesitar notarizaciones relacionadas con diferentes documentos corporativos o comerciales.</p>
            </div>
          </div>
          <div class="notary-doc-card">
            <div class="notary-doc-img-wrap">
              <img src="/images/services/notary-internacional.jpg" alt="Notarización para uso internacional" class="notary-doc-img" loading="lazy" />
            </div>
            <div class="notary-doc-body">
              <h3>Uso internacional</h3>
              <p>Algunos documentos destinados a utilizarse fuera de EE.UU. pueden requerir notarización y posteriormente procesos de apostilla. Consulta previamente qué requisito solicita la institución que los recibirá.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Notary en espanol -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;">
        <div style="border: 1px solid rgba(128,128,128,0.15); padding: 35px; border-radius: 12px;">
          <h3 class="info-title" style="font-size: 1.25rem; margin-bottom: 20px;">En nuestra oficina te explicamos:</h3>
          <ul style="list-style-type: none; padding-left: 0; display: flex; flex-direction: column; gap: 12px;">
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Cómo funciona nuestro servicio.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Qué debes traer a tu cita.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Qué identificación puedes presentar.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Quién debe estar presente.
            </li>
            <li style="display: flex; gap: 10px; font-size: 0.95rem; line-height: 1.4;">
              <span style="color: var(--red);">✓</span> Qué información necesitamos antes de realizar el acto notarial.
            </li>
          </ul>
        </div>
        <div>
          <h2 class="info-title" style="font-size: 1.8rem; margin-bottom: 25px;">
            Notary Public en Español en Newark, NJ
          </h2>
          <p class="info-text">
            Realizar un trámite puede resultar más sencillo cuando puedes explicar lo que necesitas en tu propio idioma.
          </p>
          <p class="info-text">
            En MAPA Business ofrecemos <strong>atención en español para servicios de Notary Public en Newark</strong>. Nuestra atención busca que comprendas claramente el proceso de notarización que vamos a realizar.
          </p>
        </div>
      </div>
    </section>

    <!-- Qué necesito -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
        <h2 class="section-title" style="margin-bottom: 50px;">
          ¿Qué Necesito para <span>Notarizar un Documento</span> en Newark?
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
          <div style="border: 1px solid rgba(128,128,128,0.15); padding: 25px; border-radius: 8px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 10px; color: var(--red);">1. Traer el documento completo</h3>
            <p style="font-size: 0.85rem; line-height: 1.5; opacity: 0.85;">Trae todas las páginas correspondientes al documento, incluso si solamente una sección requiere una firma.</p>
          </div>
          <div style="border: 1px solid rgba(128,128,128,0.15); padding: 25px; border-radius: 8px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 10px; color: var(--red);">2. Presentar identificación</h3>
            <p style="font-size: 0.85rem; line-height: 1.5; opacity: 0.85;">El Notary Public debe poder verificar adecuadamente la identidad del firmante. Comunícate antes si tienes dudas de la identificación.</p>
          </div>
          <div style="border: 1px solid rgba(128,128,128,0.15); padding: 25px; border-radius: 8px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 10px; color: var(--red);">3. Confirmar quién debe estar presente</h3>
            <p style="font-size: 0.85rem; line-height: 1.5; opacity: 0.85;">La persona cuya firma será notarizada normalmente debe participar personalmente en el acto notarial correspondiente.</p>
          </div>
          <div style="border: 1px solid rgba(128,128,128,0.15); padding: 25px; border-radius: 8px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 10px; color: var(--red);">4. Verificar si necesitas testigos</h3>
            <p style="font-size: 0.85rem; line-height: 1.5; opacity: 0.85;">Algunos documentos requieren testigos adicionales, dependiendo de las instrucciones de la institución que lo solicita.</p>
          </div>
          <div style="border: 1px solid rgba(128,128,128,0.15); padding: 25px; border-radius: 8px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1rem; margin-bottom: 10px; color: var(--red);">5. Revisar antes de firmar</h3>
            <p style="font-size: 0.85rem; line-height: 1.5; opacity: 0.85;">No asumas que debes firmar previamente. Dependiendo del acto, puede ser necesario firmar en presencia del Notary Public.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo funciona -->
    <section style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
        <h2 class="section-title" style="margin-bottom: 50px;">
          ¿Cómo Funciona Nuestro Servicio de <span>Notary Public</span> en Newark?
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px;">
          <div style="text-align: center; padding: 15px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 15px;">1</div>
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.95rem; margin-bottom: 8px;">Contáctanos</h4>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.75;">Explícanos qué documento necesitas notarizar.</p>
          </div>
          <div style="text-align: center; padding: 15px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 15px;">2</div>
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.95rem; margin-bottom: 8px;">Confirma</h4>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.75;">Te indicamos qué debes llevar a tu cita.</p>
          </div>
          <div style="text-align: center; padding: 15px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 15px;">3</div>
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.95rem; margin-bottom: 8px;">Visítanos</h4>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.75;">Acude con tu documento, ID y participantes.</p>
          </div>
          <div style="text-align: center; padding: 15px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 15px;">4</div>
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.95rem; margin-bottom: 8px;">Verificación</h4>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.75;">El notario verificará la información y validez.</p>
          </div>
          <div style="text-align: center; padding: 15px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--red); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; margin: 0 auto 15px;">5</div>
            <h4 style="font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.95rem; margin-bottom: 8px;">Notarización</h4>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.75;">Se realiza el acto notarial y certificado.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comunidad y pequeños negocios -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 50px;">
        <div>
