---
// src/templates/CityTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities, type City } from '../data/cities';
import { services } from '../data/services';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';

interface Props {
  lang: 'es' | 'en';
  city: City;
}

const { lang, city } = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es'
  ? `${WEBSITE}/service-areas/${city.slug}/`
  : `${WEBSITE}/en/service-areas/${city.slug}/`;
const currentPath = lang === 'es'
  ? `/service-areas/${city.slug}/`
  : `/en/service-areas/${city.slug}/`;

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

const cityName = city.name;
const countyName = city.county;

const isNewarkEs = city.slug === 'newark' && lang === 'es';
const isPatersonEs = city.slug === 'paterson' && lang === 'es';
const isElizabethEs = city.slug === 'elizabeth' && lang === 'es';

let title = lang === 'es'
  ? `Servicios Financieros y Migratorios en ${cityName}, NJ | MAPA Business`
  : `Financial & Immigration Services in ${cityName}, NJ | MAPA Business`;

let description = lang === 'es'
  ? `MAPA Business & Financial Services en ${cityName}, New Jersey. Notaría, taxes, permisos de trabajo, seguros, ITIN y más. Marilyn Paladinez: ${PHONE}.`
  : `MAPA Business & Financial Services in ${cityName}, New Jersey. Notary, taxes, work permits, insurance, ITIN, and more. Marilyn Paladinez: ${PHONE}.`;

if (isNewarkEs) {
  title = "Servicios para Latinos en Newark, NJ | MAPA Business";
  description = "Servicios para latinos en Newark, NJ: Notaría, ITIN, taxes, bookkeeping, traducciones, LLC y trámites en español con Marilyn Paladinez en 20 Bloomfield Pl.";
} else if (isPatersonEs) {
  title = "Servicios para Latinos en Paterson, NJ | MAPA Business";
  description = "Servicios para latinos en Paterson, NJ: Notaría, ITIN, taxes, bookkeeping, traducciones, LLC y trámites en español con Marilyn Paladinez para Passaic County.";
} else if (isElizabethEs) {
  title = "Servicios para Latinos en Elizabeth, NJ | MAPA Business";
  description = "¿Necesitas ayuda con un trámite en Elizabeth, NJ? MAPA Business & Financial Services ofrece atención en español para latinos, familias, inmigrantes y pequeños negocios. Llama o envía un mensaje hoy.";
}


const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "FinancialService",
      "@id": `${canonical}#localbusiness`,
      "name": "MAPA Business & Financial Services LLC",
      "description": description,
      "url": canonical,
      "telephone": PHONE_HREF,
      "logo": `${WEBSITE}/logo-mapa.png`,
      "image": `${WEBSITE}/marilin2.webp`,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "20 Bloomfield Pl",
        "addressLocality": "Newark",
        "addressRegion": "NJ",
        "postalCode": "07104",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.7534611,
        "longitude": -74.1696199
      },
      "areaServed": {
        "@type": "City",
        "name": cityName,
        "addressRegion": "NJ",
        "sameAs": `https://www.wikidata.org/wiki/${city.wikidataId}`
      }
    }
  ]
};

const homeLink = lang === 'es' ? '/' : '/en/';
const cityServiceLinkPrefix = lang === 'es' ? '/service-areas/' : '/en/service-areas/';
const localDescription = t(`cities.${city.slug}.desc`) || city.localCommunityDescription;

const otherCities = cities.filter((c) => c.slug !== city.slug);

// Custom Newark service texts
const newarkServicesInfo: Record<string, { title: string; desc: string }> = {
  notaria: {
    title: "Notaría Pública en Newark, NJ",
    desc: "¿Necesitas notarizar un documento o estás buscando una Notaría Pública en Newark, NJ que pueda atenderte en español? Ofrecemos servicios notariales para diferentes tipos de documentos y firmas, de acuerdo con las funciones permitidas para un Notary Public en New Jersey."
  },
  traducciones: {
    title: "Traducciones en Newark",
    desc: "Ayudamos con traducciones de documentos del español al inglés y del inglés al español para diferentes trámites personales y administrativos. Consulta qué documentos puedes traducir y qué información necesitas proporcionar."
  },
  "poderes-notariales": {
    title: "Poderes Notariales en Newark",
    desc: "Si necesitas información sobre preparación documental y notarización relacionada con un poder, podemos orientarte sobre nuestro servicio y los documentos necesarios. Nuestro servicio no sustituye la asesoría de un abogado cuando la situación requiere asesoramiento legal."
  },
  "permisos-de-trabajo": {
    title: "Permisos de Trabajo en Newark",
    desc: "Brindamos apoyo documental para personas que necesitan información y asistencia relacionada con solicitudes o renovaciones de permiso de trabajo. Conoce qué documentos necesitas preparar y cómo funciona nuestro servicio."
  },
  "licencias-de-conducir": {
    title: "Licencias de Conducir en Newark",
    desc: "¿Necesitas organizar los documentos para solicitar tu licencia de conducir en New Jersey? Te ayudamos a entender los documentos requeridos y a prepararte para el proceso correspondiente ante el NJ MVC."
  },
  itin: {
    title: "ITIN en Newark",
    desc: "Si necesitas solicitar o renovar un Individual Taxpayer Identification Number (ITIN), podemos ayudarte con la preparación de la documentación correspondiente. El ITIN es utilizado por personas que necesitan un número de identificación tributaria pero no son elegibles para obtener un Social Security Number."
  },
  taxes: {
    title: "Preparación de Taxes en Newark",
    desc: "Ofrecemos preparación de declaraciones de impuestos para individuos, familias, trabajadores independientes y pequeños negocios. Revisamos tu situación y te indicamos qué documentos debes presentar para preparar correctamente tu declaración."
  },
  bookkeeping: {
    title: "Bookkeeping y Contabilidad en Newark",
    desc: "Mantener organizada la información financiera de un negocio es fundamental para conocer ingresos, gastos y resultados. Nuestro servicio de bookkeeping y contabilidad está dirigido a emprendedores y pequeños negocios que necesitan mantener sus registros financieros organizados durante el año."
  },
  "seguros-de-auto": {
    title: "Seguros de Auto en Newark",
    desc: "Si necesitas cotizar un seguro de automóvil en New Jersey, podemos ayudarte a revisar las opciones disponibles según tu situación. Te indicamos qué información debes proporcionar para obtener una cotización."
  },
  "seguros-de-salud": {
    title: "Seguros de Salud en Newark",
    desc: "Te ayudamos a conocer alternativas de cobertura médica y a entender las opciones que puedan estar disponibles según tus necesidades."
  },
  "seguros-de-vida": {
    title: "Seguros de Vida en Newark",
    desc: "Conoce diferentes alternativas de seguro de vida para proteger financieramente a tu familia. Podemos ayudarte a revisar opciones de acuerdo con tus necesidades, presupuesto y objetivos de protección."
  },
  "doble-nacionalidad": {
    title: "Doble Nacionalidad en Newark",
    desc: "Brindamos orientación documental para personas que necesitan organizar documentos relacionados con procesos de doble nacionalidad. Te ayudamos a identificar los documentos que pueden ser necesarios para comenzar el proceso correspondiente."
  },
  divorcios: {
    title: "Divorcios sin Disputa en Newark",
    desc: "Ofrecemos asistencia con preparación de documentos para determinados procesos de divorcio sin disputa. MAPA Business & Financial Services LLC no es un bufete de abogados y no proporciona representación ni asesoría legal."
  },
  matrimonios: {
    title: "Matrimonios en Newark",
    desc: "Ayudamos con orientación y preparación de documentos relacionados con determinados trámites de matrimonio civil y documentación posterior."
  }
};

// Custom Paterson service texts
const patersonServicesInfo: Record<string, { title: string; desc: string }> = {
  notaria: {
    title: "Notaría Pública para Paterson, NJ",
    desc: "¿Necesitas notarizar un documento o buscas servicios de Notaría Pública que atiendan a la comunidad de Paterson en español? Ofrecemos servicios notariales confiables para firmas y documentos bajo las regulaciones oficiales de New Jersey."
  },
  traducciones: {
    title: "Traducciones en Paterson",
    desc: "Traducciones certificadas y precisas de documentos del español al inglés y del inglés al español para trámites personales, administrativos y escolares en Paterson y Passaic County."
  },
  "poderes-notariales": {
    title: "Poderes Notariales para Paterson",
    desc: "Orientación documental y notarización para cartas de poder y autorizaciones. Te ayudamos a preparar la documentación requerida con total claridad y validez formal en NJ."
  },
  "permisos-de-trabajo": {
    title: "Permisos de Trabajo en Paterson",
    desc: "Asistencia y preparación documental para solicitudes y renovaciones de permiso de trabajo en Estados Unidos para familias y trabajadores inmigrantes de Paterson."
  },
  "licencias-de-conducir": {
    title: "Licencias de Conducir para Paterson",
    desc: "¿Necesitas tramitar tu licencia de conducir en New Jersey? Te asesoramos en la organización de los 6 puntos de identificación y requisitos exigidos por el NJ MVC."
  },
  itin: {
    title: "Trámite de ITIN en Paterson",
    desc: "Solicitud y renovación de Individual Taxpayer Identification Number (ITIN) para personas que necesitan declarar impuestos y no cuentan con Seguro Social en Passaic County."
  },
  taxes: {
    title: "Preparación de Taxes en Paterson",
    desc: "Declaración de impuestos personales y comerciales para familias, trabajadores independientes (1099/W-2) y pequeños negocios en Paterson, NJ con Marilyn Paladinez."
  },
  bookkeeping: {
    title: "Bookkeeping y Contabilidad para Negocios en Paterson",
    desc: "Organización contable mensual de ingresos, gastos y conciliaciones bancarias para que tu negocio o LLC en Paterson mantenga finanzas claras y en orden."
  },
  "seguros-de-auto": {
    title: "Seguros de Auto en Paterson",
    desc: "Cotizaciones y asesoría en pólizas de seguro de auto en New Jersey para conductores y familias de Paterson con las mejores coberturas y tarifas competitivas."
  },
  "seguros-de-salud": {
    title: "Seguros de Salud en Paterson",
    desc: "Orientación para acceder a planes de seguro médico y cobertura de salud accesibles para ti y tu familia en el área de Paterson y Passaic County."
  },
  "seguros-de-vida": {
    title: "Seguros de Vida en Paterson",
    desc: "Protege el futuro de tus seres queridos con pólizas de seguro de vida a término o permanentes adaptadas a tu presupuesto y necesidades familiares en Paterson."
  },
  "doble-nacionalidad": {
    title: "Doble Nacionalidad en Paterson",
    desc: "Revisión y organización de actas, apostillas y documentación oficial para procesos de doble nacionalidad para la diversa comunidad hispana de Paterson."
  },
  divorcios: {
    title: "Divorcios de Mutuo Acuerdo en Paterson",
    desc: "Preparación documental para procesos de divorcio sin disputa o mutuo acuerdo en New Jersey. Servicio administrativo claro y transparente sin costos excesivos."
  },
  matrimonios: {
    title: "Matrimonios Civiles en Paterson",
    desc: "Asistencia en los requisitos, licencias matrimoniales y documentación necesaria para ceremonias civiles de matrimonio en New Jersey."
  }
};

// Custom Elizabeth service texts
const elizabethServicesInfo: Record<string, { title: string; desc: string }> = {
  notaria: {
    title: "Notaría Pública para Elizabeth, NJ",
    desc: "¿Necesitas notarizar un documento o buscas una Notaría Pública que atienda en español? Ofrecemos servicios notariales confiables para declaraciones juradas, poderes y documentos oficiales en New Jersey."
  },
  traducciones: {
    title: "Traducciones Certificadas en Elizabeth",
    desc: "Traducciones oficiales y certificadas de documentos del español al inglés y del inglés al español para trámites de inmigración, escuelas, cortes y gestiones personales en Elizabeth y Union County."
  },
  "poderes-notariales": {
    title: "Poderes Notariales para Elizabeth",
    desc: "Orientación en la preparación documental y notarización para cartas de poder, autorizaciones de viaje para menores y mandatos para trámites en EE.UU. o en tu país de origen."
  },
  "permisos-de-trabajo": {
    title: "Permisos de Trabajo en Elizabeth",
    desc: "Asistencia y organización de paquetes documentales para solicitudes iniciales y renovaciones de permiso de trabajo ante USCIS para trabajadores y familias en Elizabeth."
  },
  "licencias-de-conducir": {
    title: "Licencias de Conducir para Elizabeth",
    desc: "¿Vas a tramitar tu licencia de conducir en NJ MVC? Te ayudamos a organizar los 6 puntos de identificación, comprobantes de domicilio y citas requeridas."
  },
  itin: {
    title: "Trámite y Renovación de ITIN en Elizabeth",
    desc: "Solicitud y renovación del Individual Taxpayer Identification Number (ITIN) con el IRS para que puedas declarar impuestos, abrir cuentas bancarias y construir crédito en USA sin Seguro Social."
  },
  taxes: {
    title: "Preparación de Taxes en Elizabeth",
    desc: "Declaración de impuestos federales y estatales para individuos, familias, trabajadores 1099/W-2 y pequeños negocios en Elizabeth con Marilyn Paladinez. Maximizamos tus deducciones legales."
  },
  bookkeeping: {
    title: "Bookkeeping y Contabilidad para Negocios en Elizabeth",
    desc: "Contabilidad mensual organizada de ingresos, gastos y conciliaciones bancarias para que tu negocio, restaurante, bodega o LLC en Elizabeth mantenga finanzas claras y en regla."
  },
  "seguros-de-auto": {
    title: "Seguros de Auto en Elizabeth",
    desc: "Cotizaciones personalizadas de seguro de auto en New Jersey para conductores y familias de Elizabeth. Encuentra la cobertura obligatoria y extendida al mejor precio del mercado."
  },
  "seguros-de-salud": {
    title: "Seguros de Salud en Elizabeth",
    desc: "Asesoría para inscribirte en planes de seguro médico a través de Get Covered New Jersey o cobertura privada con subsidios para ti y tu familia en Elizabeth."
  },
  "seguros-de-vida": {
    title: "Seguros de Vida en Elizabeth",
    desc: "Protege la tranquilidad y el futuro financiero de tus seres queridos con pólizas de seguro de vida a término o permanentes adaptadas a tu presupuesto."
  },
  "doble-nacionalidad": {
    title: "Doble Nacionalidad en Elizabeth",
    desc: "Revisión documental, legalizaciones y preparación de actas para trámites consulares y registro de doble ciudadanía para la comunidad hispana de Elizabeth."
  },
  divorcios: {
    title: "Divorcios de Mutuo Acuerdo en Elizabeth",
    desc: "Preparación y organización de documentos para procesos de divorcio no disputado en New Jersey, de forma clara, confidencial y sin complicaciones innecesarias."
  },
  matrimonios: {
    title: "Matrimonios Civiles para Elizabeth",
    desc: "Orientación en los requisitos legales, licencias matrimoniales municipales y organización de tu ceremonia civil en New Jersey."
  }
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeSection="areas-de-servicio"
  currentPath={currentPath}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <a href={homeLink}>{t("nav.home")}</a>
    <span>›</span>
    <span>{cityName}</span>
  </nav>

  {isNewarkEs ? (
    <!-- ============================================== -->
    <!-- MAQUETA EXCLUSIVA PARA NEWARK ES               -->
    <!-- ============================================== -->
    <div class="city-hero">
      <div class="city-hero-inner">
        <div class="city-tag">📍 Sede Principal • Newark, New Jersey</div>
        
        <h1>
          Servicios para Latinos en <span style="color: var(--red);">Newark, NJ</span>
        </h1>

        <p class="city-hero-intro">
          En <strong>MAPA Business & Financial Services LLC</strong> ayudamos a la comunidad latina de <strong>Newark, New Jersey</strong>, a encontrar en un mismo lugar orientación, asistencia administrativa y soluciones para diferentes necesidades personales, familiares y empresariales.
        </p>

        <p style="font-size: 1.02rem; line-height: 1.7; max-width: 820px; margin: 0 auto 18px; opacity: 0.9;">
          Nuestra oficina en Newark está dirigida por <strong>Marilyn Paladinez</strong>, fundadora de MAPA Business & Financial Services LLC, con un enfoque especialmente pensado para migrantes, familias, trabajadores independientes, emprendedores y propietarios de pequeños negocios que necesitan realizar trámites en Estados Unidos de una manera más clara, organizada y fácil de entender.
        </p>

        <p style="font-size: 0.95rem; line-height: 1.65; max-width: 800px; margin: 0 auto 25px; opacity: 0.85;">
          Sabemos que muchos procesos pueden resultar complicados cuando existen dudas sobre documentos, formularios, requisitos, impuestos, negocios o procedimientos administrativos. Por eso, en MAPA buscamos que cada cliente pueda explicar primero su situación, entender sus opciones y saber cuáles son los próximos pasos antes de comenzar un trámite.
        </p>

        <div class="city-hero-features">
          <div class="hero-feature-item">
            <span class="feature-icon">📑</span>
            <div>
              <strong>Servicios Notariales y Documentales</strong>
              Notaría Pública, Poderes, ITIN, Traducciones Certificadas y Permisos de Trabajo.
            </div>
          </div>
          <div class="hero-feature-item">
            <span class="feature-icon">📊</span>
            <div>
              <strong>Respaldo Fiscal y Empresarial</strong>
              Declaración de Taxes, Bookkeeping, LLCs y Seguros de Auto, Salud y Vida.
            </div>
          </div>
          <div class="hero-feature-item">
            <span class="feature-icon">🤝</span>
            <div>
              <strong>Atención 100% en Español en Newark</strong>
              Explicación paso a paso sin barreras de idioma con Marilyn Paladinez.
            </div>
          </div>
        </div>

        <div class="hero-trust-pill">
          <span>✨</span> Consulta Inicial 100% Gratuita y Sin Compromiso · 20 Bloomfield Pl, Newark, NJ
        </div>

        <div class="btn-group" style="margin-top: 25px;">
          <a href="#contacto" class="btn btn-red"><span>Solicitar Consulta</span></a>
          <a href={`tel:${PHONE_HREF}`} class="btn btn-phone">📞 Llamar: {PHONE}</a>
          <a href={`https://wa.me/${PHONE_HREF}?text=Hola%20Marilyn%2C%20necesito%20asesoria%20en%20Newark.`} target="_blank" class="btn btn-wa">💬 Hablar por WhatsApp</a>
        </div>
      </div>
    </div>

    <!-- Servicios disponibles en Newark -->
    <section class="services-section">
      <h2 class="section-title">
        <span>Servicios disponibles en</span> <span>Newark, New Jersey</span>
      </h2>
      <p class="section-sub">
        Encuentra el servicio que necesitas. Cada área cuenta con una página especializada donde puedes conocer requisitos, procesos, preguntas frecuentes y cómo podemos ayudarte en Newark.
      </p>

      <div class="services-grid">
        {services.map((service) => {
          const customInfo = newarkServicesInfo[service.slug];
          const serviceName = customInfo?.title || t(`services.${service.slug}.title`);
          const serviceDesc = customInfo?.desc || t(`services.${service.slug}.desc`);
          
          let btnText = "Ver servicio →";
          if (service.slug === 'notaria') btnText = "Ver servicio de Notaría en Newark →";
          else if (service.slug === 'traducciones') btnText = "Ver Traducciones en Newark →";
          else if (service.slug === 'poderes-notariales') btnText = "Ver Poderes Notariales en Newark →";
          else if (service.slug === 'permisos-de-trabajo') btnText = "Ver Permisos de Trabajo en Newark →";
          else if (service.slug === 'licencias-de-conducir') btnText = "Ver Licencias de Conducir en Newark →";
          else if (service.slug === 'itin') btnText = "Ver servicio de ITIN en Newark →";
          else if (service.slug === 'taxes') btnText = "Ver Taxes en Newark →";
          else if (service.slug === 'bookkeeping') btnText = "Ver Bookkeeping en Newark →";
          else if (service.slug === 'seguros-de-auto') btnText = "Ver Seguros de Auto en Newark →";
          else if (service.slug === 'seguros-de-salud') btnText = "Ver Seguros de Salud en Newark →";
          else if (service.slug === 'seguros-de-vida') btnText = "Ver Seguros de Vida en Newark →";
          else if (service.slug === 'doble-nacionalidad') btnText = "Ver Doble Nacionalidad en Newark →";
          else if (service.slug === 'divorcios') btnText = "Ver Divorcios en Newark →";
          else if (service.slug === 'matrimonios') btnText = "Ver Matrimonios en Newark →";

          return (
            <a href={`${cityServiceLinkPrefix}newark/${service.slug}/`} class="service-card">
              <div class="service-card-img-wrap">
                <img src={service.image} alt={serviceName} class="service-card-img" loading="lazy" />
                <span class="service-icon-badge">{service.icon}</span>
              </div>
              <div class="service-card-body">
                <h3 class="card-title">{serviceName}</h3>
                <p class="card-desc">{serviceDesc}</p>
                <div class="card-link">{btnText}</div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Un centro de servicios para la comunidad latina & Atención en español -->
    <section class="city-info" style="padding: 80px 0; border-top: 1px solid rgba(128,128,128,0.15);">
      <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; margin-bottom: 50px;">
          <div style="border: 1px solid rgba(204,0,0,0.2); padding: 36px; border-radius: 14px; background: rgba(255,255,255,0.02); box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
            <div style="display: inline-block; background: rgba(204,0,0,0.1); color: var(--red); font-weight: 700; font-size: 0.72rem; letter-spacing: 1.5px; text-transform: uppercase; padding: 5px 14px; border-radius: 20px; margin-bottom: 18px;">🏢 Punto de Encuentro Latino</div>
            <h2 class="info-title" style="font-size: 1.6rem; line-height: 1.3; margin-bottom: 20px;">
              Un centro de servicios para la comunidad latina de Newark
            </h2>
            <p class="info-text">
              Newark es una de las ciudades más diversas de New Jersey y hogar de miles de familias, trabajadores y emprendedores de origen latino. En MAPA Business & Financial Services entendemos que muchas personas necesitan algo más que un servicio específico: necesitan encontrar un lugar de confianza donde puedan hacer preguntas, recibir información en español y resolver diferentes necesidades sin tener que acudir a múltiples oficinas.
            </p>
            <p class="info-text">
              Por eso hemos desarrollado un modelo de <strong>multiservicios para latinos en Newark, NJ</strong>, donde nuestros clientes pueden encontrar asistencia en diferentes áreas relacionadas con documentos, negocios, impuestos, finanzas, notarizaciones y trámites administrativos.
            </p>
            <p class="info-text" style="color: var(--red); font-weight: 600; margin-bottom: 0;">
