---
// src/templates/BlogPostTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, type Post } from '../data/posts';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';

interface Props {
  lang: 'es' | 'en';
  post: Post;
}

const { lang, post } = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es' ? `${WEBSITE}/blog/${post.slug}/` : `${WEBSITE}/en/blog/${post.slug}/`;
const currentPath = lang === 'es' ? `/blog/${post.slug}/` : `/en/blog/${post.slug}/`;

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

const postTitle = lang === 'es' ? post.title.es : post.title.en;
const postExcerpt = lang === 'es' ? post.excerpt.es : post.excerpt.en;
const postCategory = lang === 'es' ? post.category.es : post.category.en;
const postContent = lang === 'es' ? post.content.es : post.content.en;
const postTip = post.tip ? (lang === 'es' ? post.tip.es : post.tip.en) : null;

// Filter related posts (exclude current)
const relatedPosts = posts.filter(p => p.slug !== post.slug).slice(0, 2);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": `${postTitle} | Blog MAPA Business`,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#blogpost`,
      "headline": postTitle,
      "image": `${WEBSITE}${post.image}`,
      "genre": postCategory,
      "url": canonical,
      "datePublished": post.date,
      "dateCreated": post.date,
      "dateModified": post.date,
      "description": postExcerpt,
      "author": {
        "@type": "Person",
        "name": post.author,
        "jobTitle": lang === 'es' ? "Estratega Financiera para Inmigrantes" : "Financial Strategist for Immigrants",
        "url": lang === 'es' ? `${WEBSITE}/marilyn-paladinez/` : `${WEBSITE}/en/marilyn-paladinez/`
      },
      "publisher": {
        "@type": "Organization",
        "name": "MAPA Business & Financial Services LLC",
        "url": WEBSITE,
        "logo": `${WEBSITE}/favicon.jpg`
      }
    }
  ]
};

const homeLink = lang === 'es' ? '/' : '/en/';
const blogLink = lang === 'es' ? '/blog/' : '/en/blog/';
const blogPostLinkPrefix = lang === 'es' ? '/blog/' : '/en/blog/';
---

<BaseLayout
  lang={lang}
  title={`${postTitle} | Blog MAPA Business`}
  description={postExcerpt}
  canonical={canonical}
  schema={schema}
  activeSection="blog"
  currentPath={currentPath}
>
  <!-- Reading Progress Bar -->
  <div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
  </div>

  <!-- Breadcrumb -->
  <div class="breadcrumb" aria-label="Ruta de navegación">
    <a href={homeLink}>{t("nav.home")}</a>
    <span>›</span>
    <a href={blogLink}>{t("blog.hub_title")}</a>
    <span>›</span>
    <span>{postTitle}</span>
  </div>

  <!-- Article Container -->
  <article class="article-container">
    <header class="article-header">
      <span class="article-badge">{postCategory}</span>
      <h1 class="article-title">{postTitle}</h1>
      
      <div class="article-meta">
        <div class="article-meta-item">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>{post.date}</span>
        </div>
        <div class="article-meta-item">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>{post.author}</span>
        </div>
        <div class="article-meta-item">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span>{post.readingTime} {lang === 'es' ? 'min de lectura' : 'min read'}</span>
        </div>
      </div>
    </header>

    <div class="article-image-wrap">
      <img class="article-image" src={post.image} alt={postTitle} />
    </div>

    <!-- Pre-rendered body content based on language -->
    <div class="article-body" set:html={postContent} />

    <!-- Legal Disclaimer -->
    <div class="blog-disclaimer">
      <p>
        {lang === 'es' ? (
          <>
            <strong>Importante:</strong> MAPA Business & Financial Services LLC es una agencia independiente de preparación de documentos y servicios de consultoría financiera. No somos abogados ni un bufete jurídico, y no brindamos asesoría legal ni representación legal de ningún tipo. La información compartida en este sitio web es de carácter puramente informativo. Si requiere asesoría legal específica para su situación, le recomendamos consultar a un abogado calificado.
          </>
        ) : (
          <>
            <strong>Important:</strong> MAPA Business & Financial Services LLC is an independent document preparation and financial consulting agency. We are not attorneys or a law firm, and we do not provide legal advice or legal representation of any kind. The information shared on this website is for purely informational purposes. If you require specific legal advice for your situation, we recommend consulting a qualified attorney.
          </>
        )}
      </p>
    </div>

    <!-- Custom Tip Callout -->
    {postTip && (
      <div class="tip-box">
        <div class="tip-box-title">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          <span>{t("blog.tip_title") || "Consejo de Marilyn"}</span>
        </div>
        <div class="tip-box-content">
          <p>{postTip}</p>
        </div>
      </div>
    )}

    <!-- Share Buttons -->
    <div class="share-container">
      <span class="share-title">{t("blog.share_title") || "Compartir este artículo"}</span>
      <div class="share-buttons">
        <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(postTitle + ' - ' + canonical)}`} target="_blank" class="share-btn share-wa" aria-label="Compartir en WhatsApp">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" class="share-btn share-fb" aria-label="Compartir en Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <button class="share-btn share-copy" onclick="copyArticleLink(this)" aria-label="Copiar Enlace">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        </button>
      </div>
    </div>

    <!-- Author Profile -->
    <div class="author-profile">
      <img class="author-img" src="/marilin2.webp" alt="Marilyn Paladinez" />
      <div class="author-info">
        <div class="author-name">{post.author}</div>
        <p class="author-desc-es">
          {lang === 'es'
            ? 'Escrito y revisado por Marilyn Paladinez, fundadora de MAPA Business & Financial Services LLC. Marilyn es estratega financiera y especialista en taxes e ITIN.'
            : 'Written and reviewed by Marilyn Paladinez, founder of MAPA Business & Financial Services LLC. Marilyn is a financial strategist and specialist in taxes and ITIN.'}
        </p>
      </div>
    </div>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <div class="related-section">
        <h3 class="related-title">{lang === 'es' ? 'Artículos Relacionados' : 'Related Articles'}</h3>
        <div class="related-grid">
          {relatedPosts.map(p => {
            const relTitle = lang === 'es' ? p.title.es : p.title.en;
            const readLinkText = lang === 'es' ? 'Leer más →' : 'Read more →';
            return (
              <a href={`${blogPostLinkPrefix}${p.slug}/`} class="related-card">
                <div class="related-image-wrap">
                  <img src={p.image} alt={relTitle} />
                </div>
                <div class="related-content">
                  <h4>{relTitle}</h4>
                  <span class="related-link-text">{readLinkText}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Article CTA Box -->
    <div class="article-cta">
      <h3>{t("blog.cta_title") || "¿Necesitas Asesoría Personalizada?"}</h3>
      <p>{t("blog.cta_desc") || "En MAPA te ayudamos con tus trámites migratorios, fiscales y de negocios. Agenda tu primera consulta hoy y resuelve todas tus dudas."}</p>
      <a href={`${homeLink}#contacto`} class="btn btn-red">{t("blog.cta_btn") || "📞 Agendar Cita"}</a>
    </div>
  </article>

  <!-- Client-side reading progress and link copy handler -->
  <script is:inline>
    // Copy link helper
    window.copyArticleLink = function(btn) {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const origIcon = btn.innerHTML;
        btn.innerHTML = `<span style="font-size: 0.8rem; font-weight: 700; color: #25d366;">COP!</span>`;
        setTimeout(() => {
          btn.innerHTML = origIcon;
        }, 2000);
      }).catch(err => {
        console.error('Error copying link:', err);
      });
    };

    // Scroll progress indicator
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('progressBar');
      if (bar) {
        bar.style.width = scrolled + "%";
      }
    });
  </script>
</BaseLayout>
