---
// src/templates/ServiceTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities } from '../data/cities';
import { services, type Service } from '../data/services';
import { serviceDetails } from '../data/serviceDetails';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';

interface Props {
  lang: 'es' | 'en';
  service: Service;
}

const { lang, service } = Astro.props;

const details = serviceDetails[service.slug]?.[lang] || '';

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es' 
  ? `${WEBSITE}/servicios/${service.slug}/` 
  : `${WEBSITE}/en/services/${service.slug}/`;
const currentPath = lang === 'es' 
  ? `/servicios/${service.slug}/` 
  : `/en/services/${service.slug}/`;

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

const serviceName = t(`services.${service.slug}.title`);
const serviceDesc = t(`services.${service.slug}.desc`);

const title = lang === 'es'
  ? `${serviceName} en New Jersey | MAPA Business`
  : `${serviceName} in New Jersey | MAPA Business`;

const description = lang === 'es'
  ? `Servicio profesional de ${serviceName} en New Jersey. Cobertura en Newark, Elizabeth, Paterson, Jersey City y más. Marilyn Paladinez: ${PHONE}.`
  : `Professional ${serviceName} services in New Jersey. Coverage in Newark, Elizabeth, Paterson, Jersey City, and more. Marilyn Paladinez: ${PHONE}.`;

// Schema JSON-LD
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      "name": `${serviceName} en New Jersey`,
      "description": description,
      "url": canonical,
      "provider": {
        "@type": service.schemaType || "FinancialService",
        "@id": `${WEBSITE}/#organization`,
        "name": "MAPA Business & Financial Services LLC",
        "telephone": PHONE_HREF,
        "image": `${WEBSITE}/marilin2.webp`,
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "20 Bloomfield Pl",
          "addressLocality": "Newark",
          "addressRegion": "NJ",
          "postalCode": "07104",
          "addressCountry": "US"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "New Jersey", "addressRegion": "NJ" },
        ...cities.map((city) => ({ "@type": "City", "name": city.name, "addressRegion": "NJ" }))
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": serviceName,
        "itemListElement": cities.map((city) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": lang === 'es' ? `${serviceName} en ${city.name}, NJ` : `${serviceName} in ${city.name}, NJ`,
            "url": lang === 'es'
              ? `${WEBSITE}/service-areas/${city.slug}/${service.slug}/`
              : `${WEBSITE}/en/service-areas/${city.slug}/${service.slug}/`
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "mainEntity": service.faqs.map((faq, index) => {
        const question = t(`services.${service.slug}.faqs.${index}.q`, { city: lang === 'es' ? 'New Jersey' : 'New Jersey' });
        const answer = t(`services.${service.slug}.faqs.${index}.a`, { city: lang === 'es' ? 'New Jersey' : 'New Jersey' });
        return {
          "@type": "Question",
          "name": question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": answer
          }
        };
      })
    }
  ]
};

const homeLink = lang === 'es' ? '/' : '/en/';
const cityServiceLinkPrefix = lang === 'es' ? '/service-areas/' : '/en/service-areas/';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  currentPath={currentPath}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <a href={homeLink}>{t("nav.home")}</a>
    <span>›</span>
    <a href={`${homeLink}#servicios`}>{t("nav.services")}</a>
    <span>›</span>
    <span>{serviceName}</span>
  </nav>

  <!-- Hero -->
  <div class="page-hero">
    <div class="page-tag">MAPA Business & Financial Services LLC</div>
    <div class="page-icon">{service.icon}</div>
    <h1>
      <span>{t("services.service_of")}</span> <span>{serviceName}</span> <span>{t("services.in_nj")}</span>
    </h1>
    <p class="page-intro">
      {serviceDesc}
    </p>
    <div class="btn-group">
      <a href={`tel:${PHONE_HREF}`} class="btn btn-red"><span>{t("contact.btn_call")}</span> {PHONE}</a>
      <a href={`https://wa.me/${PHONE_HREF}?text=Hola%20Marilyn%2C%20necesito%20${encodeURIComponent(serviceName)}.`} target="_blank" class="btn btn-wa">💬 WhatsApp</a>
    </div>
  </div>

  <!-- Detailed Service Info Section -->
  {details && (
    <div class="service-details-section">
      <div class="service-details-inner">
        <div class="service-rich-text" set:html={details} />
      </div>
    </div>
  )}

  <!-- Cities Spoke Links -->
  <div class="cities-section">
    <div class="cities-inner">
      <h2 class="section-label">
        <span>{t("services.cities_where")}</span> <span>{serviceName}</span>
      </h2>
      <p class="section-desc">
        {t("services.cities_desc")}
      </p>
      <div class="cities-grid">
        {cities.map((city) => (
          <a href={`${cityServiceLinkPrefix}${city.slug}/${service.slug}/`} class="city-card">
            <div>
              <div class="city-name">{city.name}</div>
              <div class="city-county">{city.county}</div>
            </div>
            <div class="city-link">{t("services.local_attention")}</div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="faq-section">
    <h2><span>{t("services.faq_title_prefix")}</span> &mdash; {serviceName}</h2>
    <dl>
      {service.faqs.map((faq, index) => {
        const question = t(`services.${service.slug}.faqs.${index}.q`, { city: lang === 'es' ? 'New Jersey' : 'New Jersey' });
        const answer = t(`services.${service.slug}.faqs.${index}.a`, { city: lang === 'es' ? 'New Jersey' : 'New Jersey' });
        return (
          <div class="faq-item">
            <dt>{question}</dt>
            <dd>{answer}</dd>
          </div>
        );
      })}
    </dl>
  </div>

  <!-- CTA Box -->
  <div class="cta-section">
    <h2>{t("services.cta_ready")}</h2>
    <p>{t("services.cta_doubts_desc")}</p>
    <a href={`${homeLink}#contacto`} class="btn-white">{t("about.btn_schedule")}</a>
  </div>
</BaseLayout>
