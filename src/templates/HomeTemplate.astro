---
// src/templates/HomeTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities } from '../data/cities';
import { services } from '../data/services';
import GoogleReviews from '../components/GoogleReviews.astro';
import esDict from '../../public/locales/es.json';
import enDict from '../../public/locales/en.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es' ? `${WEBSITE}/` : `${WEBSITE}/en/`;
const currentPath = lang === 'es' ? '/' : '/en/';

// Resolve dictionary
const dict = lang === 'es' ? esDict : enDict;

function t(key: string, variables?: Record<string, string>) {
  let val = key.split('.').reduce((prev, curr) => (prev ? prev[curr] : null), dict as any);
  if (typeof val === 'string' && variables) {
    for (const [k, v] of Object.entries(variables)) {
      val = val.replace(new RegExp(`{${k}}`, 'g'), v);
    }
  }
  return val || key;
}

const _rawTitle = t("home_meta_title");
const title = (_rawTitle !== "home_meta_title") ? _rawTitle : (lang === 'es' 
  ? "MAPA Business & Financial Services | Estratega Financiera Newark NJ" 
  : "MAPA Business & Financial Services | Immigrant Financial Strategist Newark NJ");
  
const _rawDesc = t("home_meta_desc");
const description = (_rawDesc !== "home_meta_desc") ? _rawDesc : (lang === 'es'
  ? "MAPA Business & Financial Services LLC · Marilyn Paladinez, Estratega Financiera para Migrantes en Newark, NJ. Trámites de ITIN, LLC, Taxes, Notaría y Seguros."
  : "MAPA Business & Financial Services LLC · Marilyn Paladinez, Financial Strategist for Immigrants in Newark, NJ. Certified Notary, ITIN, LLC setups, and Taxes.");

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "description": lang === 'es' ? "Estratega Financiera para Migrantes en Newark, NJ." : "Financial Strategist for Immigrants in Newark, NJ.",
      "publisher": { "@id": `${WEBSITE}/#organization` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "about": { "@id": `${WEBSITE}/#organization` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "FinancialService",
      "@id": `${WEBSITE}/#organization`,
      "name": "MAPA Business & Financial Services LLC",
      "url": WEBSITE,
      "logo": `${WEBSITE}/logo-mapa.png`,
      "image": `${WEBSITE}/marilin2.webp`,
      "telephone": "+18626228339",
      "priceRange": "$$",
      "foundingDate": "2014",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "20 Bloomfield Pl",
        "addressLocality": "Newark",
        "addressRegion": "NJ",
        "postalCode": "07104",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.7534611,
        "longitude": -74.1696199
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61550670802804",
        "https://www.instagram.com/marilynpaladinezusa/",
        "https://www.tiktok.com/@marilynpaladinezv",
        "https://www.youtube.com/@MarilynPaladinezOficial"
      ],
      "founder": { "@id": `${WEBSITE}/#person` },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": lang === 'es' ? "Servicios MAPA" : "MAPA Services",
        "itemListElement": services.map((service) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": t(`services.${service.slug}.title`),
            "description": t(`services.${service.slug}.desc`)
          }
        }))
      }
    },
    {
      "@type": "Person",
      "@id": `${WEBSITE}/#person`,
      "name": "Marilyn Paladinez",
      "jobTitle": lang === 'es' ? "Estratega Financiera para Migrantes" : "Financial Strategist for Immigrants",
      "worksFor": { "@id": `${WEBSITE}/#organization` },
      "url": lang === 'es' ? `${WEBSITE}/marilyn-paladinez/` : `${WEBSITE}/en/marilyn-paladinez/`,
      "image": `${WEBSITE}/marilin2.webp`
    }
  ]
};

const serviceLinkPrefix = lang === 'es' ? '/servicios/' : '/en/services/';
const cityLinkPrefix = lang === 'es' ? '/service-areas/' : '/en/service-areas/';

const slideKeyMap: Record<string, string> = {
  'poderes-notariales': 'poderes',
  'permisos-de-trabajo': 'permisos',
  'licencias-de-conducir': 'licencias',
  'seguros-de-auto': 'seguros_auto',
  'seguros-de-salud': 'seguros_salud',
  'seguros-de-vida': 'seguros_vida',
};

const getSlideKey = (slug: string) => {
  const key = slideKeyMap[slug] || slug.replace(/-/g, '_');
  return `hero.slide_${key}`;
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  loadMap={true}
  activeSection="hero"
  currentPath={currentPath}
>
  <!-- HERO SECTION REDESIGN -->
  <section id="hero" class="mapa-hero-section">
    <div class="hero-inner-container">
      <!-- Left Column Content (50-55%) -->
      <div class="hero-left-col">
        <!-- Eyebrow -->
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          MAPA BUSINESS & FINANCIAL SERVICES
        </div>

        <!-- Headline -->
        <h1 class="hero-title">
          {lang === 'es' ? (
            <>Más que trámites.<br /><span class="highlight-mapa">Un MAPA</span> para avanzar.</>
          ) : (
            <>More than procedures.<br /><span class="highlight-mapa">A MAP</span> to move forward.</>
          )}
        </h1>

        <!-- Subheadline -->
        <p class="hero-subtitle">
          {lang === 'es'
            ? 'Servicios profesionales para ayudarte con documentos, negocios, impuestos, seguros y trámites importantes en Estados Unidos.'
            : 'Professional services to help you with documents, business, taxes, insurance, and important procedures in the United States.'}
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="hero-cta-row">
          <a href="#contacto" class="btn-hero-primary">
            {lang === 'es' ? 'Agenda una consulta' : 'Schedule a consultation'}
          </a>
          <a href="#servicios" class="btn-hero-secondary">
            {lang === 'es' ? 'Ver todos los servicios' : 'View all services'}
          </a>
        </div>

        <!-- Social Proof & Trust Indicators (Bottom Left) -->
        <div class="hero-trust-block">
          <div class="trust-stat-box">
            <div class="trust-stars-row">
              <span class="trust-count">500+</span>
              <span class="trust-label">{lang === 'es' ? 'clientes atendidos' : 'clients served'}</span>
              <div class="stars-group">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#cc0000" width="14" height="14">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                ))}
              </div>
            </div>
            <p class="trust-phrase">{lang === 'es' ? 'Atención profesional y personalizada' : 'Professional and personalized service'}</p>
          </div>

          <!-- Micro-element badge -->
          <div class="bilingual-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Español • English</span>
          </div>
        </div>
      </div>

      <!-- Right Column Visual Ecosystem -->
      <div class="hero-right-col">
        <div class="hero-ecosystem">
          <!-- Central Portrait of Marilyn -->
          <div class="portrait-frame">
            <img src="/marilin2.webp" alt="Marilyn Paladinez — MAPA Business" class="portrait-img" />
          </div>

          <!-- 5 Floating Premium Service Cards -->
          
          <!-- Card 1: Notaría Pública -->
          <a href={lang === 'es' ? '/servicios/notaria/' : '/en/services/notaria/'} class="service-float-card card-notaria">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M12 18v-6"></path>
                <path d="M9 15h6"></path>
              </svg>
              <span class="red-dot-accent"></span>
            </div>
            <div class="card-text-box">
              <span class="card-title">{lang === 'es' ? 'Notaría Pública' : 'Notary Public'}</span>
              <span class="card-subtitle">{lang === 'es' ? 'Documentos Oficiales' : 'Official Documents'}</span>
            </div>
          </a>

          <!-- Card 2: Traducciones -->
          <a href={lang === 'es' ? '/servicios/traducciones/' : '/en/services/traducciones/'} class="service-float-card card-traducciones">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
                <path d="M5 8l6 6"></path>
                <path d="M4 14e1 0 0 1 0-1.4L11 4"></path>
                <path d="M2 5h12"></path>
                <path d="M7 2h1"></path>
                <path d="M22 22l-5-10-5 10"></path>
                <path d="M14 18h6"></path>
              </svg>
              <span class="red-dot-accent"></span>
            </div>
            <div class="card-text-box">
              <span class="card-title">{lang === 'es' ? 'Traducciones' : 'Translations'}</span>
              <span class="card-subtitle">{lang === 'es' ? 'Certificadas USCIS' : 'USCIS Certified'}</span>
            </div>
          </a>

          <!-- Card 3: Poderes -->
          <a href={lang === 'es' ? '/servicios/poderes-notariales/' : '/en/services/poderes-notariales/'} class="service-float-card card-poderes">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <circle cx="9" cy="10" r="2"></circle>
                <line x1="15" y1="8" x2="17" y2="8"></line>
                <line x1="15" y1="12" x2="17" y2="12"></line>
                <line x1="7" y1="16" x2="17" y2="16"></line>
              </svg>
              <span class="red-dot-accent"></span>
            </div>
            <div class="card-text-box">
              <span class="card-title">{lang === 'es' ? 'Poderes' : 'Powers of Attorney'}</span>
              <span class="card-subtitle">{lang === 'es' ? 'Legales y Notariados' : 'Legal & Notarized'}</span>
            </div>
          </a>

          <!-- Card 4: ITIN & Taxes -->
          <a href={lang === 'es' ? '/servicios/itin/' : '/en/services/itin/'} class="service-float-card card-itin">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
                <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                <line x1="8" y1="6" x2="16" y2="6"></line>
                <line x1="16" y1="14" x2="16" y2="18"></line>
                <path d="M16 10h.01"></path>
                <path d="M12 10h.01"></path>
                <path d="M8 10h.01"></path>
                <path d="M12 14h.01"></path>
                <path d="M8 14h.01"></path>
                <path d="M12 18h.01"></path>
                <path d="M8 18h.01"></path>
              </svg>
              <span class="red-dot-accent"></span>
            </div>
            <div class="card-text-box">
              <span class="card-title">ITIN & Taxes</span>
              <span class="card-subtitle">{lang === 'es' ? 'Agente Autorizado CAA' : 'Certified CAA Agent'}</span>
            </div>
          </a>

          <!-- Card 5: Business Services -->
          <a href={lang === 'es' ? '/servicios/bookkeeping/' : '/en/services/bookkeeping/'} class="service-float-card card-business">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="svg-icon">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <span class="red-dot-accent"></span>
            </div>
            <div class="card-text-box">
              <span class="card-title">Business Services</span>
              <span class="card-subtitle">{lang === 'es' ? 'Creación LLC & Bookkeeping' : 'LLC Setup & Bookkeeping'}</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="stat-item reveal rv1"><span class="stat-num">500+</span><span class="stat-label">{t("stats.clients")}</span></div>
    <div class="stat-item reveal rv2"><span class="stat-num">10+</span><span class="stat-label">{t("stats.experience")}</span></div>
    <div class="stat-item reveal rv3"><span class="stat-num">{cities.length}</span><span class="stat-label">{t("stats.coverage")}</span></div>
    <div class="stat-item reveal rv4"><span class="stat-num">98%</span><span class="stat-label">{t("stats.satisfaction")}</span></div>
  </div>

  <!-- SERVICES -->
  <section id="servicios">
    <div class="section-inner">
      <div class="section-tag reveal">{t("services.tag")}</div>
      <h2 class="section-title reveal rv1" set:html={t("services.title_html")} />
      <p class="section-desc reveal rv2">{t("services.desc")}</p>
      <div class="services-grid">
        {services.map((service, index) => {
          const delayClass = `rv${(index % 3) + 1}`;
          return (
            <div class={`service-card reveal ${delayClass}`}>
              <div class="service-card-img-wrap">
                <img src={service.image} alt={t(`services.${service.slug}.title`)} class="service-card-img" loading="lazy" />
                <span class="service-icon-badge">{service.icon}</span>
              </div>
              <div class="service-card-body">
                <h3>{t(`services.${service.slug}.title`)}</h3>
                <p>{t(`services.${service.slug}.desc`)}</p>
                <a href={`${serviceLinkPrefix}${service.slug}/`} class="service-link">{t("services.btn_details")}</a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="nosotros">
    <div class="section-inner">
      <div class="about-grid">
        <div class="about-img-wrap reveal">
          <!-- Organic Blob Portrait Frame -->
          <div class="about-portrait-frame">
            <img src="/marilin.webp" alt="Marilyn Paladinez — MAPA Business" class="about-portrait-img" />
          </div>

          <!-- Floating Badge 1 (Top Right): Atención personalizada -->
          <div class="about-float-badge badge-top-right">
            <div class="badge-icon-red">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#cc0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
            </div>
            <span class="badge-text-bold">{lang === 'es' ? 'Atención personalizada' : 'Personalized Attention'}</span>
          </div>

          <!-- Floating Badge 2 (Bottom Left): 500+ CLIENTES ATENDIDOS -->
          <div class="about-float-badge badge-bottom-left">
            <div class="badge-icon-pink">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#cc0000" width="20" height="20">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
              </svg>
            </div>
            <div class="badge-stat-box">
              <span class="badge-stat-num">500+</span>
              <span class="badge-stat-label">{lang === 'es' ? 'CLIENTES ATENDIDOS' : 'CLIENTS SERVED'}</span>
            </div>
          </div>

          <!-- Floating Badge 3 (Bottom Right): 10+ AÑOS DE EXPERIENCIA -->
          <div class="about-card-experience">
            <span class="exp-num">10+</span>
            <span class="exp-label">{t("about.years_exp")}</span>
          </div>
        </div>
        <div class="about-text reveal rv2">
          <div class="section-tag">{t("about.tag")}</div>
          <h2 class="section-title" set:html={t("about.title_html")} />
          <p class="section-desc">{t("about.desc")}</p>
          <div class="about-features">
            <div class="feature-card">
              <span class="feature-icon">🌎</span>
              <div class="feature-text"><strong>{t("about.feat_community_title")}</strong><span>{t("about.feat_community")}</span></div>
            </div>
            <div class="feature-card">
              <span class="feature-icon">⚖️</span>
              <div class="feature-text"><strong>{t("about.feat_notary_title")}</strong><span>{t("about.feat_notary")}</span></div>
            </div>
            <div class="feature-card">
              <span class="feature-icon">📋</span>
              <div class="feature-text"><strong>{t("about.feat_immigration_title")}</strong><span>{t("about.feat_immigration")}</span></div>
            </div>
            <div class="feature-card">
              <span class="feature-icon">👨‍👩‍👧‍👦</span>
              <div class="feature-text"><strong>{t("about.feat_families_title")}</strong><span>{t("about.feat_families")}</span></div>
            </div>
            <div class="feature-card">
              <span class="feature-icon">🗣️</span>
              <div class="feature-text"><strong>{t("about.feat_language_title")}</strong><span>{t("about.feat_language")}</span></div>
            </div>
            <div class="feature-card">
              <span class="feature-icon">🗺️</span>
              <div class="feature-text"><strong>{t("about.feat_plan_title")}</strong><span>{t("about.feat_plan")}</span></div>
            </div>
          </div>
          <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;">
            <a href={lang === 'es' ? '/es/sobre-mapa-business-and-financial-services/' : '/en/about-mapa-business-and-financial-services/'} class="btn btn-red">
              📖 {lang === 'es' ? 'Conocer Nuestra Historia' : 'Read Our Full Story'}
            </a>
            <a href="https://wa.me/18626228339" target="_blank" class="btn btn-whatsapp">💬 {t("about.btn_whatsapp")}</a>
            <a href="#contacto" class="btn btn-outline">📅 {t("about.btn_schedule")}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="proceso">
    <div class="section-inner">
      <div style="text-align:center;margin-bottom:60px;">
        <div class="section-tag reveal">{t("process.tag")}</div>
        <h2 class="section-title reveal rv1" set:html={t("process.title_html")} />
        <p class="section-desc reveal rv2" style="margin:0 auto;">{t("process.desc")}</p>
      </div>
      <div class="process-steps">
        <div class="step-card reveal rv1">
          <div class="step-img-wrap">
            <img src="/images/process/paso-1-consulta.jpg" alt={t("process.step1_title")} class="step-img" loading="lazy" />
            <span class="step-badge">{lang === 'es' ? 'Paso 1' : 'Step 1'}</span>
          </div>
          <div class="step-body">
            <h3>{t("process.step1_title")}</h3>
            <p>{t("process.step1_desc")}</p>
          </div>
        </div>

        <div class="step-card reveal rv2">
          <div class="step-img-wrap">
            <img src="/images/process/paso-2-plan.jpg" alt={t("process.step2_title")} class="step-img" loading="lazy" />
            <span class="step-badge">{lang === 'es' ? 'Paso 2' : 'Step 2'}</span>
          </div>
          <div class="step-body">
            <h3>{t("process.step2_title")}</h3>
            <p>{t("process.step2_desc")}</p>
          </div>
        </div>

        <div class="step-card reveal rv3">
          <div class="step-img-wrap">
            <img src="/images/process/paso-3-ejecucion.jpg" alt={t("process.step3_title")} class="step-img" loading="lazy" />
            <span class="step-badge">{lang === 'es' ? 'Paso 3' : 'Step 3'}</span>
          </div>
          <div class="step-body">
            <h3>{t("process.step3_title")}</h3>
            <p>{t("process.step3_desc")}</p>
          </div>
        </div>

        <div class="step-card reveal rv4">
          <div class="step-img-wrap">
            <img src="/images/process/paso-4-resultados.jpg" alt={t("process.step4_title")} class="step-img" loading="lazy" />
            <span class="step-badge">{lang === 'es' ? 'Paso 4' : 'Step 4'}</span>
          </div>
          <div class="step-body">
            <h3>{t("process.step4_title")}</h3>
            <p>{t("process.step4_desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section id="testimonios">
