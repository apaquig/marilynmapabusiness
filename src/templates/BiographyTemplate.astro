---
// src/templates/BiographyTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es' ? `${WEBSITE}/marilyn-paladinez/` : `${WEBSITE}/en/marilyn-paladinez/`;
const currentPath = lang === 'es' ? '/marilyn-paladinez/' : '/en/marilyn-paladinez/';

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

const serviceLinkPrefix = lang === 'es' ? '/servicios/' : '/en/services/';

const content = {
  es: {
    meta_title: "Marilyn Paladinez | Fundadora de MAPA Business & Financial Services",
    meta_desc: "Conoce a Marilyn Paladinez, fundadora de MAPA Business, Notaria Pública certificada en NJ y estratega financiera dedicada a orientar a la comunidad latina.",
    h1: "Marilyn Paladinez, estratega financiera para migrantes en Newark, NJ",
    intro_p1: "Marilyn Paladinez es la fundadora de MAPA Business & Financial Services LLC, una empresa ubicada en Newark, New Jersey, que orienta en español a familias, migrantes y emprendedores latinos.",
    intro_p2: "Marilyn Paladinez ofrece acompañamiento personalizado en servicios notariales, financieros, empresariales y preparación de documentos.",
    about_title: "Sobre Marilyn Paladinez",
    about_p1: "Con más de 10 años de experiencia de campo en el estado de New Jersey, Marilyn ha ayudado a cientos de familias a establecerse, proteger sus activos y construir un historial sólido. Su enfoque es 100% estratégico y educativo, traduciendo procesos legales e institucionales complejos en planes paso a paso comprensibles en tu propio idioma.",
    about_p2: "No es abogada ni asesora legal de corte, pero su especialización técnica y certificaciones vigentes como Notaria Pública e ITIN Acceptance Agent le permiten preparar documentación con el máximo rigor requerido por el IRS, el MVC y agencias gubernamentales.",
    mission_title: "Misión y Compromiso",
    mission_desc: "Facilitar el camino de la comunidad hispana hacia la estabilidad financiera, el cumplimiento fiscal y el éxito empresarial en los Estados Unidos, eliminando las barreras del idioma y la burocracia.",
    credentials_title: "Credenciales y Certificaciones",
    cred_notary: "Notaria Pública Certificada de New Jersey (Active Commission)",
    cred_notary_desc: "Autorizada para notarizar firmas, contratos, testamentos, poderes y declaraciones juradas en todo el territorio del estado.",
    cred_caa: "Acceptance Agent Certificado por el IRS",
    cred_caa_desc: "Autorizada para validar pasaportes y documentos de identidad cara a cara para trámites de ITIN (Formulario W-7), evitando que envíes tus documentos originales por correo.",
    cred_doc: "Especialista en Preparación Documental",
    cred_doc_desc: "Experta en el llenado de formas gubernamentales de impuestos (Taxes personales y comerciales), solicitudes de seguro y formas de autorización de empleo (I-765).",
    services_title: "Servicios que dirijo en MAPA",
    services_desc: "Marilyn supervisa y ofrece asesoría directa en las siguientes áreas de servicio:",
    contact_title: "¿Necesitas asesoría?",
    contact_desc: "Agenda una consulta directamente con Marilyn Paladinez en nuestra oficina de Newark o de manera virtual.",
    btn_schedule: "Calendario de Citas",
    btn_whatsapp: "Conversar por WhatsApp",
    faq_title: "Preguntas Frecuentes",
    faqs: [
      {
        q: "¿Quién es Marilyn Paladinez?",
        a: "Marilyn Paladinez es una estratega financiera y fundadora de MAPA Business & Financial Services LLC, especializada en asesorar a inmigrantes y pequeños negocios en New Jersey."
      },
      {
        q: "¿Marilyn Paladinez ofrece asesoría legal o migratoria?",
        a: "No. Marilyn Paladinez no es abogada de inmigración y no ofrece representación legal en cortes de inmigración. Su servicio es de orientación financiera, preparación documental (como permisos I-765, ITIN, e impuestos) y servicios notariales autorizados."
      },
      {
        q: "¿Dónde está ubicada la oficina de Marilyn Paladinez?",
        a: "Su oficina principal está ubicada en 20 Bloomfield Pl, Newark, NJ 07104. Se atiende principalmente bajo cita programada."
      },
      {
        q: "¿Cómo puedo contactar a Marilyn Paladinez?",
        a: "Puedes comunicarte directamente llamando o escribiendo por WhatsApp al (862) 622-8339, o completando el formulario de contacto oficial."
      }
    ]
  },
  en: {
    meta_title: "Marilyn Paladinez | Founder of MAPA Business & Financial Services",
    meta_desc: "Meet Marilyn Paladinez, founder of MAPA Business, certified NJ Notary Public, and financial strategist dedicated to supporting the Latino community.",
    h1: "Marilyn Paladinez, financial strategist for migrants in Newark, NJ",
    intro_p1: "Marilyn Paladinez is the founder of MAPA Business & Financial Services LLC, a company located in Newark, New Jersey, providing Spanish-language guidance to Latino families, migrants, and small business owners.",
    intro_p2: "Marilyn Paladinez offers personalized accompaniment in notary services, financial planning, business setups, and document preparation.",
    about_title: "About Marilyn Paladinez",
    about_p1: "With over 10 years of field experience in the state of New Jersey, Marilyn has helped hundreds of families settle, protect their assets, and build solid credit histories. Her approach is 100% strategic and educational, translating complex legal and institutional procedures into step-by-step plans in your own language.",
    about_p2: "She is not an attorney and does not provide legal representation in court. However, her technical specialization and active certifications as a Notary Public and ITIN Acceptance Agent allow her to prepare documentation with the maximum rigor required by the IRS, MVC, and other government agencies.",
    mission_title: "Mission and Commitment",
    mission_desc: "To empower the Hispanic community towards financial stability, tax compliance, and business success in the United States, removing language barriers and bureaucratic stress.",
    credentials_title: "Credentials and Certifications",
    cred_notary: "Certified New Jersey Notary Public (Active Commission)",
    cred_notary_desc: "Authorized to notarize signatures, contracts, wills, powers of attorney, and affidavits statewide.",
    cred_caa: "IRS Certified Acceptance Agent (CAA)",
    cred_caa_desc: "Authorized to verify passports and identification documents in person for ITIN processing (Form W-7), keeping your original documents safe in your possession.",
    cred_doc: "Document Preparation Specialist",
    cred_doc_desc: "Experienced in completing government tax forms (personal and business taxes), insurance applications, and employment authorization forms (I-765).",
    services_title: "Services I lead at MAPA",
    services_desc: "Marilyn supervises and provides direct advice in the following service areas:",
    contact_title: "Need consultation?",
    contact_desc: "Schedule a consultation directly with Marilyn Paladinez at our Newark office or virtually.",
    btn_schedule: "Book Appointment",
    btn_whatsapp: "Chat on WhatsApp",
    faq_title: "Frequently Asked Questions",
    faqs: [
      {
        q: "Who is Marilyn Paladinez?",
        a: "Marilyn Paladinez is a financial strategist and the founder of MAPA Business & Financial Services LLC, specializing in advising immigrants and small businesses in New Jersey."
      },
      {
        q: "Does Marilyn Paladinez offer legal or immigration advice?",
        a: "No. Marilyn Paladinez is not an immigration attorney and does not provide legal representation in court. She provides financial guidance, document preparation (such as I-765, ITIN, and taxes), and authorized notary public services."
      },
      {
        q: "Where is Marilyn Paladinez's office located?",
        a: "Her main office is located at 20 Bloomfield Pl, Newark, NJ 07104. Service is provided primarily by scheduled appointments."
      },
      {
        q: "How can I contact Marilyn Paladinez?",
        a: "You can reach her directly by calling or messaging on WhatsApp at (862) 622-8339, or by completing the official contact form."
      }
    ]
  }
};

const currentContent = lang === 'es' ? content.es : content.en;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": currentContent.meta_title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "about": { "@id": `${WEBSITE}/#person` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "Person",
      "@id": `${WEBSITE}/#person`,
      "name": "Marilyn Paladinez",
      "jobTitle": lang === 'es' ? "Estratega Financiera para Migrantes" : "Financial Strategist for Immigrants",
      "worksFor": {
        "@type": "Organization",
        "name": "MAPA Business & Financial Services LLC",
        "url": WEBSITE
      },
      "url": canonical,
      "image": `${WEBSITE}/marilin2.webp`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "20 Bloomfield Pl",
        "addressLocality": "Newark",
        "addressRegion": "NJ",
        "postalCode": "07104",
        "addressCountry": "US"
      },
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61550670802804",
        "https://www.instagram.com/marilynpaladinezusa/",
        "https://www.tiktok.com/@marilynpaladinezv",
        "https://www.youtube.com/@MarilynPaladinezOficial"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "mainEntity": currentContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  lang={lang}
  title={currentContent.meta_title}
  description={currentContent.meta_desc}
  canonical={canonical}
  schema={schema}
  activeSection="biography"
  currentPath={currentPath}
>
  <div class="breadcrumb" style="max-width: 1000px; margin: 90px auto 0; padding: 16px 20px 0; font-family: Montserrat, sans-serif; font-size: 0.8rem; display: flex; gap: 8px;">
    <a href={lang === 'es' ? '/' : '/en/'} style="color: rgba(255,255,255,0.4); text-decoration: none;">{lang === 'es' ? 'Inicio' : 'Home'}</a>
    <span style="color: rgba(255,255,255,0.4);">›</span>
    <span style="color: #fff;">Marilyn Paladinez</span>
  </div>

  <main style="max-width: 1000px; margin: 0 auto; padding: 40px 20px 80px;">
    <!-- Hero Box -->
    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 40px; display: flex; gap: 40px; align-items: center; flex-wrap: wrap; margin-bottom: 50px;">
      <div style="flex: 1 1 300px; text-align: center;">
        <img src="/marilin2.webp" alt="Marilyn Paladinez" style="width: 260px; height: 260px; border-radius: 50%; object-fit: cover; border: 4px solid #cc0000; box-shadow: 0 10px 30px rgba(204,0,0,0.25);" />
      </div>
      <div style="flex: 2 1 400px;">
        <span style="display: inline-block; background: rgba(204,0,0,0.15); border: 1px solid rgba(204,0,0,0.4); color: #cc0000; font-family: Montserrat, sans-serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: 16px;">
          {lang === 'es' ? 'Fundadora y Estratega' : 'Founder & Strategist'}
        </span>
        <h1 style="font-family: Montserrat, sans-serif; font-weight: 900; font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.2; margin-bottom: 20px; color: #fff;">
          {currentContent.h1}
        </h1>
        <p style="font-size: 1.05rem; line-height: 1.7; color: rgba(255,255,255,0.85); margin-bottom: 16px; font-weight: 600;">
          {currentContent.intro_p1}
        </p>
        <p style="font-size: 1rem; line-height: 1.7; color: rgba(255,255,255,0.7);">
          {currentContent.intro_p2}
        </p>
      </div>
    </div>

    <!-- Biography Core -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px; margin-bottom: 50px; flex-wrap: wrap;">
      <!-- Main Column -->
      <div>
        <h2 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.6rem; color: #fff; margin-bottom: 20px; border-left: 4px solid #cc0000; padding-left: 12px;">
          {currentContent.about_title}
        </h2>
        <p style="font-size: 1rem; line-height: 1.8; color: rgba(255,255,255,0.75); margin-bottom: 20px;">
          {currentContent.about_p1}
        </p>
        <p style="font-size: 1rem; line-height: 1.8; color: rgba(255,255,255,0.75); margin-bottom: 30px;">
          {currentContent.about_p2}
        </p>

        <!-- Mission -->
        <div style="background: rgba(204,0,0,0.03); border-left: 4px solid #cc0000; padding: 24px; border-radius: 0 12px 12px 0; margin-bottom: 40px;">
          <h3 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.1rem; color: #fff; margin-bottom: 8px;">
            {currentContent.mission_title}
          </h3>
          <p style="font-size: 0.95rem; line-height: 1.7; color: rgba(255,255,255,0.85); margin: 0;">
            {currentContent.mission_desc}
          </p>
        </div>

        <!-- Credentials -->
        <h2 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.5rem; color: #fff; margin-bottom: 20px;">
          {currentContent.credentials_title}
        </h2>
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div style="display: flex; gap: 15px; align-items: flex-start;">
            <div style="font-size: 1.5rem; background: rgba(255,255,255,0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">⚖️</div>
            <div>
              <h4 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 4px;">{currentContent.cred_notary}</h4>
              <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.5; margin: 0;">{currentContent.cred_notary_desc}</p>
            </div>
          </div>
          <div style="display: flex; gap: 15px; align-items: flex-start;">
            <div style="font-size: 1.5rem; background: rgba(255,255,255,0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">🔢</div>
            <div>
              <h4 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 4px;">{currentContent.cred_caa}</h4>
              <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.5; margin: 0;">{currentContent.cred_caa_desc}</p>
            </div>
          </div>
          <div style="display: flex; gap: 15px; align-items: flex-start;">
            <div style="font-size: 1.5rem; background: rgba(255,255,255,0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">📋</div>
            <div>
              <h4 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 4px;">{currentContent.cred_doc}</h4>
              <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.5; margin: 0;">{currentContent.cred_doc_desc}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar Services -->
      <div style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 24px; height: fit-content;">
        <h3 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.15rem; color: #fff; margin-bottom: 12px;">
          {currentContent.services_title}
        </h3>
        <p style="font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.5; margin-bottom: 20px;">
          {currentContent.services_desc}
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
          {services.map(service => (
            <li>
              <a href={`${serviceLinkPrefix}${service.slug}/`} style="display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem; padding: 8px; border-radius: 6px; border: 1px solid transparent; transition: all 0.2s;"
                 onmouseover="this.style.color='#cc0000'; this.style.borderColor='rgba(204,0,0,0.15)'; this.style.background='rgba(204,0,0,0.02)';"
                 onmouseout="this.style.color='rgba(255,255,255,0.8)'; this.style.borderColor='transparent'; this.style.background='transparent';">
                <span>{service.icon}</span>
                <strong>{service.name}</strong>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- FAQs -->
    <div style="margin-bottom: 50px;">
      <h2 style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1.5rem; color: #fff; margin-bottom: 24px; text-align: center;">
        {currentContent.faq_title}
      </h2>
      <dl style="display: flex; flex-direction: column; gap: 20px;">
        {currentContent.faqs.map(faq => (
          <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 20px;">
            <dt style="font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1rem; color: #fff; margin-bottom: 8px;">{faq.q}</dt>
            <dd style="font-size: 0.92rem; color: rgba(255,255,255,0.65); line-height: 1.6; margin: 0;">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Contact Block -->
    <div style="background: linear-gradient(135deg, #120000 0%, #200000 100%); border: 1px solid rgba(204,0,0,0.3); border-radius: 16px; padding: 40px; text-align: center;">
      <h2 style="font-family: Montserrat, sans-serif; font-weight: 900; font-size: 1.8rem; color: #fff; margin-bottom: 12px;">
        {currentContent.contact_title}
      </h2>
      <p style="font-size: 1.05rem; color: rgba(255,255,255,0.7); max-width: 600px; margin: 0 auto 28px; line-height: 1.6;">
        {currentContent.contact_desc}
      </p>
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <a href="#contacto" class="btn btn-red" style="font-family: Montserrat; font-weight: 700; text-transform: uppercase;">
          📅 {currentContent.btn_schedule}
        </a>
        <a href="https://wa.me/18626228339" target="_blank" class="btn btn-whatsapp" style="font-family: Montserrat; font-weight: 700; text-transform: uppercase;">
          💬 {currentContent.btn_whatsapp}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
