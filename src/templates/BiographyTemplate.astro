---
// src/templates/BiographyTemplate.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const WEBSITE = "https://marilynmapabusiness.com";
const canonical = lang === 'es' ? `${WEBSITE}/marilyn-paladinez/` : `${WEBSITE}/en/marilyn-paladinez/`;
const currentPath = lang === 'es' ? '/marilyn-paladinez/' : '/en/marilyn-paladinez/';

const PHONE = "(862) 622-8339";
const PHONE_HREF = "+18626228339";

const serviceLinkPrefix = lang === 'es' ? '/servicios/' : '/en/services/';

const content = {
  es: {
    meta_title: "Marilyn Paladinez | Fundadora de MAPA Business & Financial Services",
    meta_desc: "Conoce a Marilyn Paladinez, fundadora de MAPA Business, Notaria Pública certificada en NJ y estratega financiera dedicada a orientar a la comunidad latina.",
    h1: "Marilyn Paladinez — Estratega Financiera para la Comunidad Latina",
    intro_p1: "Fundadora de MAPA Business & Financial Services LLC en Newark, New Jersey. Más de 10 años acompañando a familias, migrantes y empresarios en el cumplimiento de sus metas legales y fiscales.",
    intro_p2: "Orientación 100% en español con rigor técnico en trámites notariales, preparación de taxes, obtención de ITIN y asesoría corporativa.",
    about_title: "Sobre Marilyn Paladinez",
    about_p1: "Con más de una década de trayectoria constante en el estado de New Jersey, Marilyn Paladinez ha guiado a cientos de familias a estructurar sus finanzas, proteger su patrimonio y desenvolverse con seguridad en el sistema estadounidense. Su metodología prioriza la educación y la claridad, transformando trámites complejos en estrategias comprensibles paso a paso.",
    about_p2: "Aunque no es abogada ni ofrece representación legal en juicios, su sólida formación técnica y certificaciones vigentes como Notaria Pública de NJ y Acceptance Agent autorizado por el IRS garantizan que cada expediente cumpla con los más altos estándares exigidos por las agencias estatales y federales.",
    quote: "Mi misión es eliminar la barrera del idioma y el temor burocrático para que cada familia latina en New Jersey alcance la estabilidad y el crecimiento financiero que merece.",
    mission_title: "Misión y Compromiso Institucional",
    mission_desc: "Facilitar el camino de la comunidad hispana hacia la tranquilidad financiera, el cumplimiento tributario impecable y el desarrollo de nuevos negocios en Estados Unidos, con transparencia, empatía y eficiencia.",
    credentials_title: "Credenciales y Certificaciones Oficiales",
    cred_notary: "Notaria Pública Certificada del Estado de New Jersey",
    cred_notary_desc: "Comisión activa autorizada para legalizar firmas, redactar declaraciones juradas, autenticar contratos, poderes y documentos notariales en todo NJ.",
    cred_caa: "Acceptance Agent Certificado por el IRS (CAA)",
    cred_caa_desc: "Autorización especial del IRS para verificar pasaportes y documentos de identidad presencialmente para el trámite de ITIN Number (W-7), sin arriesgar el envío de originales por correo.",
    cred_doc: "Especialista en Preparación Documental y Fiscal",
    cred_doc_desc: "Dominio técnico en la preparación de declaraciones de impuestos (Taxes personales y comerciales), solicitudes de permiso de trabajo (I-765) y registros corporativos.",
    services_title: "Servicios que Dirige en MAPA",
    services_desc: "Supervisión directa y asesoramiento en todas las áreas de servicio:",
    contact_title: "¿Listo para dar el siguiente paso?",
    contact_desc: "Agenda una consulta directamente con Marilyn Paladinez en nuestra oficina en Newark, NJ o recibe atención personalizada por WhatsApp.",
    btn_schedule: "Agendar Consulta",
    btn_whatsapp: "WhatsApp Directo",
    faq_title: "Preguntas Frecuentes",
    faqs: [
      {
        q: "¿Quién es Marilyn Paladinez?",
        a: "Marilyn Paladinez es la fundadora de MAPA Business & Financial Services LLC, estratega financiera y Notaria Pública en Newark, New Jersey, dedicada a asesorar a la comunidad hispana."
      },
      {
        q: "¿Ofrece representación o asesoría legal de abogados?",
        a: "No. Marilyn Paladinez no es abogada y no ofrece servicios legales de corte. Su trabajo se enfoca en orientación financiera, preparación documental oficial (ITIN, Taxes, Permisos de Trabajo) y notariado público autorizado."
      },
      {
        q: "¿Dónde atiende Marilyn Paladinez?",
        a: "Atiende en la oficina principal de MAPA Business en 20 Bloomfield Pl, Newark, NJ 07104. Se recomienda agendar cita previa para una mejor atención."
      },
      {
        q: "¿Cómo puedo solicitar una cita con ella?",
        a: "Puedes llamar o escribir directamente al (862) 622-8339 o utilizar los botones de reserva en este sitio web."
      }
    ]
  },
  en: {
    meta_title: "Marilyn Paladinez | Founder of MAPA Business & Financial Services",
    meta_desc: "Meet Marilyn Paladinez, founder of MAPA Business, certified NJ Notary Public, and financial strategist dedicated to supporting the Latino community.",
    h1: "Marilyn Paladinez — Financial Strategist for the Latino Community",
    intro_p1: "Founder of MAPA Business & Financial Services LLC in Newark, New Jersey. Over 10 years accompanying families, migrants, and business owners in achieving their financial and document goals.",
    intro_p2: "100% Spanish-language orientation with technical rigor in notary services, tax preparation, ITIN processing, and corporate setup.",
    about_title: "About Marilyn Paladinez",
    about_p1: "With over a decade of consistent practice in New Jersey, Marilyn Paladinez has guided hundreds of families to structure their finances, protect their assets, and navigate the U.S. system with confidence. Her approach prioritizes education and clarity, turning complex processes into clear step-by-step plans.",
    about_p2: "While she is not an attorney and does not represent clients in court, her solid technical background and active certifications as a NJ Notary Public and IRS Certified Acceptance Agent ensure every filing meets the highest agency standards.",
    quote: "My mission is to break language barriers and eliminate bureaucratic stress so Latino families in New Jersey can achieve lasting financial growth.",
    mission_title: "Mission & Corporate Commitment",
    mission_desc: "Empowering the Hispanic community toward financial peace of mind, flawless tax compliance, and business success in the United States through transparency and empathy.",
    credentials_title: "Official Credentials & Certifications",
    cred_notary: "Certified New Jersey Notary Public",
    cred_notary_desc: "Active commission authorized to notarize signatures, affidavits, contracts, powers of attorney, and legal documents statewide.",
    cred_caa: "IRS Certified Acceptance Agent (CAA)",
    cred_caa_desc: "Special IRS authorization to verify passports and ID documents in person for ITIN processing (Form W-7), avoiding mailing original documents.",
    cred_doc: "Document & Tax Preparation Specialist",
    cred_doc_desc: "Expert technical preparation for personal and commercial tax returns, work authorization applications (I-765), and corporate filings.",
    services_title: "Services Led by Marilyn",
    services_desc: "Direct supervision and advice across key service areas:",
    contact_title: "Ready to take the next step?",
    contact_desc: "Book a consultation with Marilyn Paladinez at our Newark, NJ office or connect via WhatsApp for immediate support.",
    btn_schedule: "Book Appointment",
    btn_whatsapp: "Direct WhatsApp",
    faq_title: "Frequently Asked Questions",
    faqs: [
      {
        q: "Who is Marilyn Paladinez?",
        a: "Marilyn Paladinez is the founder of MAPA Business & Financial Services LLC, a financial strategist, and certified NJ Notary Public based in Newark, New Jersey."
      },
      {
        q: "Does Marilyn Paladinez provide attorney legal representation?",
        a: "No. Marilyn Paladinez is not an attorney and does not provide courtroom legal services. Her work focuses on financial guidance, official document preparation (ITIN, Taxes, Work Permits), and authorized notary public services."
      },
      {
        q: "Where is Marilyn Paladinez's office located?",
        a: "Her main office is located at 20 Bloomfield Pl, Newark, NJ 07104. Scheduled appointments are recommended."
      },
      {
        q: "How can I book a consultation?",
        a: "Call or message directly at (862) 622-8339 or use the booking buttons on this website."
      }
    ]
  }
};

const currentContent = lang === 'es' ? content.es : content.en;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${WEBSITE}/#website`,
      "url": WEBSITE,
      "name": "MAPA Business & Financial Services LLC",
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": currentContent.meta_title,
      "isPartOf": { "@id": `${WEBSITE}/#website` },
      "about": { "@id": `${WEBSITE}/#person` },
      "inLanguage": lang === 'es' ? "es" : "en"
    },
    {
      "@type": "Person",
      "@id": `${WEBSITE}/#person`,
      "name": "Marilyn Paladinez",
      "jobTitle": lang === 'es' ? "Estratega Financiera para Migrantes" : "Financial Strategist for Immigrants",
      "worksFor": {
        "@type": "Organization",
        "name": "MAPA Business & Financial Services LLC",
        "url": WEBSITE
      },
      "url": canonical,
      "image": `${WEBSITE}/marilin2.webp`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "20 Bloomfield Pl",
        "addressLocality": "Newark",
        "addressRegion": "NJ",
        "postalCode": "07104",
        "addressCountry": "US"
      },
      "sameAs": [
        "https://www.facebook.com/profile.php?id=61550670802804",
        "https://www.instagram.com/marilynpaladinezusa/",
        "https://www.tiktok.com/@marilynpaladinezv",
        "https://www.youtube.com/@MarilynPaladinezOficial"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "mainEntity": currentContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  lang={lang}
  title={currentContent.meta_title}
  description={currentContent.meta_desc}
  canonical={canonical}
  schema={schema}
  activeSection="biography"
  currentPath={currentPath}
>
  <!-- BREADCRUMB -->
  <div class="bio-breadcrumb">
    <a href={lang === 'es' ? '/' : '/en/'}>{lang === 'es' ? 'Inicio' : 'Home'}</a>
    <span>›</span>
    <span class="current">Marilyn Paladinez</span>
  </div>

  <main class="bio-main">
    <!-- HERO EXECUTIVE BANNER -->
    <section class="bio-hero-card">
      <div class="bio-portrait-wrapper">
        <div class="bio-portrait-glow"></div>
        <img src="/marilin2.webp" alt="Marilyn Paladinez" class="bio-portrait-img" />
        <div class="bio-portrait-badge">
          <span class="badge-num">10+</span>
          <span class="badge-txt">{lang === 'es' ? 'Años en NJ' : 'Years in NJ'}</span>
        </div>
      </div>

      <div class="bio-hero-info">
        <span class="bio-pill-tag">
          {lang === 'es' ? 'Fundadora & Estratega Financiera' : 'Founder & Financial Strategist'}
        </span>
        <h1 class="bio-hero-h1">{currentContent.h1}</h1>
        <p class="bio-hero-lead">{currentContent.intro_p1}</p>
        <p class="bio-hero-sub">{currentContent.intro_p2}</p>
        <div class="bio-hero-actions">
          <a href="#contacto" class="btn btn-red">📅 {currentContent.btn_schedule}</a>
          <a href="https://wa.me/18626228339" target="_blank" class="btn btn-whatsapp">💬 {currentContent.btn_whatsapp}</a>
        </div>
      </div>
    </section>

    <!-- STATS ROW -->
    <section class="bio-stats-row">
      <div class="bio-stat-card">
        <span class="stat-num">10+</span>
        <span class="stat-lbl">{lang === 'es' ? 'Años de Experiencia' : 'Years Experience'}</span>
      </div>
      <div class="bio-stat-card">
        <span class="stat-num">500+</span>
        <span class="stat-lbl">{lang === 'es' ? 'Familias Atendidas' : 'Families Served'}</span>
      </div>
      <div class="bio-stat-card">
        <span class="stat-num">100%</span>
        <span class="stat-lbl">{lang === 'es' ? 'Atención en Español' : 'Spanish Support'}</span>
      </div>
      <div class="bio-stat-card">
        <span class="stat-num">IRS CAA</span>
        <span class="stat-lbl">{lang === 'es' ? 'Agente Autorizado' : 'Certified Agent'}</span>
      </div>
    </section>

    <!-- CORE CONTENT GRID -->
    <div class="bio-grid">
      <!-- LEFT COLUMN -->
      <div class="bio-col-main">
        <h2 class="bio-section-title">{currentContent.about_title}</h2>
        <p class="bio-p">{currentContent.about_p1}</p>
        <p class="bio-p">{currentContent.about_p2}</p>

        <!-- QUOTE BOX -->
        <blockquote class="bio-quote-box">
          <div class="quote-mark">“</div>
          <p class="quote-text">{currentContent.quote}</p>
          <cite class="quote-author">— Marilyn Paladinez</cite>
        </blockquote>

        <!-- MISSION -->
        <div class="bio-mission-card">
          <h3 class="mission-title">{currentContent.mission_title}</h3>
          <p class="mission-desc">{currentContent.mission_desc}</p>
        </div>

        <!-- CREDENTIALS -->
        <h2 class="bio-section-title" style="margin-top: 40px;">{currentContent.credentials_title}</h2>
        <div class="bio-credentials-list">
          <div class="cred-card">
            <div class="cred-icon-wrap">⚖️</div>
            <div class="cred-body">
              <h4 class="cred-title">{currentContent.cred_notary}</h4>
              <p class="cred-desc">{currentContent.cred_notary_desc}</p>
            </div>
          </div>
          <div class="cred-card">
            <div class="cred-icon-wrap">🔢</div>
            <div class="cred-body">
              <h4 class="cred-title">{currentContent.cred_caa}</h4>
              <p class="cred-desc">{currentContent.cred_caa_desc}</p>
            </div>
          </div>
          <div class="cred-card">
            <div class="cred-icon-wrap">📋</div>
            <div class="cred-body">
              <h4 class="cred-title">{currentContent.cred_doc}</h4>
              <p class="cred-desc">{currentContent.cred_doc_desc}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT SIDEBAR -->
      <aside class="bio-col-sidebar">
        <!-- SERVICES LIST CARD -->
        <div class="bio-sidebar-card">
          <h3 class="sidebar-title">{currentContent.services_title}</h3>
          <p class="sidebar-desc">{currentContent.services_desc}</p>
          <ul class="sidebar-services-nav">
            {services.map(service => (
              <li>
                <a href={`${serviceLinkPrefix}${service.slug}/`} class="service-nav-item">
                  <span class="service-nav-icon">{service.icon}</span>
                  <span class="service-nav-text">{service.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- CONTACT MINI BOX -->
        <div class="bio-sidebar-card office-card">
          <h4 class="office-title">📍 {lang === 'es' ? 'Oficina Principal' : 'Main Office'}</h4>
          <p class="office-address">20 Bloomfield Pl, Newark, NJ 07104</p>
          <p class="office-phone">📞 <a href="tel:+18626228339" class="phone-link">(862) 622-8339</a></p>
          <a href="#contacto" class="btn btn-red btn-block" style="margin-top: 15px;">{lang === 'es' ? 'Agendar Cita Presencial' : 'Book In-Person Appointment'}</a>
        </div>
      </aside>
    </div>

    <!-- FAQS SECTION -->
    <section class="bio-faqs-section">
      <h2 class="bio-faqs-heading">{currentContent.faq_title}</h2>
      <div class="bio-faqs-grid">
        {currentContent.faqs.map(faq => (
          <div class="bio-faq-item">
            <dt class="faq-q">{faq.q}</dt>
            <dd class="faq-a">{faq.a}</dd>
          </div>
        ))}
      </div>
    </section>

    <!-- FINAL CTA BANNER -->
    <section class="bio-cta-banner">
      <h2 class="cta-banner-h2">{currentContent.contact_title}</h2>
      <p class="cta-banner-p">{currentContent.contact_desc}</p>
      <div class="cta-banner-buttons">
        <a href="#contacto" class="btn btn-white-cta">📅 {currentContent.btn_schedule}</a>
        <a href="https://wa.me/18626228339" target="_blank" class="btn btn-whatsapp">💬 {currentContent.btn_whatsapp}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* ═════════════════════════════════════════════════════════════════
     BIOGRAPHY & ABOUT LANDING PAGE — ULTRAPREMIUM EXECUTIVE SYSTEM
     ═════════════════════════════════════════════════════════════════ */
  
  .bio-breadcrumb {
    max-width: 1140px;
    margin: 95px auto 0;
    padding: 16px 24px 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.84rem;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .bio-breadcrumb a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .bio-breadcrumb a:hover {
    color: #ff3333;
  }

  .bio-breadcrumb span {
    color: rgba(255, 255, 255, 0.35);
  }

  .bio-breadcrumb .current {
    color: #ffffff;
    font-weight: 700;
  }

  .bio-main {
    max-width: 1140px;
    margin: 0 auto;
    padding: 30px 24px 80px;
  }

  /* ── Hero Executive Card ── */
  .bio-hero-card {
    background: linear-gradient(135deg, rgba(20, 20, 20, 0.95) 0%, rgba(30, 10, 10, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 45px;
    display: flex;
    gap: 45px;
    align-items: center;
    margin-bottom: 35px;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.35);
    position: relative;
    overflow: hidden;
  }

  .bio-hero-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(204, 0, 0, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .bio-portrait-wrapper {
    position: relative;
    flex-shrink: 0;
    width: 250px;
    height: 250px;
  }

  .bio-portrait-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #cc0000 0%, #ff3333 100%);
    filter: blur(12px);
    opacity: 0.6;
  }

  .bio-portrait-img {
    position: relative;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #cc0000;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .bio-portrait-badge {
    position: absolute;
    bottom: -10px;
    right: 15px;
    background: #cc0000;
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 6px 20px rgba(204, 0, 0, 0.6);
    z-index: 3;
    border: 2px solid #ffffff;
  }

  .badge-num {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: 1.05rem;
  }

  .badge-txt {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .bio-hero-info {
    flex-grow: 1;
    z-index: 2;
  }

  .bio-pill-tag {
    display: inline-block;
    background: rgba(204, 0, 0, 0.15);
    border: 1px solid rgba(204, 0, 0, 0.4);
    color: #ff4d4d;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  .bio-hero-h1 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    line-height: 1.25;
    margin-bottom: 18px;
    color: #ffffff;
  }

  .bio-hero-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 14px;
    font-weight: 600;
  }

  .bio-hero-sub {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 24px;
  }

  .bio-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* ── Stats Row ── */
  .bio-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 45px;
  }

  .bio-stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 22px 18px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .bio-stat-card:hover {
    border-color: rgba(204, 0, 0, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .stat-num {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: 1.8rem;
    color: #cc0000;
    margin-bottom: 4px;
  }

  .stat-lbl {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
  }

  /* ── Split Grid Layout ── */
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 40px;
    margin-bottom: 50px;
  }

  .bio-section-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 1.55rem;
    color: #ffffff;
    margin-bottom: 20px;
    position: relative;
    padding-left: 16px;
    border-left: 4px solid #cc0000;
  }

  .bio-p {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 20px;
  }

  /* Quote Box */
  .bio-quote-box {
    background: rgba(204, 0, 0, 0.06);
    border-left: 4px solid #cc0000;
    border-radius: 0 14px 14px 0;
    padding: 26px 30px;
    margin: 30px 0;
    position: relative;
  }

  .quote-mark {
    font-family: 'Georgia', serif;
    font-size: 3rem;
    color: rgba(204, 0, 0, 0.3);
    line-height: 1;
    position: absolute;
    top: 10px;
    left: 16px;
  }

  .quote-text {
    font-size: 1.05rem;
    font-style: italic;
    color: #ffffff;
    line-height: 1.7;
    margin-bottom: 10px;
    position: relative;
    z-index: 2;
  }

  .quote-author {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 0.88rem;
    color: #ff4d4d;
    font-style: normal;
  }

  /* Mission Card */
  .bio-mission-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 26px;
    margin-bottom: 35px;
