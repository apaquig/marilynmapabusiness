---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const es = lang === 'es';
const path = es ? '/es/contacto/' : '/en/contact/';
const title = es ? 'Contacta con MAPA' : 'Contact MAPA';
const description = es ? 'Selecciona tus servicios y envía tu consulta al equipo de MAPA.' : 'Select your services and send your inquiry to the MAPA team.';
---
<BaseLayout collectsContactInformation lang={lang} title={`${title} | MAPA Business & Financial Services LLC`} description={description} canonical={`https://marilynmapabusiness.com${path}`} currentPath={path}>
  <div class="breadcrumb"><a href={es ? '/' : '/en/'}>{es ? 'Inicio' : 'Home'}</a><span>›</span><span>{es ? 'Contacto' : 'Contact'}</span></div>
  <article class="contact-page">
    <h1>{title}</h1>
    <p>{description}</p>
    <ContactForm lang={lang} />
  </article>
</BaseLayout>
<style>
  .contact-page { max-width:760px; margin:0 auto; padding:32px 20px 64px; }
  h1 { font-size:clamp(28px,4vw,40px); margin:0 0 12px; }
  .contact-page > p { margin:0 0 24px; color:#475569; line-height:1.6; }
</style>
